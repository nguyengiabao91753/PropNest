@model PropNest.Web.Admin.Models.InputModels.AdminLoginInputModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập Quản trị viên";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập Admin - PropNest</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap&subset=vietnamese" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#fff8e3',
                        surface: '#fdf9eb',
                        card: '#ffffff',
                        primary: {
                            DEFAULT: '#d7730c',
                            foreground: '#ffffff',
                            hover: '#b85e07'
                        },
                        'brand-soft': '#fbe6cc',
                        destructive: '#d23b2f',
                        border: '#e8e3d5',
                        muted: {
                            DEFAULT: '#f6eed3',
                            foreground: '#6b6354'
                        }
                    },
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', 'system-ui', 'sans-serif'],
                        display: ['"Playfair Display"', 'Georgia', 'serif']
                    }
                }
            }
        }
    </script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="min-h-screen bg-background font-sans antialiased text-neutral-900 flex items-center justify-center p-4 selection:bg-brand-soft">
    <div class="w-full max-w-md">
        <!-- Logo & Brand Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center size-14 rounded-2xl bg-primary text-white font-bold text-2xl font-display shadow-lg shadow-primary/20 mb-3">
                PN
            </div>
            <h1 class="text-2xl font-bold font-display text-neutral-900 tracking-tight">PropNest Admin Portal</h1>
            <p class="text-xs text-muted-foreground mt-1">Cổng đăng nhập dành riêng cho Ban Quản trị & Ban Kiểm duyệt</p>
        </div>

        <!-- Login Card -->
        <div class="bg-card border border-border rounded-2xl shadow-xl p-8 space-y-6">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium flex items-center gap-2">
                    <i data-lucide="check-circle" class="size-4 shrink-0 text-emerald-600"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs space-y-1">
                    <div class="font-semibold flex items-center gap-1.5">
                        <i data-lucide="alert-circle" class="size-4 shrink-0 text-rose-600"></i>
                        <span>Lỗi đăng nhập:</span>
                    </div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="pl-5">• @error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Email -->
                <div>
                    <label asp-for="Email" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                        Email quản trị viên
                    </label>
                    <div class="relative">
                        <i data-lucide="mail" class="absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-neutral-400"></i>
                        <input asp-for="Email" type="email" required placeholder="admin@propnest.vn"
                               class="w-full rounded-xl border border-border bg-surface pl-10 pr-4 py-2.5 text-xs text-neutral-900 focus:border-primary focus:bg-white focus:outline-none transition-colors" />
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label asp-for="Password" class="block text-xs font-semibold text-neutral-800">
                            Mật khẩu
                        </label>
                    </div>
                    <div class="relative">
                        <i data-lucide="lock" class="absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-neutral-400"></i>
                        <input asp-for="Password" type="password" required placeholder="••••••••"
                               class="w-full rounded-xl border border-border bg-surface pl-10 pr-4 py-2.5 text-xs text-neutral-900 focus:border-primary focus:bg-white focus:outline-none transition-colors" />
                    </div>
                </div>

                <!-- Remember Me -->
                <div class="flex items-center justify-between pt-1">
                    <label class="flex items-center gap-2 cursor-pointer text-xs text-neutral-700">
                        <input asp-for="RememberMe" type="checkbox"
                               class="rounded border-border text-primary focus:ring-primary size-4" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <span class="text-[11px] text-muted-foreground">Bảo mật JWT SSL</span>
                </div>

                <!-- Submit Button -->
                <button type="submit"
                        class="w-full rounded-xl bg-primary hover:bg-primary-hover active:scale-[0.99] text-white font-semibold text-xs py-3 shadow-md shadow-primary/20 transition-all flex items-center justify-center gap-2">
                    <i data-lucide="log-in" class="size-4"></i>
                    <span>Đăng nhập hệ thống</span>
                </button>
            </form>

            <!-- Seed Account Test Helper Box -->
            <div class="pt-4 border-t border-dashed border-border/80">
                <p class="text-[11px] font-semibold text-neutral-700 mb-2 flex items-center gap-1.5">
                    <i data-lucide="key-round" class="size-3.5 text-primary"></i>
                    <span>Tài khoản Seed mặc định (Sẵn sàng kiểm thử):</span>
                </p>
                <div class="bg-surface rounded-xl p-3 border border-border/60 text-xs space-y-1 font-mono">
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground font-sans">Email:</span>
                        <button type="button" onclick="fillCredentials('admin@propnest.vn', 'Admin@123456')"
                                class="text-primary hover:underline font-semibold cursor-pointer">
                            admin@propnest.vn
                        </button>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground font-sans">Mật khẩu:</span>
                        <span class="font-semibold text-neutral-900">Admin@123456</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground font-sans">Vai trò:</span>
                        <span class="text-emerald-700 font-sans font-semibold">Admin + Moderator</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <p class="text-center text-[11px] text-muted-foreground mt-6">
            © 2026 PropNest Corporation. Mọi quyền được bảo lưu.
        </p>
    </div>

    <script>
        lucide.createIcons();
        function fillCredentials(email, pwd) {
            document.getElementById("Email").value = email;
            document.getElementById("Password").value = pwd;
        }
    </script>
</body>
</html>
