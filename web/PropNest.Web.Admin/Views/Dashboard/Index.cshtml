@model PropNest.Web.Admin.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="mx-auto max-w-[1440px] space-y-8">
    <!-- Dashboard Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border/80 pb-5">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                <i data-lucide="layout-dashboard" class="size-4 text-primary"></i>
                <span>Cổng Quản Trị Hệ Thống PropNest</span>
            </div>
            <h1 class="font-display text-3xl font-bold mt-1 text-neutral-900">Bảng Điều Khiển Tổng Quan</h1>
            <p class="text-xs text-muted-foreground mt-1">
                Giám sát vòng đời tin đăng (F02), lưu lượng kiểm duyệt (F03), doanh thu Saga (F05-F06) và chỉ số AME AI (F09).
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-controller="Moderation" asp-action="Index"
               class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-white hover:bg-primary-hover shadow-xs transition-colors">
                <i data-lucide="check-square" class="size-4"></i> Hàng đợi duyệt (@Model.PendingCount)
            </a>
            <a asp-action="Index"
               class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-3.5 py-2.5 text-xs font-medium text-neutral-800 hover:bg-surface transition-colors shadow-2xs">
                <i data-lucide="refresh-cw" class="size-3.5 text-muted-foreground"></i> Làm mới
            </a>
        </div>
    </div>

    <!-- 4 KPI Cards Grid -->
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <!-- Card 1: Total Properties -->
        <div class="rounded-2xl border border-border bg-card p-5 shadow-xs transition-all hover:border-primary/40">
            <div class="flex items-center justify-between text-muted-foreground">
                <span class="font-semibold text-xs text-neutral-700">Tổng tin đăng toàn sàn</span>
                <div class="grid size-9 place-items-center rounded-xl bg-primary/10 text-primary">
                    <i data-lucide="building-2" class="size-4"></i>
                </div>
            </div>
            <p class="mt-3 font-display text-3xl font-bold text-neutral-900">@Model.TotalProperties</p>
            <div class="mt-2 flex items-center justify-between text-xs text-muted-foreground border-t border-border/60 pt-2">
                <span>Đang hiển thị công khai:</span>
                <strong class="text-emerald-700">@Model.PublishedCount tin</strong>
            </div>
        </div>

        <!-- Card 2: Pending Moderation -->
        <div class="rounded-2xl border border-border bg-card p-5 shadow-xs transition-all hover:border-amber-400">
            <div class="flex items-center justify-between text-muted-foreground">
                <span class="font-semibold text-xs text-neutral-700">Chờ duyệt (Pending F03)</span>
                <div class="grid size-9 place-items-center rounded-xl bg-amber-500/15 text-amber-600">
                    <i data-lucide="clock" class="size-4"></i>
                </div>
            </div>
            <p class="mt-3 font-display text-3xl font-bold text-neutral-900">@Model.PendingCount</p>
            <div class="mt-2 flex items-center justify-between text-xs text-muted-foreground border-t border-border/60 pt-2">
                <span>Trạng thái xử lý:</span>
                @if (Model.PendingCount > 0)
                {
                    <span class="font-semibold text-amber-700 flex items-center gap-1">
                        <span class="size-2 rounded-full bg-amber-500 animate-pulse"></span> Cần duyệt ngay
                    </span>
                }
                else
                {
                    <span class="font-semibold text-emerald-600">Đã thông suốt</span>
                }
            </div>
        </div>

        <!-- Card 3: Service Revenue -->
        <div class="rounded-2xl border border-border bg-card p-5 shadow-xs transition-all hover:border-emerald-400">
            <div class="flex items-center justify-between text-muted-foreground">
                <span class="font-semibold text-xs text-neutral-700">Doanh thu gói tin (F05)</span>
                <div class="grid size-9 place-items-center rounded-xl bg-emerald-500/15 text-emerald-600">
                    <i data-lucide="wallet" class="size-4"></i>
                </div>
            </div>
            <p class="mt-3 font-display text-3xl font-bold text-neutral-900">@FormatHelper.FormatVnd(Model.TotalRevenue)</p>
            <div class="mt-2 flex items-center justify-between text-xs text-muted-foreground border-t border-border/60 pt-2">
                <span>Gói VIP & Boost tự động:</span>
                <span class="text-neutral-800 font-medium">Saga Orchestrated</span>
            </div>
        </div>

        <!-- Card 4: Active Sellers & AME -->
        <div class="rounded-2xl border border-border bg-card p-5 shadow-xs transition-all hover:border-blue-400">
            <div class="flex items-center justify-between text-muted-foreground">
                <span class="font-semibold text-xs text-neutral-700">Môi giới & Auto AME</span>
                <div class="grid size-9 place-items-center rounded-xl bg-blue-500/15 text-blue-600">
                    <i data-lucide="shield-check" class="size-4"></i>
                </div>
            </div>
            <p class="mt-3 font-display text-3xl font-bold text-neutral-900">@Model.ActiveSellersCount <span class="text-base font-normal text-muted-foreground">người bán</span></p>
            <div class="mt-2 flex items-center justify-between text-xs text-muted-foreground border-t border-border/60 pt-2">
                <span>Tỷ lệ Saga thành công:</span>
                <strong class="text-emerald-700 font-mono">@Model.SagaSuccessRate%</strong>
            </div>
        </div>
    </div>

    <!-- Charts Section: Revenue Trend & Lifecycle Distribution -->
    <div class="grid gap-6 lg:grid-cols-[1.8fr_1fr]">
        <!-- Chart 1: Revenue & Volume Combo Chart -->
        <div class="rounded-2xl border border-border bg-card p-6 shadow-xs flex flex-col justify-between">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border/80 pb-4">
                <div>
                    <h2 class="text-base font-semibold text-neutral-900">Xu hướng Doanh thu & Lưu lượng Tin đăng</h2>
                    <p class="text-xs text-muted-foreground mt-0.5">
                        Thống kê 6 tháng gần nhất - Gói Standard, VIP (500k) và Boost (200k) phối hợp Saga Orchestrator F06
                    </p>
                </div>
                <div class="flex items-center gap-3 text-xs">
                    <div class="flex items-center gap-1.5 text-neutral-700">
                        <span class="size-3 rounded bg-[#d7730c]"></span>
                        <span>Doanh thu (triệu ₫)</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-neutral-700">
                        <span class="size-3 rounded-full bg-[#059669]"></span>
                        <span>Số tin đăng</span>
                    </div>
                </div>
            </div>

            <!-- Canvas Container -->
            <div class="pt-4 relative min-h-[300px] w-full">
                <canvas id="revenueVolumeChart" class="w-full"></canvas>
            </div>
        </div>

        <!-- Chart 2: 8 Lifecycle States Doughnut Chart -->
        <div class="rounded-2xl border border-border bg-card p-6 shadow-xs flex flex-col justify-between">
            <div class="border-b border-border/80 pb-4">
                <h2 class="text-base font-semibold text-neutral-900">Vòng đời Tin đăng (Blueprint F02)</h2>
                <p class="text-xs text-muted-foreground mt-0.5">
                    Phân bổ 8 trạng thái hệ thống: Published, Pending, Draft, Rejected...
                </p>
            </div>

            <!-- Doughnut Canvas -->
            <div class="py-3 relative flex items-center justify-center min-h-[220px]">
                <canvas id="statusDoughnutChart" class="max-h-[220px]"></canvas>
            </div>

            <!-- Status Breakdown Legend List -->
            <div class="grid grid-cols-2 gap-2 border-t border-border/60 pt-3 text-xs">
                <div class="flex items-center justify-between p-1.5 rounded-lg bg-surface">
                    <span class="flex items-center gap-1.5 text-emerald-800 font-medium">
                        <span class="size-2 rounded-full bg-emerald-500"></span> Published
                    </span>
                    <strong class="text-neutral-900">@Model.StatusDistribution.GetValueOrDefault("Published", 0)</strong>
                </div>
                <div class="flex items-center justify-between p-1.5 rounded-lg bg-surface">
                    <span class="flex items-center gap-1.5 text-amber-800 font-medium">
                        <span class="size-2 rounded-full bg-amber-500"></span> Pending
                    </span>
                    <strong class="text-neutral-900">@Model.StatusDistribution.GetValueOrDefault("PendingModeration", 0)</strong>
                </div>
                <div class="flex items-center justify-between p-1.5 rounded-lg bg-surface">
                    <span class="flex items-center gap-1.5 text-neutral-700 font-medium">
                        <span class="size-2 rounded-full bg-neutral-400"></span> Draft
                    </span>
                    <strong class="text-neutral-900">@Model.StatusDistribution.GetValueOrDefault("Draft", 0)</strong>
                </div>
                <div class="flex items-center justify-between p-1.5 rounded-lg bg-surface">
                    <span class="flex items-center gap-1.5 text-rose-800 font-medium">
                        <span class="size-2 rounded-full bg-rose-500"></span> Rejected
                    </span>
                    <strong class="text-neutral-900">@Model.StatusDistribution.GetValueOrDefault("Rejected", 0)</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Operational Grid: Moderation Queue & System Engine Monitor -->
    <div class="grid gap-6 xl:grid-cols-[1.6fr_1fr]">
        <!-- Pending Moderation Queue (F03 Urgent Actions) -->
        <section class="rounded-2xl border border-border bg-card overflow-hidden shadow-xs">
            <div class="flex items-center justify-between border-b border-border p-5 bg-surface/50">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="size-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                        <h2 class="font-semibold text-base text-neutral-900">Hàng Đợi Kiểm Duyệt Cần Xử Lý (F03)</h2>
                    </div>
                    <p class="text-xs text-muted-foreground mt-0.5">Các tin đăng đang chờ xét duyệt tính hợp lệ trước khi công khai</p>
                </div>
                <a asp-controller="Moderation" asp-action="Index" class="inline-flex items-center gap-1 text-xs text-primary font-semibold hover:underline">
                    Mở toàn bộ hàng đợi <i data-lucide="arrow-right" class="size-3.5"></i>
                </a>
            </div>

            <div class="divide-y divide-border">
                @if (Model.PendingQueue.Count == 0)
                {
                    <div class="p-8 text-center text-xs text-muted-foreground">
                        <i data-lucide="check-circle" class="size-8 mx-auto mb-2 text-emerald-500"></i>
                        <p class="font-semibold text-neutral-900">Hàng đợi kiểm duyệt hiện đang trống</p>
                        <p class="text-[11px] mt-0.5">Tất cả tin đăng đều đã được xử lý xong.</p>
                    </div>
                }
                else
                {
                    @foreach (var p in Model.PendingQueue)
                    {
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 text-sm hover:bg-surface/50 transition-colors">
                            <div class="min-w-0 space-y-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="font-mono text-xs font-bold text-primary">@p.Id</span>
                                    <partial name="_StatusBadge" model="p.Status" />
                                    @if (p.PackageCode == "VIP")
                                    {
                                        <span class="rounded bg-amber-500/20 text-amber-800 border border-amber-500/30 px-1.5 py-0.2 text-[10px] font-bold">
                                            VIP Ưu Tiên
                                        </span>
                                    }
                                    <span class="text-[11px] text-muted-foreground">@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <h3 class="font-medium text-neutral-900 truncate">@p.Title</h3>
                                <p class="text-xs text-muted-foreground">
                                    📍 @p.FormattedLocation · Người bán: <strong>@p.SellerName</strong>
                                </p>
                            </div>
                            <div class="flex items-center gap-3 shrink-0 self-end sm:self-center">
                                <div class="text-right">
                                    <span class="font-semibold text-neutral-900 block font-display text-sm">
                                        @FormatHelper.FormatCompactPrice(p.Price, p.ListingType)
                                    </span>
                                    <span class="text-[11px] text-muted-foreground">@FormatHelper.FormatArea(p.Area)</span>
                                </div>
                                <a asp-controller="Moderation" asp-action="Index" asp-route-selectedId="@p.Id"
                                   class="inline-flex items-center gap-1 rounded-xl bg-primary px-3 py-1.5 text-xs font-semibold text-white hover:bg-primary-hover transition-colors shadow-2xs">
                                    <span>Xét duyệt</span>
                                    <i data-lucide="chevron-right" class="size-3.5"></i>
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>

        <!-- Right Side: AME AI Engine & Blueprint Saga Architecture Monitor -->
        <section class="space-y-6">
            <!-- AME Engine Card (Blueprint F09) -->
            <div class="rounded-2xl border border-border bg-card p-5 shadow-xs space-y-4">
                <div class="flex items-center justify-between border-b border-border/80 pb-3">
                    <div class="flex items-center gap-2">
                        <div class="grid size-8 place-items-center rounded-lg bg-blue-500/15 text-blue-600">
                            <i data-lucide="bot" class="size-4"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-sm text-neutral-900">Auto-Moderation Engine (AME F09)</h3>
                            <p class="text-[11px] text-muted-foreground">FastAPI + Ollama AI Content Verification</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span> Online
                    </span>
                </div>

                <div class="grid grid-cols-2 gap-3 text-xs">
                    <div class="rounded-xl border border-border bg-surface p-3 text-center">
                        <span class="text-[11px] text-muted-foreground block mb-0.5">Tự động duyệt (AME)</span>
                        <strong class="text-xl font-bold font-display text-emerald-700">@Model.AmeAutoApprovedCount</strong>
                        <span class="text-[10px] text-muted-foreground block mt-0.5">Đạt chuẩn giá & nội dung</span>
                    </div>
                    <div class="rounded-xl border border-border bg-surface p-3 text-center">
                        <span class="text-[11px] text-muted-foreground block mb-0.5">Cảnh báo nghi vấn</span>
                        <strong class="text-xl font-bold font-display text-amber-700">@Model.AmeFlaggedCount</strong>
                        <span class="text-[10px] text-muted-foreground block mt-0.5">Chuyển kiểm duyệt tay</span>
                    </div>
                </div>

                <div class="text-[11px] text-muted-foreground bg-surface rounded-xl p-3 border border-border/60 space-y-1">
                    <p>✓ <strong>MarketPriceBenchmarks:</strong> Tự động đối soát khoảng giá thị trường theo Quận/Huyện.</p>
                    <p>✓ <strong>ContentRules:</strong> Quét từ cấm, ký tự spam và số điện thoại ẩn trong mô tả.</p>
                </div>
            </div>

            <!-- Saga Orchestrator Card (Blueprint F06) -->
            <div class="rounded-2xl border border-border bg-card p-5 shadow-xs space-y-3">
                <div class="flex items-center justify-between border-b border-border/80 pb-3">
                    <div class="flex items-center gap-2">
                        <div class="grid size-8 place-items-center rounded-lg bg-amber-500/15 text-amber-600">
                            <i data-lucide="git-merge" class="size-4"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-sm text-neutral-900">Saga MassTransit (F06)</h3>
                            <p class="text-[11px] text-muted-foreground">Orchestrator & Compensation Ledger</p>
                        </div>
                    </div>
                    <span class="rounded bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 text-[10px] font-bold">
                        Transactional Outbox
                    </span>
                </div>

                <ul class="text-xs text-neutral-700 space-y-2 pt-1">
                    <li class="flex items-center justify-between">
                        <span class="text-muted-foreground">Chu trình Saga:</span>
                        <span class="font-mono text-[11px] font-semibold text-neutral-800">Deduct → Upgrade → Audit</span>
                    </li>
                    <li class="flex items-center justify-between">
                        <span class="text-muted-foreground">Tỷ lệ bồi hoàn (Compensation):</span>
                        <span class="text-emerald-700 font-semibold font-mono">100% Hoàn tiền khi lỗi</span>
                    </li>
                    <li class="flex items-center justify-between">
                        <span class="text-muted-foreground">Khóa chống lặp (Idempotency):</span>
                        <span class="text-blue-700 font-semibold font-mono">Idempotency-Key Active</span>
                    </li>
                </ul>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Data from Razor ViewModel for Revenue & Listing Count Chart
            const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyMetrics.Select(m => m.Month)));
            const monthlyRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyMetrics.Select(m => m.Revenue / 1_000_000m))); // in millions
            const monthlyListings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyMetrics.Select(m => m.ListingCount)));

            // Initialize Combo Bar & Line Chart
            const ctxRev = document.getElementById('revenueVolumeChart');
            if (ctxRev && window.Chart) {
                new Chart(ctxRev, {
                    type: 'bar',
                    data: {
                        labels: monthlyLabels,
                        datasets: [
                            {
                                type: 'line',
                                label: 'Lượng tin đăng',
                                data: monthlyListings,
                                borderColor: '#059669',
                                backgroundColor: '#059669',
                                borderWidth: 2.5,
                                pointRadius: 4,
                                pointBackgroundColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointBorderColor: '#059669',
                                yAxisID: 'yListings',
                                tension: 0.3
                            },
                            {
                                type: 'bar',
                                label: 'Doanh thu (Triệu ₫)',
                                data: monthlyRevenue,
                                backgroundColor: 'rgba(215, 115, 12, 0.85)',
                                hoverBackgroundColor: '#b85e07',
                                borderRadius: 8,
                                borderSkipped: false,
                                yAxisID: 'yRevenue',
                                maxBarThickness: 38
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#1c1917',
                                titleFont: { family: "'Be Vietnam Pro', sans-serif", size: 12, weight: 'bold' },
                                bodyFont: { family: "'Be Vietnam Pro', sans-serif", size: 12 },
                                padding: 10,
                                cornerRadius: 8,
                                callbacks: {
                                    label: function(context) {
                                        if (context.dataset.type === 'bar') {
                                            return ` Doanh thu: ${context.raw} triệu ₫`;
                                        }
                                        return ` Lượng tin: ${context.raw} tin`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: {
                                    font: { family: "'Be Vietnam Pro', sans-serif", size: 11 },
                                    color: '#78716c'
                                }
                            },
                            yRevenue: {
                                type: 'linear',
                                position: 'left',
                                grid: { color: 'rgba(232, 227, 213, 0.6)' },
                                ticks: {
                                    font: { family: "'Be Vietnam Pro', sans-serif", size: 11 },
                                    color: '#78716c',
                                    callback: function(val) { return val + ' tr'; }
                                }
                            },
                            yListings: {
                                type: 'linear',
                                position: 'right',
                                grid: { drawOnChartArea: false },
                                ticks: {
                                    font: { family: "'Be Vietnam Pro', sans-serif", size: 11 },
                                    color: '#78716c',
                                    stepSize: 20
                                }
                            }
                        }
                    }
                });
            }

            // 2. Data for 8 Listing States Doughnut Chart
            const ctxDoughnut = document.getElementById('statusDoughnutChart');
            if (ctxDoughnut && window.Chart) {
                const pub = @Model.StatusDistribution.GetValueOrDefault("Published", 0);
                const pend = @Model.StatusDistribution.GetValueOrDefault("PendingModeration", 0);
                const draft = @Model.StatusDistribution.GetValueOrDefault("Draft", 0);
                const rej = @Model.StatusDistribution.GetValueOrDefault("Rejected", 0);
                const exp = @Model.StatusDistribution.GetValueOrDefault("Expired", 0);
                const hid = @Model.StatusDistribution.GetValueOrDefault("Hidden", 0);

                new Chart(ctxDoughnut, {
                    type: 'doughnut',
                    data: {
                        labels: ['Published (Đang hiển thị)', 'Pending (Chờ duyệt)', 'Draft (Bản nháp)', 'Rejected (Từ chối)', 'Expired (Hết hạn)', 'Hidden (Tạm ẩn)'],
                        datasets: [{
                            data: [pub, pend, draft, rej, exp, hid],
                            backgroundColor: [
                                '#10b981', // Emerald - Published
                                '#f59e0b', // Amber - Pending
                                '#9ca3af', // Gray - Draft
                                '#ef4444', // Rose - Rejected
                                '#78716c', // Stone - Expired
                                '#64748b'  // Slate - Hidden
                            ],
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#1c1917',
                                titleFont: { family: "'Be Vietnam Pro', sans-serif", size: 12 },
                                bodyFont: { family: "'Be Vietnam Pro', sans-serif", size: 11 },
                                padding: 10,
                                cornerRadius: 8
                            }
                        },
                        cutout: '68%'
                    }
                });
            }
        });
    </script>
}
