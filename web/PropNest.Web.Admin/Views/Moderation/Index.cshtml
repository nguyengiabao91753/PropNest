@model PropNest.Web.Admin.Models.ViewModels.ModerationQueueViewModel

@{
    ViewData["Title"] = "Duyệt tin đăng (F03)";
    var selected = Model.SelectedProperty;
}

<div class="mx-auto max-w-[1400px] space-y-6">
    <div>
        <p class="text-xs uppercase tracking-wider font-semibold text-muted-foreground">Kiểm duyệt nội dung</p>
        <h1 class="font-display text-3xl font-bold mt-1 text-neutral-900">Hàng Đợi Duyệt Tin Đăng (F03)</h1>
        <p class="mt-1 text-xs text-muted-foreground">
            Thẩm định thông tin người bán đăng tải trước khi hiển thị công khai trên trang tìm kiếm.
        </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.1fr_1.3fr]">
        <!-- Left Column: Pending Queue List -->
        <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-xs">
            <div class="border-b border-border p-4 flex items-center justify-between bg-surface/50">
                <span class="font-semibold text-sm text-neutral-900">Danh sách tin cần duyệt</span>
                <span class="rounded-full bg-amber-500/20 text-amber-800 font-bold px-2.5 py-0.5 text-xs">
                    @Model.TotalPending tin
                </span>
            </div>

            @if (Model.PendingProperties.Count == 0)
            {
                <div class="p-12 text-center text-muted-foreground">
                    <i data-lucide="check-circle-2" class="size-10 text-emerald-500 mx-auto mb-2"></i>
                    <p class="font-semibold text-sm text-neutral-900">Hàng đợi kiểm duyệt trống</p>
                    <p class="text-xs mt-1">Tất cả các tin đăng mới đã được xử lý xong.</p>
                </div>
            }
            else
            {
                <div class="divide-y divide-border max-h-[700px] overflow-y-auto">
                    @foreach (var p in Model.PendingProperties)
                    {
                        var isSelected = selected?.Id == p.Id;
                        <a asp-action="Index" asp-route-id="@p.Id"
                           class="flex w-full items-center gap-4 p-4 text-left transition hover:bg-surface/60 @(isSelected ? "bg-brand-soft/50 border-l-4 border-l-primary" : "")">
                            <div class="relative size-16 rounded-xl overflow-hidden shrink-0 border border-border bg-neutral-100">
                                <img src="@p.PrimaryImage" alt="@p.Title" class="size-full object-cover" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="font-mono text-[11px] text-muted-foreground font-semibold">@p.Id</span>
                                    <partial name="_StatusBadge" model="p.Status" />
                                    @if (p.PackageCode == "VIP")
                                    {
                                        <span class="rounded bg-amber-500 text-white text-[9px] font-bold px-1.5 py-0.2">
                                            VIP
                                        </span>
                                    }
                                </div>
                                <p class="truncate font-semibold text-sm text-neutral-900">@p.Title</p>
                                <p class="text-xs text-muted-foreground truncate">
                                    @p.FormattedLocation · @p.SellerName
                                </p>
                                <p class="text-xs font-bold text-primary mt-1 font-display">
                                    @FormatHelper.FormatPrice(p.Price, p.ListingType)
                                </p>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>

        <!-- Right Column: Active Review Inspector -->
        @if (selected != null)
        {
            <section class="rounded-2xl border border-border bg-card p-6 shadow-xs space-y-6">
                <!-- Cover Image & Listing Type Badge -->
                <div class="relative aspect-[16/9] w-full rounded-xl overflow-hidden border border-border bg-neutral-100">
                    <img src="@selected.PrimaryImage" alt="@selected.Title" class="size-full object-cover" />
                    <span class="absolute left-3 top-3 bg-black/75 backdrop-blur-xs text-white text-xs px-3 py-1 rounded-full font-medium">
                        @(selected.ListingType == "sale" ? "Cần bán" : "Cho thuê") · @selected.PropertyType
                    </span>
                </div>

                <!-- Title, Address & Price -->
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <span class="font-mono text-xs text-muted-foreground font-semibold block">@selected.Id</span>
                        <h2 class="font-display text-2xl font-bold mt-1 text-neutral-900">@selected.Title</h2>
                        <p class="text-xs text-muted-foreground mt-1">
                            📍 @selected.FullAddress
                        </p>
                    </div>
                    <div class="text-right shrink-0">
                        <span class="text-2xl font-extrabold text-primary font-display block">
                            @FormatHelper.FormatPrice(selected.Price, selected.ListingType)
                        </span>
                        <span class="text-xs text-muted-foreground block mt-0.5">Người đăng: @selected.SellerName</span>
                    </div>
                </div>

                <!-- 4-Stat Specs Grid -->
                <div class="grid grid-cols-4 gap-3 rounded-xl bg-surface p-4 text-center text-xs border border-border/60">
                    <div>
                        <strong class="text-sm block text-neutral-900">@selected.Beds</strong>
                        <span class="text-muted-foreground">Phòng ngủ</span>
                    </div>
                    <div>
                        <strong class="text-sm block text-neutral-900">@selected.Baths</strong>
                        <span class="text-muted-foreground">Phòng tắm</span>
                    </div>
                    <div>
                        <strong class="text-sm block text-neutral-900">@FormatHelper.FormatArea(selected.Area)</strong>
                        <span class="text-muted-foreground">Diện tích</span>
                    </div>
                    <div>
                        <strong class="text-sm block text-amber-600 font-bold">@selected.PackageCode</strong>
                        <span class="text-muted-foreground">Gói hiển thị</span>
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <h4 class="text-xs font-semibold uppercase text-muted-foreground mb-1">Mô tả bất động sản</h4>
                    <p class="text-xs text-muted-foreground leading-relaxed bg-surface/50 p-3.5 rounded-xl border border-border/60">
                        @selected.Description
                    </p>
                </div>

                <!-- AME AI Recommendation Widget (F09) -->
                <div class="rounded-xl border border-primary/30 bg-brand-soft/50 p-4 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-primary flex items-center gap-1.5">
                            <i data-lucide="bot" class="size-4"></i> AME Auto-Moderation Engine (Tư vấn AI)
                        </span>
                        <span class="text-[10px] rounded bg-emerald-500/20 text-emerald-800 font-semibold px-2 py-0.5">
                            @selected.AmeRecommendation.RecommendationText (@selected.AmeRecommendation.ConfidenceScore% tin cậy)
                        </span>
                    </div>
                    <div class="grid sm:grid-cols-3 gap-2 text-xs text-muted-foreground pt-1">
                        <div>
                            <span class="block text-[11px]">Từ khóa nhạy cảm:</span>
                            <strong class="text-emerald-700 font-medium">@(selected.AmeRecommendation.BadwordsPassed ? "Hợp lệ (Không vi phạm)" : "Cần rà soát")</strong>
                        </div>
                        <div>
                            <span class="block text-[11px]">Benchmark giá:</span>
                            <strong class="text-emerald-700 font-medium">@selected.AmeRecommendation.PriceBenchmarkText</strong>
                        </div>
                        <div>
                            <span class="block text-[11px]">Chất lượng ảnh:</span>
                            <strong class="text-emerald-700 font-medium">@(selected.AmeRecommendation.ImageQualityPassed ? "Đạt tiêu chuẩn HD" : "Mờ / Thấp")</strong>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons: Approve / Reject -->
                <div class="flex items-center gap-3 pt-2">
                    <form asp-action="Approve" asp-route-id="@selected.Id" method="post" class="flex-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="flex items-center justify-center gap-2 w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs py-3 px-4 rounded-xl shadow-xs transition-colors">
                            <i data-lucide="check" class="size-4"></i> Phê duyệt tin đăng
                        </button>
                    </form>

                    <button type="button" onclick="openRejectModal('@selected.Id', '@selected.Title')"
                            class="flex items-center justify-center gap-2 flex-1 bg-destructive hover:bg-red-700 text-white font-semibold text-xs py-3 px-4 rounded-xl shadow-xs transition-colors">
                        <i data-lucide="x" class="size-4"></i> Từ chối duyệt (Lý do)
                    </button>
                </div>
            </section>
        }
        else
        {
            <div class="rounded-2xl border border-dashed border-border bg-card/60 p-12 text-center text-muted-foreground text-xs flex flex-col items-center justify-center min-h-[400px]">
                <i data-lucide="inbox" class="size-8 text-muted-foreground/60 mb-2"></i>
                <span>Chọn một tin đăng từ danh sách bên trái để xem chi tiết và thẩm định.</span>
            </div>
        }
    </div>
</div>

<!-- Reject Reason Modal (F03 Blueprint Mandatory Reason) -->
<div id="rejectModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4">
    <div class="w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-xl space-y-4">
        <div class="flex items-center gap-2 text-destructive">
            <i data-lucide="shield-alert" class="size-5"></i>
            <h3 class="font-bold text-base text-neutral-900">Từ chối duyệt tin: <span id="rejectTargetTitle" class="text-destructive font-mono text-sm"></span></h3>
        </div>

        <p class="text-xs text-muted-foreground leading-relaxed">
            Theo quy định Blueprint, từ chối tin đăng <strong>bắt buộc phải có lý do cụ thể</strong> để lưu vết vào Audit Log và gửi phản hồi cho người bán.
        </p>

        <form asp-action="Reject" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="rejectListingId" name="ListingId" value="" />

            <div>
                <label for="rejectReason" class="text-xs font-semibold text-neutral-900 mb-1.5 block">Lý do từ chối (Reason) *</label>
                <textarea id="rejectReason" name="Reason" rows="3" required
                          placeholder="Nhập lý do vi phạm (ví dụ: Hình ảnh không rõ ràng, sai lệch thông số diện tích thực tế so với quy hoạch...)"
                          class="w-full rounded-xl border border-border bg-surface p-3 text-xs outline-none focus:border-destructive transition-colors">Hình ảnh không rõ ràng và sai lệch thông số diện tích thực tế.</textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" onclick="closeRejectModal()"
                        class="rounded-xl border border-border px-4 py-2 text-xs font-medium text-muted-foreground hover:bg-surface transition-colors">
                    Hủy
                </button>
                <button type="submit"
                        class="rounded-xl bg-destructive px-4 py-2 text-xs font-semibold text-white hover:bg-red-700 transition-colors shadow-xs">
                    Xác nhận từ chối tin
                </button>
            </div>
        </form>
    </div>
</div>
