@using PropNest.Web.Seller.Services.IServices
@using PropNest.Web.Seller.Helpers
@using PropNest.Web.Seller.Services
@inject ISellerPropertyService SellerService

@{
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? "Properties";
    var rejectedCount = await SellerService.GetRejectedNoticesCountAsync();

    var token = Context.Request.Cookies[AuthHeaderHandler.TokenCookieName];
    var userProfile = Context.Items["UserProfile"] as SellerUserProfile ?? JwtUserHelper.GetProfileFromToken(token);
    var sellerName = !string.IsNullOrWhiteSpace(userProfile?.FullName) ? userProfile.FullName : "Người bán";
    var sellerRoleName = userProfile?.IsSeller == true ? "Tài khoản Người bán" : (userProfile?.Role ?? "Tài khoản Người bán");
}

<!DOCTYPE html>
<html lang="vi" data-scroll-behavior="smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Người bán") - PropNest Seller</title>

    <!-- Google Fonts: Be Vietnam Pro & Playfair Display with full Vietnamese Unicode subset -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&display=swap&subset=vietnamese" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#fff8e3',
                        surface: '#fdf9eb',
                        card: '#ffffff',
                        primary: {
                            DEFAULT: '#d7730c',
                            foreground: '#ffffff',
                            hover: '#b85e07'
                        },
                        'brand-soft': '#fbe6cc',
                        destructive: {
                            DEFAULT: '#d23b2f',
                            foreground: '#ffffff'
                        },
                        border: '#e8e3d5',
                        muted: {
                            DEFAULT: '#f6eed3',
                            foreground: '#6b6354'
                        }
                    },
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                        display: ['"Be Vietnam Pro"', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Theme Custom Styles -->
    <link rel="stylesheet" href="~/css/seller.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-surface text-neutral-900 antialiased font-sans">
    <div class="min-h-screen">
        <!-- Seller Sidebar -->
        <header class="fixed inset-y-0 left-0 z-40 hidden w-64 border-r border-border bg-surface lg:block shadow-xs">
            <div class="flex h-full flex-col justify-between px-5 py-6">
                <div class="space-y-6">
                    <!-- Brand Logo & Badge -->
                    <div class="flex items-center justify-between">
                        <a asp-controller="Properties" asp-action="Index" class="flex items-center gap-2">
                            <div class="grid size-9 place-items-center rounded-xl bg-primary text-white shadow-xs font-bold text-lg font-display">
                                PN
                            </div>
                            <div class="flex flex-col">
                                <span class="font-display text-lg font-bold tracking-tight text-neutral-900 leading-none">PropNest</span>
                                <span class="text-[10px] text-muted-foreground font-sans uppercase tracking-widest mt-0.5">Seller Portal</span>
                            </div>
                        </a>
                        <span class="rounded-full bg-primary/15 text-primary border border-primary/30 px-2.5 py-0.5 text-[11px] font-bold">
                            Người bán
                        </span>
                    </div>

                    <!-- Navigation Links -->
                    <nav class="flex flex-col gap-1.5" aria-label="Cổng Người bán">
                        <!-- My Properties -->
                        <a asp-controller="Properties" asp-action="Index"
                           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-colors @(activeNav == "Properties" ? "bg-brand-soft text-primary font-semibold shadow-xs" : "text-muted-foreground hover:bg-card hover:text-neutral-900")">
                            <i data-lucide="home" class="size-4 shrink-0"></i>
                            <span>Bất động sản của tôi</span>
                        </a>

                        <!-- Create Listing -->
                        <a asp-controller="Properties" asp-action="Create"
                           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-colors @(activeNav == "Create" ? "bg-brand-soft text-primary font-semibold shadow-xs" : "text-muted-foreground hover:bg-card hover:text-neutral-900")">
                            <i data-lucide="plus-circle" class="size-4 shrink-0"></i>
                            <span>Đăng tin mới</span>
                        </a>

                        <!-- Wallet -->
                        <a asp-controller="Wallet" asp-action="Index"
                           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-colors @(activeNav == "Wallet" ? "bg-brand-soft text-primary font-semibold shadow-xs" : "text-muted-foreground hover:bg-card hover:text-neutral-900")">
                            <i data-lucide="wallet" class="size-4 shrink-0"></i>
                            <span>Ví & Giao dịch</span>
                        </a>
                    </nav>

                    <!-- Moderation Feedback Notice -->
                    <a asp-controller="Properties" asp-action="Index" asp-route-status="Rejected"
                       class="flex items-center justify-between rounded-xl border border-border bg-card p-3 text-xs text-muted-foreground hover:border-primary/50 transition-colors shadow-xs">
                        <div class="flex items-center gap-2">
                            <i data-lucide="message-square" class="size-4 text-neutral-900"></i>
                            <span>Phản hồi kiểm duyệt</span>
                        </div>
                        @if (rejectedCount > 0)
                        {
                            <span class="grid size-5 place-items-center rounded-full bg-destructive text-[10px] font-bold text-white">
                                @rejectedCount
                            </span>
                        }
                    </a>
                </div>

                <!-- Footer Sidebar -->
                <div class="space-y-4 border-t border-border pt-4">
                    <a href="https://localhost:7129/" target="_blank" class="flex items-center gap-2 rounded-xl border border-border px-3.5 py-2 text-xs text-muted-foreground hover:bg-card hover:text-neutral-900 transition-colors">
                        <i data-lucide="arrow-left" class="size-3.5"></i> Xem trang khách hàng
                    </a>

                    <!-- User Account Area & Dropdown -->
                    <div class="relative">
                        <button id="userDropdownBtn" type="button" onclick="toggleUserDropdown()"
                                class="flex w-full items-center justify-between rounded-xl border border-border bg-card p-2.5 text-left outline-none hover:border-primary transition-colors shadow-xs">
                            <div class="flex items-center gap-2.5 overflow-hidden">
                                <div class="grid size-8 shrink-0 place-items-center rounded-full bg-primary/15 text-primary">
                                    <i data-lucide="user-round" class="size-4"></i>
                                </div>
                                <div class="truncate">
                                    <p class="truncate text-xs font-semibold text-neutral-900">@sellerName</p>
                                    <p class="text-[10px] text-muted-foreground">@sellerRoleName</p>
                                </div>
                            </div>
                            <i data-lucide="chevron-down" class="size-3.5 text-muted-foreground"></i>
                        </button>

                        <!-- Dropdown Menu -->
                        <div id="userDropdownMenu" class="absolute bottom-full left-0 mb-2 w-full hidden rounded-xl border border-border bg-card p-1.5 shadow-lg z-50">
                            <div class="px-3 py-1.5 text-[11px] font-semibold text-muted-foreground border-b border-border/60">
                                @sellerRoleName
                            </div>
                            <a asp-controller="Properties" asp-action="Index" class="flex items-center gap-2 px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface transition-colors">
                                <i data-lucide="home" class="size-3.5 text-primary"></i> Tin đăng của tôi
                            </a>
                            <div class="border-t border-border/60 my-1"></div>
                            <a href="https://localhost:7129/logout" class="flex items-center gap-2 px-3 py-2 text-xs rounded-lg text-destructive hover:bg-rose-50 transition-colors">
                                <i data-lucide="log-out" class="size-3.5"></i> Đăng xuất
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content Container -->
        <main class="min-h-screen lg:ml-64 p-4 md:p-8">
            @RenderBody()
        </main>
    </div>

    <!-- Toast Notification Container -->
    <div id="sellerToast" class="fixed bottom-6 right-6 z-50 hidden max-w-md rounded-xl p-4 text-xs font-semibold shadow-2xl flex items-center gap-2.5 animate-in fade-in slide-in-from-bottom-2"></div>

    <!-- Floating Toast Popups Container (Nổi trên bề mặt z-[9999], không làm xô lệch layout) -->
    <div id="toastContainer" class="fixed top-6 right-6 z-[9999] flex flex-col gap-3 pointer-events-none max-w-sm sm:max-w-md w-full px-4 sm:px-0">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast-item pointer-events-auto flex items-start gap-3 rounded-2xl border border-emerald-400/40 bg-white/95 p-4 shadow-2xl backdrop-blur-md transition-all duration-300 ring-1 ring-emerald-500/15 text-neutral-900 animate-[toastSlideIn_0.3s_ease-out]">
                <div class="grid size-8 shrink-0 place-items-center rounded-xl bg-emerald-100 text-emerald-700">
                    <i data-lucide="check-circle-2" class="size-5"></i>
                </div>
                <div class="flex-1 min-w-0 pt-0.5">
                    <p class="text-xs font-bold text-emerald-900">Thành công</p>
                    <p class="text-xs text-neutral-700 mt-0.5 leading-relaxed">@TempData["SuccessMessage"]</p>
                </div>
                <button type="button" onclick="dismissToast(this)" class="shrink-0 text-neutral-400 hover:text-neutral-700 p-1 rounded-lg cursor-pointer">
                    <i data-lucide="x" class="size-4"></i>
                </button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="toast-item pointer-events-auto flex items-start gap-3 rounded-2xl border border-amber-400/40 bg-white/95 p-4 shadow-2xl backdrop-blur-md transition-all duration-300 ring-1 ring-amber-500/15 text-neutral-900 animate-[toastSlideIn_0.3s_ease-out]">
                <div class="grid size-8 shrink-0 place-items-center rounded-xl bg-amber-100 text-amber-700">
                    <i data-lucide="alert-triangle" class="size-5"></i>
                </div>
                <div class="flex-1 min-w-0 pt-0.5">
                    <p class="text-xs font-bold text-amber-900">Cảnh báo</p>
                    <p class="text-xs text-neutral-700 mt-0.5 leading-relaxed">@TempData["WarningMessage"]</p>
                </div>
                <button type="button" onclick="dismissToast(this)" class="shrink-0 text-neutral-400 hover:text-neutral-700 p-1 rounded-lg cursor-pointer">
                    <i data-lucide="x" class="size-4"></i>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast-item pointer-events-auto flex items-start gap-3 rounded-2xl border border-rose-400/40 bg-white/95 p-4 shadow-2xl backdrop-blur-md transition-all duration-300 ring-1 ring-rose-500/15 text-neutral-900 animate-[toastSlideIn_0.3s_ease-out]">
                <div class="grid size-8 shrink-0 place-items-center rounded-xl bg-rose-100 text-rose-700">
                    <i data-lucide="alert-triangle" class="size-5"></i>
                </div>
                <div class="flex-1 min-w-0 pt-0.5">
                    <p class="text-xs font-bold text-rose-900">Thông báo</p>
                    <p class="text-xs text-neutral-700 mt-0.5 leading-relaxed">@TempData["ErrorMessage"]</p>
                </div>
                <button type="button" onclick="dismissToast(this)" class="shrink-0 text-neutral-400 hover:text-neutral-700 p-1 rounded-lg cursor-pointer">
                    <i data-lucide="x" class="size-4"></i>
                </button>
            </div>
        }
    </div>

    <!-- Global Back to Top Button -->
    <button type="button" id="backToTopBtn" aria-label="Cuộn lên đầu trang"
            class="fixed bottom-6 right-6 z-40 hidden size-11 place-items-center rounded-full bg-card/90 text-neutral-800 shadow-lg border border-border backdrop-blur-md transition-all duration-300 hover:bg-primary hover:text-white hover:scale-110 hover:shadow-xl hover:border-primary">
        <i data-lucide="arrow-up" class="size-5"></i>
    </button>

    <!-- Lucide Icons & Scripts -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/js/seller.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                showSellerToast("@Html.Raw(TempData["SuccessMessage"])", "success");
                </text>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <text>
                showSellerToast("@Html.Raw(TempData["WarningMessage"])", "warning");
                </text>
            }
        });

        function showSellerToast(msg, type) {
            const toast = document.getElementById("sellerToast");
            if (!toast) return;
            const bg = type === "success" ? "bg-emerald-600 text-white" : "bg-amber-600 text-white";
            toast.className = `fixed bottom-6 right-6 z-50 rounded-xl p-4 text-xs font-semibold shadow-2xl flex items-center gap-2.5 animate-in fade-in slide-in-from-bottom-2 ${bg}`;
            toast.innerHTML = `<i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}" class="size-4 shrink-0"></i><span>${msg}</span>`;
            toast.classList.remove("hidden");
            if (window.lucide) lucide.createIcons();
            setTimeout(() => toast.classList.add("hidden"), 4500);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
