@* Partial View: Modal Chọn Gói Dịch Vụ & Thanh Toán Chạy Ngầm *@

<div id="purchasePackageModal"
     class="fixed inset-0 z-[9999] hidden items-center justify-center p-4 bg-neutral-900/60 backdrop-blur-xs transition-opacity duration-200"
     aria-modal="true" role="dialog" aria-labelledby="modalTitle">

    <div class="relative w-full max-w-2xl rounded-3xl border border-border bg-card shadow-2xl overflow-hidden flex flex-col transition-transform transform duration-200 scale-95 opacity-0"
         id="modalContent">

        <!-- ================= 1. VIEW CHỌN GÓI & XÁC NHẬN THANH TOÁN ================= -->
        <div id="packageSelectView" class="flex flex-col">
            <!-- Modal Header -->
            <div class="px-6 py-5 border-b border-border bg-surface/50 flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="size-10 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center border border-amber-500/20 shadow-2xs">
                        <i data-lucide="sparkles" class="size-5"></i>
                    </div>
                    <div>
                        <h3 id="modalTitle" class="text-base font-bold text-neutral-900">Chọn gói đăng tin & thanh toán</h3>
                        <p class="text-xs text-muted-foreground mt-0.5">
                            Áp dụng cho tin: <span id="modalListingTitle" class="font-semibold text-neutral-800"></span>
                            <span class="font-mono text-muted-foreground font-normal">(#<span id="modalListingId"></span>)</span>
                        </p>
                    </div>
                </div>
                <button type="button"
                        onclick="closePurchasePackageModal()"
                        class="p-1.5 rounded-xl border border-border text-muted-foreground hover:text-neutral-900 hover:bg-surface transition-colors cursor-pointer"
                        title="Đóng">
                    <i data-lucide="x" class="size-4"></i>
                </button>
            </div>

            <!-- Modal Body: Danh sách gói nạp động từ API -->
            <div class="p-6 space-y-4 max-h-[72vh] overflow-y-auto">
                <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
                    <span>Chọn gói theo số ngày lịch (tính tới <strong>23:59:59 giờ VN</strong>):</span>
                    <span>Hiện tại: <strong id="modalCurrentPackage" class="text-neutral-900">Standard</strong></span>
                </div>

                <div id="packageOptionsContainer" class="space-y-4">
                    <div class="rounded-2xl border border-dashed border-border p-6 text-center text-xs text-muted-foreground">
                        Đang tải bảng giá gói dịch vụ...
                    </div>
                </div>

                <!-- Tóm tắt thanh toán, Hạn sử dụng dự kiến & Số dư ví -->
                <div class="rounded-2xl border border-border bg-surface/60 p-4 space-y-2.5">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Gói dịch vụ đã chọn:</span>
                        <span id="summaryPackageName" class="font-bold text-neutral-900">--</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Thời hạn gói mua thêm:</span>
                        <span id="summaryDuration" class="font-semibold text-neutral-800">--</span>
                    </div>
                    <div id="summaryVipExpiryRow" class="hidden flex items-center justify-between text-xs">
                        <span class="text-amber-800 font-medium">Hạn VIP dự kiến:</span>
                        <span id="summaryVipExpiry" class="font-bold text-amber-700">--</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Hạn hiển thị tin dự kiến:</span>
                        <span id="summaryListingExpiry" class="font-bold text-emerald-700">--</span>
                    </div>
                    <p id="summaryDowngradeNote" class="hidden text-[11px] text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-2.5 py-1.5 leading-relaxed"></p>

                    <div class="border-t border-border/80 pt-2 flex items-center justify-between text-xs">
                        <span class="font-semibold text-neutral-900">Tổng thanh toán:</span>
                        <span id="summaryPrice" class="text-base font-black text-primary">0 ₫</span>
                    </div>

                    <div class="border-t border-border/60 pt-2 space-y-1.5">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground flex items-center gap-1.5">
                                <i data-lucide="wallet" class="size-3.5 text-primary"></i>
                                Số dư ví hiện tại:
                            </span>
                            <span id="summaryCurrentBalance" class="font-bold text-neutral-900">Đang tải...</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground flex items-center gap-1.5">
                                <i data-lucide="calculator" class="size-3.5 text-muted-foreground"></i>
                                Số dư sau thanh toán:
                            </span>
                            <span id="summaryRemainingBalance" class="font-bold text-emerald-600">--</span>
                        </div>
                    </div>

                    <div id="insufficientBalanceAlert" class="hidden rounded-xl border border-rose-200 bg-rose-50/90 p-3 text-xs text-rose-800 space-y-1.5">
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-1.5 font-semibold text-rose-700">
                                <i data-lucide="alert-circle" class="size-4 shrink-0 text-rose-600"></i>
                                <span>Số dư ví không đủ để thanh toán</span>
                            </div>
                            <a asp-controller="Wallet" asp-action="Index"
                               class="px-2.5 py-1 rounded-lg bg-rose-600 text-white font-bold text-[11px] hover:bg-rose-700 transition-colors shrink-0 flex items-center gap-1">
                                <i data-lucide="plus-circle" class="size-3"></i> Nạp tiền ngay
                            </a>
                        </div>
                        <p class="text-[11px] text-rose-600 leading-relaxed">
                            Vui lòng nạp thêm tiền vào ví để hoàn tất giao dịch thanh toán gói tin đăng này.
                        </p>
                    </div>

                    <p class="text-[11px] text-muted-foreground flex items-center gap-1.5 pt-1">
                        <i data-lucide="info" class="size-3.5 text-muted-foreground/80 shrink-0"></i>
                        <span>Số tiền sẽ được trừ trực tiếp từ số dư ví PropNest và cộng dồn thời hạn tự động.</span>
                    </p>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 border-t border-border bg-surface/40 flex items-center justify-end gap-3">
                <button type="button"
                        onclick="closePurchasePackageModal()"
                        class="h-10 px-4 rounded-xl border border-border bg-card text-neutral-700 hover:bg-surface text-xs font-semibold transition-colors cursor-pointer">
                    Hủy bỏ
                </button>
                <button type="button"
                        id="btnConfirmPurchase"
                        onclick="startPurchasePackageWorkflow()"
                        class="h-10 px-5 rounded-xl bg-primary text-white hover:bg-primary-hover text-xs font-bold transition-all shadow-sm flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                    <i data-lucide="credit-card" class="size-4"></i>
                    <span id="btnConfirmPurchaseLabel">Xác nhận thanh toán</span>
                </button>
            </div>
        </div>

        <!-- ================= 2. VIEW KẾT QUẢ THÀNH CÔNG ================= -->
        <div id="packageResultSuccessView" class="hidden flex-col p-6 sm:p-8 space-y-6 text-center">
            <div class="size-16 rounded-3xl bg-emerald-500/10 text-emerald-600 mx-auto flex items-center justify-center border border-emerald-500/20 shadow-xs">
                <i data-lucide="check-circle-2" class="size-10"></i>
            </div>

            <div class="space-y-1.5">
                <h3 class="text-xl font-bold text-neutral-900 font-display">Thanh toán & kích hoạt thành công!</h3>
                <p class="text-xs text-muted-foreground max-w-sm mx-auto leading-relaxed">
                    Tin đăng <span id="resSuccessListingTitle" class="font-bold text-neutral-800"></span> đã áp dụng <span id="resSuccessPackageName" class="font-bold text-emerald-700"></span> thành công.
                </p>
            </div>

            <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4 text-xs text-emerald-900 text-left space-y-2">
                <div class="flex items-center gap-2 font-bold text-emerald-800">
                    <i data-lucide="sparkles" class="size-4 text-emerald-600"></i>
                    <span>Trạng thái & quyền lợi đã cập nhật:</span>
                </div>
                <ul class="text-muted-foreground text-xs space-y-1 list-disc list-inside leading-relaxed">
                    <li>Tin đăng đã chuyển/duy trì trạng thái <strong>Đang hiển thị (Published)</strong>.</li>
                    <li>Thời hạn hiển thị và quyền lợi VIP (nếu có) được tính trọn ngày tới 23:59:59 giờ Việt Nam.</li>
                    <li>Hết hạn gói VIP sẽ tự quay về gói Tiêu chuẩn nếu thời hạn sống vẫn còn.</li>
                </ul>
            </div>

            <div class="pt-2">
                <button type="button"
                        onclick="window.location.reload()"
                        class="w-full h-11 rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 text-xs font-bold transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                    <i data-lucide="check" class="size-4"></i>
                    <span>Hoàn tất & Cập nhật danh sách</span>
                </button>
            </div>
        </div>

        <!-- ================= 3. VIEW KẾT QUẢ THẤT BẠI ================= -->
        <div id="packageResultFailedView" class="hidden flex-col p-6 sm:p-8 space-y-6 text-center">
            <div class="size-16 rounded-3xl bg-rose-500/10 text-rose-600 mx-auto flex items-center justify-center border border-rose-500/20 shadow-xs">
                <i data-lucide="alert-triangle" class="size-10"></i>
            </div>

            <div class="space-y-2">
                <h3 class="text-xl font-bold text-neutral-900 font-display">Giao dịch không thành công</h3>
                <div id="resErrorMessage" class="p-3.5 rounded-2xl border border-rose-200 bg-rose-50 text-rose-700 text-xs font-medium max-w-md mx-auto text-left leading-relaxed">
                    Không thể thực hiện giao dịch thanh toán gói tin.
                </div>
            </div>

            <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-4 text-xs text-amber-900 text-left flex items-start gap-3">
                <i data-lucide="shield-check" class="size-5 text-amber-600 shrink-0 mt-0.5"></i>
                <div class="space-y-0.5">
                    <strong class="font-bold text-neutral-900">Bảo vệ số dư ví:</strong>
                    <p class="text-muted-foreground text-xs leading-relaxed">
                        Số dư trong ví của bạn không bị trừ hoặc đã được hoàn trả lại ví 100%.
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="button"
                        onclick="closePurchasePackageModal()"
                        class="flex-1 h-11 rounded-xl border border-border bg-card text-neutral-700 hover:bg-surface text-xs font-semibold transition-colors cursor-pointer">
                    Đóng
                </button>
                <a asp-controller="Wallet" asp-action="Index"
                   class="flex-1 h-11 rounded-xl bg-primary text-white hover:bg-primary-hover text-xs font-bold transition-all shadow-sm flex items-center justify-center gap-2">
                    <i data-lucide="wallet" class="size-4"></i>
                    <span>Nạp tiền vào ví</span>
                </a>
            </div>
        </div>

    </div>
</div>

<!-- ================= JAVASCRIPT CHẠY NGẦM & PREVIEW HẠN LỊCH VN ================= -->
<script>
    const VN_OFFSET_MS = 7 * 60 * 60 * 1000;
    let currentListingId = 0;
    let currentListingTitle = '';
    let currentListingPackageTier = 'Standard';
    let currentListingStatus = 'PendingPayment';
    let currentListingEndDateIso = '';
    let currentListingPackageEndDateIso = '';
    let cachedPackages = null;
    let selectedPackageCode = '';
    let selectedPackageKind = 'Standard';
    let selectedPackagePrice = 0;
    let selectedPackageName = '';
    let selectedPackageDays = 7;
    let currentWalletBalance = 0;
    let isFetchingWallet = false;
    let activeBackgroundTimer = null;

    function formatVndCurrency(amount) {
        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
    }

    function escapeModalHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function getVnCalendarParts(dateInput) {
        const d = dateInput instanceof Date ? dateInput : new Date(dateInput);
        const shifted = new Date(d.getTime() + VN_OFFSET_MS);
        return {
            year: shifted.getUTCFullYear(),
            month: shifted.getUTCMonth(),
            day: shifted.getUTCDate()
        };
    }

    function computeNewVnEndDate(durationDays) {
        const vnToday = getVnCalendarParts(new Date());
        return new Date(Date.UTC(vnToday.year, vnToday.month, vnToday.day + (durationDays - 1), 23 - 7, 59, 59));
    }

    function extendVnEndDate(existingIso, durationDays) {
        const vnOld = getVnCalendarParts(new Date(existingIso));
        return new Date(Date.UTC(vnOld.year, vnOld.month, vnOld.day + durationDays, 23 - 7, 59, 59));
    }

    function formatVnDateTime(dateObj) {
        if (!dateObj || isNaN(dateObj.getTime())) return '--';
        const parts = getVnCalendarParts(dateObj);
        const dd = String(parts.day).padStart(2, '0');
        const mm = String(parts.month + 1).padStart(2, '0');
        return `${dd}/${mm}/${parts.year} 23:59`;
    }

    async function fetchPackagesCatalog() {
        if (Array.isArray(cachedPackages) && cachedPackages.length > 0) {
            return cachedPackages;
        }
        try {
            const res = await fetch('/Properties/GetPackages');
            if (res.ok) {
                const data = await res.json();
                if (Array.isArray(data) && data.length > 0) {
                    cachedPackages = data;
                    return cachedPackages;
                }
            }
        } catch (e) {
            console.error('Không thể tải danh sách gói:', e);
        }
        return [];
    }

    function renderPackageOptions(packages) {
        const container = document.getElementById('packageOptionsContainer');
        if (!container) return;

        if (!packages || packages.length === 0) {
            container.innerHTML = '<div class="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700 text-center">Hiện chưa tải được bảng giá gói dịch vụ. Vui lòng thử lại sau.</div>';
            return;
        }

        const standardPkgs = packages.filter(p => String(p.kind || p.Kind).toLowerCase() === 'standard');
        const vipPkgs = packages.filter(p => String(p.kind || p.Kind).toLowerCase() === 'vip');

        const renderCard = (pkg, isVip, checked) => {
            const code = pkg.packageCode || pkg.PackageCode;
            const name = pkg.name || pkg.Name;
            const price = Number(pkg.price !== undefined ? pkg.price : pkg.Price) || 0;
            const days = Number(pkg.durationDays !== undefined ? pkg.durationDays : pkg.DurationDays) || 7;
            const kind = pkg.kind || pkg.Kind || 'Standard';

            return `
                <label class="package-card-option relative flex flex-col justify-between gap-2 p-3.5 rounded-2xl border-2 cursor-pointer transition-all shadow-2xs ${isVip ? 'border-amber-300/80 bg-amber-50/30 hover:border-amber-500' : 'border-border bg-card hover:border-primary/50'}">
                    <div class="flex items-start justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <input type="radio" name="selectedPackageCode" value="${escapeModalHtml(code)}"
                                   ${checked ? 'checked' : ''}
                                   data-name="${escapeModalHtml(name)}"
                                   data-price="${price}"
                                   data-days="${days}"
                                   data-kind="${escapeModalHtml(kind)}"
                                   class="size-4 ${isVip ? 'text-amber-600 focus:ring-amber-500' : 'text-primary focus:ring-primary'}"
                                   onchange="onPackageSelected(this)">
                            <span class="text-xs font-bold ${isVip ? 'text-amber-950' : 'text-neutral-900'}">${days} ngày</span>
                        </div>
                        <span class="rounded-md px-1.5 py-0.5 text-[10px] font-bold ${isVip ? 'bg-amber-100 text-amber-800' : 'bg-surface text-muted-foreground border border-border'}">
                            ${escapeModalHtml(kind)}
                        </span>
                    </div>
                    <div class="pl-6">
                        <div class="text-sm font-black ${isVip ? 'text-amber-700' : 'text-primary'}">${formatVndCurrency(price)}</div>
                        <div class="text-[10px] text-muted-foreground">~${formatVndCurrency(Math.round(price / days))}/ngày</div>
                    </div>
                </label>`;
        };

        const defaultCode = (vipPkgs[0]?.packageCode || vipPkgs[0]?.PackageCode) || (standardPkgs[0]?.packageCode || standardPkgs[0]?.PackageCode);
        let html = '';

        if (standardPkgs.length > 0) {
            html += `
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-800 flex items-center gap-1.5">
                            <i data-lucide="layers" class="size-3.5 text-primary"></i>
                            Gói Tiêu Chuẩn (Standard)
                        </h4>
                        <span class="text-[11px] text-muted-foreground">Hiển thị chuẩn & gia hạn thời gian sống tin</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                        ${standardPkgs.map(p => renderCard(p, false, (p.packageCode || p.PackageCode) === defaultCode)).join('')}
                    </div>
                </div>`;
        }

        if (vipPkgs.length > 0) {
            html += `
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-800 flex items-center gap-1.5">
                            <i data-lucide="crown" class="size-3.5 text-amber-500"></i>
                            Gói VIP Nổi Bật
                        </h4>
                        <span class="text-[11px] text-amber-700 font-medium">Huy hiệu VIP • Ưu tiên đầu tìm kiếm</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                        ${vipPkgs.map(p => renderCard(p, true, (p.packageCode || p.PackageCode) === defaultCode)).join('')}
                    </div>
                </div>`;
        }

        container.innerHTML = html;
        const checkedRadio = container.querySelector('input[name="selectedPackageCode"]:checked') || container.querySelector('input[name="selectedPackageCode"]');
        if (checkedRadio) {
            checkedRadio.checked = true;
            onPackageSelected(checkedRadio);
        }
        if (window.lucide) window.lucide.createIcons();
    }

    async function fetchWalletBalance() {
        if (isFetchingWallet) return;
        isFetchingWallet = true;
        try {
            const res = await fetch('/Properties/GetWalletBalance');
            if (res.ok) {
                const data = await res.json();
                currentWalletBalance = typeof data.totalBalance === 'number' ? data.totalBalance : 0;
            }
        } catch (e) {
            console.error('Không thể lấy số dư ví:', e);
        } finally {
            isFetchingWallet = false;
            updateSummaryUI();
        }
    }

    function openPurchasePackageModalFromElement(btn) {
        if (!btn) return;
        const listingId = parseInt(btn.dataset.listingId || '0', 10);
        const listingTitle = btn.dataset.listingTitle || ('Tin đăng #' + listingId);
        const currentPackage = btn.dataset.packageCode || 'Standard';
        const listingStatus = btn.dataset.listingStatus || 'PendingPayment';
        const endDateIso = btn.dataset.endDate || '';
        const packageEndDateIso = btn.dataset.packageEndDate || '';
        openPurchasePackageModal(listingId, listingTitle, currentPackage, listingStatus, endDateIso, packageEndDateIso);
    }

    async function openPurchasePackageModal(listingId, listingTitle, currentPackage, listingStatus, endDateIso, packageEndDateIso) {
        currentListingId = listingId;
        currentListingTitle = listingTitle || ('Tin đăng #' + listingId);
        currentListingPackageTier = currentPackage || 'Standard';
        currentListingStatus = listingStatus || 'PendingPayment';
        currentListingEndDateIso = endDateIso || '';
        currentListingPackageEndDateIso = packageEndDateIso || '';

        document.getElementById('modalListingId').innerText = listingId;
        document.getElementById('modalListingTitle').innerText = currentListingTitle;
        document.getElementById('modalCurrentPackage').innerText = currentListingPackageTier;

        const titleEl = document.getElementById('modalTitle');
        const btnLabelEl = document.getElementById('btnConfirmPurchaseLabel');
        if (currentListingStatus === 'PendingPayment') {
            if (titleEl) titleEl.innerText = 'Thanh toán gói để đăng tin';
            if (btnLabelEl) btnLabelEl.innerText = 'Thanh toán & Đăng tin';
        } else if (currentListingStatus === 'Expired') {
            if (titleEl) titleEl.innerText = 'Gia hạn & bật hiển thị lại tin';
            if (btnLabelEl) btnLabelEl.innerText = 'Thanh toán & Gia hạn';
        } else {
            if (titleEl) titleEl.innerText = 'Mua thêm / Nâng cấp gói dịch vụ';
            if (btnLabelEl) btnLabelEl.innerText = 'Xác nhận thanh toán';
        }

        document.getElementById('packageSelectView').classList.remove('hidden');
        document.getElementById('packageResultSuccessView').classList.add('hidden');
        document.getElementById('packageResultFailedView').classList.add('hidden');

        openModalDialog();

        const packages = await fetchPackagesCatalog();
        renderPackageOptions(packages);
        fetchWalletBalance();
    }

    function openModalDialog() {
        const modal = document.getElementById('purchasePackageModal');
        const content = document.getElementById('modalContent');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    function closePurchasePackageModal() {
        const modal = document.getElementById('purchasePackageModal');
        const content = document.getElementById('modalContent');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }, 200);
    }

    function onPackageSelected(radio) {
        if (!radio) return;
        selectedPackageCode = radio.value;
        selectedPackagePrice = parseFloat(radio.dataset.price) || 0;
        selectedPackageName = radio.dataset.name || radio.value;
        selectedPackageDays = parseInt(radio.dataset.days, 10) || 7;
        selectedPackageKind = radio.dataset.kind || 'Standard';

        updateSummaryUI();
    }

    function computeProjectedDates() {
        const now = new Date();
        const existingEnd = currentListingEndDateIso ? new Date(currentListingEndDateIso) : null;
        const hasActiveLifespan = currentListingStatus === 'Published' && existingEnd && !isNaN(existingEnd.getTime()) && existingEnd > now;

        const existingVipEnd = currentListingPackageEndDateIso ? new Date(currentListingPackageEndDateIso) : null;
        const hasActiveVip = hasActiveLifespan && currentListingPackageTier === 'VIP' && existingVipEnd && !isNaN(existingVipEnd.getTime()) && existingVipEnd > now;

        if (String(selectedPackageKind).toLowerCase() === 'vip') {
            const vipEnd = hasActiveVip
                ? extendVnEndDate(existingVipEnd.toISOString(), selectedPackageDays)
                : computeNewVnEndDate(selectedPackageDays);
            const listingEnd = (hasActiveLifespan && existingEnd > vipEnd) ? existingEnd : vipEnd;
            return { vipEnd, listingEnd, isVipActive: true, hasRemainingStandardAfterVip: hasActiveLifespan && existingEnd > vipEnd };
        }

        const listingEnd = hasActiveLifespan
            ? extendVnEndDate(existingEnd.toISOString(), selectedPackageDays)
            : computeNewVnEndDate(selectedPackageDays);

        return {
            vipEnd: hasActiveVip ? existingVipEnd : null,
            listingEnd,
            isVipActive: hasActiveVip,
            hasRemainingStandardAfterVip: hasActiveVip && listingEnd > existingVipEnd
        };
    }

    function updateSummaryUI() {
        const summaryPackageEl = document.getElementById('summaryPackageName');
        const summaryDurationEl = document.getElementById('summaryDuration');
        const summaryPriceEl = document.getElementById('summaryPrice');
        const summaryVipRow = document.getElementById('summaryVipExpiryRow');
        const summaryVipEl = document.getElementById('summaryVipExpiry');
        const summaryListingEl = document.getElementById('summaryListingExpiry');
        const downgradeNoteEl = document.getElementById('summaryDowngradeNote');
        const currentBalanceEl = document.getElementById('summaryCurrentBalance');
        const remainingBalanceEl = document.getElementById('summaryRemainingBalance');
        const alertEl = document.getElementById('insufficientBalanceAlert');
        const confirmBtn = document.getElementById('btnConfirmPurchase');

        if (summaryPackageEl) summaryPackageEl.innerText = selectedPackageName || '--';
        if (summaryDurationEl) summaryDurationEl.innerText = selectedPackageCode ? `${selectedPackageDays} ngày (cộng dồn)` : '--';
        if (summaryPriceEl) summaryPriceEl.innerText = formatVndCurrency(selectedPackagePrice);

        if (selectedPackageCode) {
            const proj = computeProjectedDates();
            if (summaryListingEl) summaryListingEl.innerText = formatVnDateTime(proj.listingEnd);
            if (summaryVipRow && summaryVipEl) {
                if (proj.isVipActive && proj.vipEnd) {
                    summaryVipRow.classList.remove('hidden');
                    summaryVipEl.innerText = formatVnDateTime(proj.vipEnd);
                } else {
                    summaryVipRow.classList.add('hidden');
                }
            }
            if (downgradeNoteEl) {
                if (proj.isVipActive && proj.hasRemainingStandardAfterVip && proj.vipEnd) {
                    downgradeNoteEl.classList.remove('hidden');
                    downgradeNoteEl.innerText = `Sau khi hết VIP (${formatVnDateTime(proj.vipEnd)}), tin tự chuyển về gói Standard và tiếp tục hiển thị đến ${formatVnDateTime(proj.listingEnd)}.`;
                } else {
                    downgradeNoteEl.classList.add('hidden');
                }
            }
        }

        if (currentBalanceEl) {
            currentBalanceEl.innerText = formatVndCurrency(currentWalletBalance);
        }

        const remaining = currentWalletBalance - selectedPackagePrice;
        if (remainingBalanceEl) {
            if (remaining >= 0) {
                remainingBalanceEl.innerText = formatVndCurrency(remaining);
                remainingBalanceEl.className = 'font-bold text-emerald-600';
            } else {
                remainingBalanceEl.innerText = `-${formatVndCurrency(Math.abs(remaining))} (Thiếu tiền)`;
                remainingBalanceEl.className = 'font-bold text-rose-600';
            }
        }

        if (!selectedPackageCode || (selectedPackagePrice > 0 && remaining < 0)) {
            if (selectedPackageCode && alertEl) alertEl.classList.remove('hidden');
            if (confirmBtn) {
                confirmBtn.classList.add('opacity-50', 'cursor-not-allowed');
                confirmBtn.title = selectedPackageCode ? 'Số dư ví không đủ để thanh toán gói này' : 'Vui lòng chọn gói dịch vụ';
            }
        } else {
            if (alertEl) alertEl.classList.add('hidden');
            if (confirmBtn) {
                confirmBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                confirmBtn.title = 'Bấm để thanh toán và kích hoạt gói';
            }
        }

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    async function startPurchasePackageWorkflow() {
        if (!currentListingId || !selectedPackageCode) return;

        if (selectedPackagePrice > 0 && currentWalletBalance < selectedPackagePrice) {
            if (typeof showSellerToast === 'function') {
                showSellerToast(`Số dư ví (${formatVndCurrency(currentWalletBalance)}) không đủ để thanh toán ${formatVndCurrency(selectedPackagePrice)}. Vui lòng nạp thêm tiền!`, 'error', 5000);
            }
            return;
        }

        const confirmBtn = document.getElementById('btnConfirmPurchase');
        if (confirmBtn) confirmBtn.disabled = true;

        const targetListingId = currentListingId;
        const targetListingTitle = currentListingTitle;
        const targetPackageName = selectedPackageName;

        const idempotencyKey = (window.crypto && crypto.randomUUID)
            ? crypto.randomUUID()
            : ('idemp-' + Date.now() + '-' + Math.random().toString(36).substring(2, 9));

        closePurchasePackageModal();

        if (typeof showSellerToast === 'function') {
            showSellerToast(`Đang xử lý thanh toán ${targetPackageName} cho tin #${targetListingId}...`, 'loading', 0);
        }

        try {
            const response = await fetch('/Properties/PurchasePackage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    listingId: targetListingId,
                    packageCode: selectedPackageCode,
                    amount: selectedPackagePrice,
                    idempotencyKey: idempotencyKey
                })
            });

            const data = await response.json();

            if (!response.ok || !data.success || !data.correlationId) {
                const toast = document.getElementById('sellerToast');
                if (toast) toast.classList.add('hidden');
                showFailedResultModal(data.message || 'Không thể bắt đầu tiến trình thanh toán gói. Vui lòng thử lại sau.');
                return;
            }

            startBackgroundWorkflowPolling(data.correlationId, targetListingId, targetListingTitle, targetPackageName);
        } catch (err) {
            console.error('Lỗi khi gửi yêu cầu mua gói:', err);
            const toast = document.getElementById('sellerToast');
            if (toast) toast.classList.add('hidden');
            showFailedResultModal('Đã xảy ra lỗi kết nối khi gửi yêu cầu. Vui lòng kiểm tra lại mạng.');
        } finally {
            if (confirmBtn) confirmBtn.disabled = false;
        }
    }

    function startBackgroundWorkflowPolling(correlationId, listingId, listingTitle, packageName) {
        if (activeBackgroundTimer) {
            clearInterval(activeBackgroundTimer);
        }

        let attempts = 0;
        const maxAttempts = 60;

        activeBackgroundTimer = setInterval(async () => {
            attempts++;
            if (attempts > maxAttempts) {
                clearInterval(activeBackgroundTimer);
                activeBackgroundTimer = null;
                const toast = document.getElementById('sellerToast');
                if (toast) toast.classList.add('hidden');
                showFailedResultModal(`Giao dịch cho tin #${listingId} mất nhiều thời gian hơn dự kiến. Vui lòng kiểm tra lại ví hoặc làm mới trang sau.`);
                return;
            }

            try {
                const res = await fetch(`/Properties/WorkflowStatus/${correlationId}`);
                if (!res.ok) {
                    if (res.status === 404) return;
                    clearInterval(activeBackgroundTimer);
                    activeBackgroundTimer = null;
                    const toast = document.getElementById('sellerToast');
                    if (toast) toast.classList.add('hidden');
                    showFailedResultModal('Không thể kiểm tra trạng thái tiến trình xử lý.');
                    return;
                }

                const workflow = await res.json();

                if (workflow.isCompleted || workflow.status === 5) {
                    clearInterval(activeBackgroundTimer);
                    activeBackgroundTimer = null;
                    const toast = document.getElementById('sellerToast');
                    if (toast) toast.classList.add('hidden');
                    showSuccessResultModal(packageName, listingTitle);
                } else if (workflow.isFailed || workflow.status === 7 || workflow.status === 8) {
                    clearInterval(activeBackgroundTimer);
                    activeBackgroundTimer = null;
                    const toast = document.getElementById('sellerToast');
                    if (toast) toast.classList.add('hidden');
                    const errMsg = workflow.errorMessage || (workflow.status === 7
                        ? 'Giao dịch bồi hoàn: Số dư ví không đủ hoặc tin chưa đủ điều kiện. Tiền đã được hoàn lại ví.'
                        : 'Giao dịch thất bại. Tiền không bị trừ.');
                    showFailedResultModal(errMsg);
                }
            } catch (error) {
                console.error('Lỗi khi polling workflow ngầm:', error);
            }
        }, 1500);
    }

    function showSuccessResultModal(packageName, listingTitle) {
        document.getElementById('packageSelectView').classList.add('hidden');
        document.getElementById('packageResultFailedView').classList.add('hidden');
        document.getElementById('packageResultSuccessView').classList.remove('hidden');
        document.getElementById('resSuccessPackageName').innerText = packageName;
        document.getElementById('resSuccessListingTitle').innerText = listingTitle || ('#' + currentListingId);
        openModalDialog();
    }

    function showFailedResultModal(errorMessage) {
        document.getElementById('packageSelectView').classList.add('hidden');
        document.getElementById('packageResultSuccessView').classList.add('hidden');
        document.getElementById('packageResultFailedView').classList.remove('hidden');
        document.getElementById('resErrorMessage').innerText = errorMessage || 'Giao dịch không thành công. Vui lòng thử lại sau.';
        openModalDialog();
    }
</script>
