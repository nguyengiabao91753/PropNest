@* Partial View: Modal Chọn Gói Dịch Vụ & Luồng Nâng Cấp Tin Chạy Ngầm *@

<div id="purchasePackageModal"
     class="fixed inset-0 z-[9999] hidden items-center justify-center p-4 bg-neutral-900/60 backdrop-blur-xs transition-opacity duration-200"
     aria-modal="true" role="dialog" aria-labelledby="modalTitle">

    <div class="relative w-full max-w-xl rounded-3xl border border-border bg-card shadow-2xl overflow-hidden flex flex-col transition-transform transform duration-200 scale-95 opacity-0"
         id="modalContent">

        <!-- ================= 1. VIEW CHỌN GÓI & XÁC NHẬN THANH TOÁN ================= -->
        <div id="packageSelectView" class="flex flex-col">
            <!-- Modal Header -->
            <div class="px-6 py-5 border-b border-border bg-surface/50 flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="size-10 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center border border-amber-500/20 shadow-2xs">
                        <i data-lucide="sparkles" class="size-5"></i>
                    </div>
                    <div>
                        <h3 id="modalTitle" class="text-base font-bold text-neutral-900">Nâng cấp gói dịch vụ</h3>
                        <p class="text-xs text-muted-foreground mt-0.5">
                            Áp dụng cho tin: <span id="modalListingTitle" class="font-semibold text-neutral-800"></span>
                            <span class="font-mono text-muted-foreground font-normal">(#<span id="modalListingId"></span>)</span>
                        </p>
                    </div>
                </div>
                <button type="button"
                        onclick="closePurchasePackageModal()"
                        class="p-1.5 rounded-xl border border-border text-muted-foreground hover:text-neutral-900 hover:bg-surface transition-colors cursor-pointer"
                        title="Đóng">
                    <i data-lucide="x" class="size-4"></i>
                </button>
            </div>

            <!-- Modal Body: Lựa chọn 3 gói -->
            <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                    <span>Chọn gói phù hợp với nhu cầu của bạn:</span>
                    <span>Gói hiện tại: <strong id="modalCurrentPackage" class="text-neutral-900">Standard</strong></span>
                </div>

                <div class="space-y-3" id="packageOptionsContainer">
                    <!-- Gói 1: Standard -->
                    <label class="package-option-card relative flex items-start justify-between gap-4 p-4 rounded-2xl border-2 border-border bg-card hover:border-primary/40 cursor-pointer transition-all shadow-2xs">
                        <div class="flex items-start gap-3">
                            <input type="radio" name="selectedPackageCode" value="Standard"
                                   data-name="Gói Tiêu Chuẩn (Standard)" data-price="0" data-days="30"
                                   class="mt-1 size-4 text-primary border-border focus:ring-primary"
                                   onchange="onPackageSelected(this)">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-sm font-bold text-neutral-900">Gói Tiêu Chuẩn (Standard)</h4>
                                    <span class="rounded-md bg-surface text-muted-foreground text-[10px] font-semibold px-2 py-0.5 border border-border">30 ngày</span>
                                </div>
                                <p class="text-xs text-muted-foreground mt-1">Đăng tin tiêu chuẩn, đầy đủ hình ảnh và thông số kỹ thuật.</p>
                            </div>
                        </div>
                        <div class="text-right shrink-0">
                            <span class="text-sm font-bold text-neutral-900">Miễn phí (0 ₫)</span>
                            <span class="block text-[11px] text-muted-foreground">/ 30 ngày</span>
                        </div>
                    </label>

                    <!-- Gói 2: VIP (Khuyên dùng) -->
                    <label class="package-option-card relative flex items-start justify-between gap-4 p-4 rounded-2xl border-2 border-amber-500/80 bg-amber-50/20 hover:border-amber-500 cursor-pointer transition-all shadow-xs ring-1 ring-amber-500/20">
                        <div class="absolute -top-2.5 right-4 rounded-full bg-amber-500 text-white text-[10px] font-bold px-2.5 py-0.5 shadow-xs uppercase tracking-wide">
                            Khuyên dùng • Tăng tương tác
                        </div>
                        <div class="flex items-start gap-3">
                            <input type="radio" name="selectedPackageCode" value="VIP" checked
                                   data-name="Gói VIP Đẳng Cấp" data-price="150000" data-days="30"
                                   class="mt-1 size-4 text-amber-600 border-amber-400 focus:ring-amber-500"
                                   onchange="onPackageSelected(this)">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-sm font-bold text-amber-950 flex items-center gap-1.5">
                                        <i data-lucide="crown" class="size-4 text-amber-500"></i>
                                        Gói VIP Đẳng Cấp
                                    </h4>
                                    <span class="rounded-md bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 border border-amber-200">30 ngày</span>
                                </div>
                                <p class="text-xs text-amber-900/80 mt-1">Gắn huy hiệu VIP, hiển thị ưu tiên đầu trang chủ & danh mục tìm kiếm.</p>
                            </div>
                        </div>
                        <div class="text-right shrink-0">
                            <span class="text-base font-black text-amber-700">150.000 ₫</span>
                            <span class="block text-[11px] text-amber-900/70">/ 30 ngày</span>
                        </div>
                    </label>

                    <!-- Gói 3: Boost -->
                    <label class="package-option-card relative flex items-start justify-between gap-4 p-4 rounded-2xl border-2 border-border bg-card hover:border-primary/40 cursor-pointer transition-all shadow-2xs">
                        <div class="flex items-start gap-3">
                            <input type="radio" name="selectedPackageCode" value="Boost"
                                   data-name="Gói Đẩy Tin (Boost)" data-price="30000" data-days="7"
                                   class="mt-1 size-4 text-primary border-border focus:ring-primary"
                                   onchange="onPackageSelected(this)">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-sm font-bold text-neutral-900 flex items-center gap-1.5">
                                        <i data-lucide="zap" class="size-4 text-primary"></i>
                                        Gói Đẩy Tin (Boost)
                                    </h4>
                                    <span class="rounded-md bg-surface text-muted-foreground text-[10px] font-semibold px-2 py-0.5 border border-border">7 ngày</span>
                                </div>
                                <p class="text-xs text-muted-foreground mt-1">Đưa tin đăng lên vị trí top đầu danh mục tìm kiếm trong 7 ngày.</p>
                            </div>
                        </div>
                        <div class="text-right shrink-0">
                            <span class="text-sm font-bold text-neutral-900">30.000 ₫</span>
                            <span class="block text-[11px] text-muted-foreground">/ 7 ngày</span>
                        </div>
                    </label>
                </div>

                <!-- Tóm tắt thanh toán & Số dư ví -->
                <div class="rounded-2xl border border-border bg-surface/60 p-4 space-y-2.5">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Gói dịch vụ đã chọn:</span>
                        <span id="summaryPackageName" class="font-bold text-neutral-900">Gói VIP Đẳng Cấp</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Thời hạn áp dụng:</span>
                        <span id="summaryDuration" class="font-semibold text-neutral-800">30 ngày</span>
                    </div>
                    <div class="border-t border-border/80 pt-2 flex items-center justify-between text-xs">
                        <span class="font-semibold text-neutral-900">Tổng thanh toán:</span>
                        <span id="summaryPrice" class="text-base font-black text-primary">150.000 ₫</span>
                    </div>

                    <!-- Hiển thị Tổng số dư của seller & Số dư sau khi thanh toán -->
                    <div class="border-t border-border/60 pt-2 space-y-1.5">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground flex items-center gap-1.5">
                                <i data-lucide="wallet" class="size-3.5 text-primary"></i>
                                Số dư ví hiện tại:
                            </span>
                            <span id="summaryCurrentBalance" class="font-bold text-neutral-900">Đang tải...</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground flex items-center gap-1.5">
                                <i data-lucide="calculator" class="size-3.5 text-muted-foreground"></i>
                                Số dư sau thanh toán:
                            </span>
                            <span id="summaryRemainingBalance" class="font-bold text-emerald-600">--</span>
                        </div>
                    </div>

                    <!-- Cảnh báo số dư không đủ -->
                    <div id="insufficientBalanceAlert" class="hidden rounded-xl border border-rose-200 bg-rose-50/90 p-3 text-xs text-rose-800 space-y-1.5">
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-1.5 font-semibold text-rose-700">
                                <i data-lucide="alert-circle" class="size-4 shrink-0 text-rose-600"></i>
                                <span>Số dư ví không đủ để thanh toán</span>
                            </div>
                            <a asp-controller="Wallet" asp-action="Index"
                               class="px-2.5 py-1 rounded-lg bg-rose-600 text-white font-bold text-[11px] hover:bg-rose-700 transition-colors shrink-0 flex items-center gap-1">
                                <i data-lucide="plus-circle" class="size-3"></i> Nạp tiền ngay
                            </a>
                        </div>
                        <p class="text-[11px] text-rose-600 leading-relaxed">
                            Vui lòng nạp thêm tiền vào ví để hoàn tất giao dịch nâng cấp gói này.
                        </p>
                    </div>

                    <p class="text-[11px] text-muted-foreground flex items-center gap-1.5 pt-1">
                        <i data-lucide="info" class="size-3.5 text-muted-foreground/80 shrink-0"></i>
                        <span>Số tiền sẽ được trừ trực tiếp từ số dư ví PropNest của bạn.</span>
                    </p>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 border-t border-border bg-surface/40 flex items-center justify-end gap-3">
                <button type="button"
                        onclick="closePurchasePackageModal()"
                        class="h-10 px-4 rounded-xl border border-border bg-card text-neutral-700 hover:bg-surface text-xs font-semibold transition-colors cursor-pointer">
                    Hủy bỏ
                </button>
                <button type="button"
                        id="btnConfirmPurchase"
                        onclick="startPurchasePackageWorkflow()"
                        class="h-10 px-5 rounded-xl bg-primary text-white hover:bg-primary-hover text-xs font-bold transition-all shadow-sm flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                    <i data-lucide="credit-card" class="size-4"></i>
                    <span>Xác nhận mua gói</span>
                </button>
            </div>
        </div>

        <!-- ================= 2. VIEW KẾT QUẢ THÀNH CÔNG (HIỂN THỊ NỔI BẬT) ================= -->
        <div id="packageResultSuccessView" class="hidden flex-col p-6 sm:p-8 space-y-6 text-center">
            <div class="size-16 rounded-3xl bg-emerald-500/10 text-emerald-600 mx-auto flex items-center justify-center border border-emerald-500/20 shadow-xs">
                <i data-lucide="check-circle-2" class="size-10"></i>
            </div>

            <div class="space-y-1.5">
                <h3 class="text-xl font-bold text-neutral-900 font-display">Nâng cấp gói thành công!</h3>
                <p class="text-xs text-muted-foreground max-w-sm mx-auto leading-relaxed">
                    Tin đăng <span id="resSuccessListingTitle" class="font-bold text-neutral-800"></span> đã được nâng cấp lên <span id="resSuccessPackageName" class="font-bold text-emerald-700"></span> thành công.
                </p>
            </div>

            <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4 text-xs text-emerald-900 text-left space-y-2">
                <div class="flex items-center gap-2 font-bold text-emerald-800">
                    <i data-lucide="sparkles" class="size-4 text-emerald-600"></i>
                    <span>Quyền lợi đã được kích hoạt:</span>
                </div>
                <ul class="text-muted-foreground text-xs space-y-1 list-disc list-inside leading-relaxed">
                    <li>Gắn huy hiệu gói trên danh sách tin đăng và trang chi tiết.</li>
                    <li>Tự động gia hạn thời gian hiển thị tin theo quyền lợi của gói.</li>
                    <li>Ưu tiên hiển thị tiếp cận khách hàng tiềm năng.</li>
                </ul>
            </div>

            <div class="pt-2">
                <button type="button"
                        onclick="window.location.reload()"
                        class="w-full h-11 rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 text-xs font-bold transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                    <i data-lucide="check" class="size-4"></i>
                    <span>Hoàn tất & Cập nhật danh sách</span>
                </button>
            </div>
        </div>

        <!-- ================= 3. VIEW KẾT QUẢ THẤT BẠI (HIỂN THỊ NỔI BẬT) ================= -->
        <div id="packageResultFailedView" class="hidden flex-col p-6 sm:p-8 space-y-6 text-center">
            <div class="size-16 rounded-3xl bg-rose-500/10 text-rose-600 mx-auto flex items-center justify-center border border-rose-500/20 shadow-xs">
                <i data-lucide="alert-triangle" class="size-10"></i>
            </div>

            <div class="space-y-2">
                <h3 class="text-xl font-bold text-neutral-900 font-display">Giao dịch không thành công</h3>
                <div id="resErrorMessage" class="p-3.5 rounded-2xl border border-rose-200 bg-rose-50 text-rose-700 text-xs font-medium max-w-md mx-auto text-left leading-relaxed">
                    Không thể thực hiện giao dịch nâng cấp gói.
                </div>
            </div>

            <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-4 text-xs text-amber-900 text-left flex items-start gap-3">
                <i data-lucide="shield-check" class="size-5 text-amber-600 shrink-0 mt-0.5"></i>
                <div class="space-y-0.5">
                    <strong class="font-bold text-neutral-900">Bảo vệ số dư ví:</strong>
                    <p class="text-muted-foreground text-xs leading-relaxed">
                        Số dư trong ví của bạn không bị trừ hoặc đã được hoàn trả lại ví 100%.
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="button"
                        onclick="closePurchasePackageModal()"
                        class="flex-1 h-11 rounded-xl border border-border bg-card text-neutral-700 hover:bg-surface text-xs font-semibold transition-colors cursor-pointer">
                    Đóng
                </button>
                <a asp-controller="Wallet" asp-action="Index"
                   class="flex-1 h-11 rounded-xl bg-primary text-white hover:bg-primary-hover text-xs font-bold transition-all shadow-sm flex items-center justify-center gap-2">
                    <i data-lucide="wallet" class="size-4"></i>
                    <span>Nạp tiền vào ví</span>
                </a>
            </div>
        </div>

    </div>
</div>

<!-- ================= JAVASCRIPT LOGIC CHẠY NGẦM & SHOW KẾT QUẢ NỔI BẬT ================= -->
<script>
    let currentListingId = 0;
    let currentListingTitle = '';
    let selectedPackageCode = 'VIP';
    let selectedPackagePrice = 150000;
    let selectedPackageName = 'Gói VIP Đẳng Cấp';
    let selectedPackageDays = 30;
    let currentWalletBalance = 0;
    let isFetchingWallet = false;
    let activeBackgroundTimer = null;

    function formatVndCurrency(amount) {
        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
    }

    async function fetchWalletBalance() {
        if (isFetchingWallet) return;
        isFetchingWallet = true;
        try {
            const res = await fetch('/Properties/GetWalletBalance');
            if (res.ok) {
                const data = await res.json();
                currentWalletBalance = typeof data.totalBalance === 'number' ? data.totalBalance : 0;
            }
        } catch (e) {
            console.error('Không thể lấy số dư ví:', e);
        } finally {
            isFetchingWallet = false;
            updateSummaryUI();
        }
    }

    function openPurchasePackageModal(listingId, listingTitle, currentPackage) {
        currentListingId = listingId;
        currentListingTitle = listingTitle || ('Tin đăng #' + listingId);
        document.getElementById('modalListingId').innerText = listingId;
        document.getElementById('modalListingTitle').innerText = currentListingTitle;
        document.getElementById('modalCurrentPackage').innerText = currentPackage || 'Standard';

        // Đảm bảo reset view về view chọn gói
        document.getElementById('packageSelectView').classList.remove('hidden');
        document.getElementById('packageResultSuccessView').classList.add('hidden');
        document.getElementById('packageResultFailedView').classList.add('hidden');

        // Mặc định chọn gói VIP
        const vipRadio = document.querySelector('input[name="selectedPackageCode"][value="VIP"]');
        if (vipRadio) {
            vipRadio.checked = true;
            selectedPackageCode = 'VIP';
            selectedPackagePrice = 150000;
            selectedPackageName = 'Gói VIP Đẳng Cấp';
            selectedPackageDays = 30;
        }

        // Lấy số dư ví mới nhất từ server
        fetchWalletBalance();

        // Hiển thị modal kèm animation
        openModalDialog();
    }

    function openModalDialog() {
        const modal = document.getElementById('purchasePackageModal');
        const content = document.getElementById('modalContent');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    function closePurchasePackageModal() {
        const modal = document.getElementById('purchasePackageModal');
        const content = document.getElementById('modalContent');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }, 200);
    }

    function onPackageSelected(radio) {
        selectedPackageCode = radio.value;
        selectedPackagePrice = parseFloat(radio.dataset.price) || 0;
        selectedPackageName = radio.dataset.name;
        selectedPackageDays = parseInt(radio.dataset.days, 10) || 30;

        updateSummaryUI();
    }

    function updateSummaryUI() {
        const summaryPackageEl = document.getElementById('summaryPackageName');
        const summaryDurationEl = document.getElementById('summaryDuration');
        const summaryPriceEl = document.getElementById('summaryPrice');
        const currentBalanceEl = document.getElementById('summaryCurrentBalance');
        const remainingBalanceEl = document.getElementById('summaryRemainingBalance');
        const alertEl = document.getElementById('insufficientBalanceAlert');
        const confirmBtn = document.getElementById('btnConfirmPurchase');

        if (summaryPackageEl) summaryPackageEl.innerText = selectedPackageName;
        if (summaryDurationEl) summaryDurationEl.innerText = `${selectedPackageDays} ngày`;
        if (summaryPriceEl) summaryPriceEl.innerText = formatVndCurrency(selectedPackagePrice);

        // Hiển thị số dư ví hiện tại
        if (currentBalanceEl) {
            currentBalanceEl.innerText = formatVndCurrency(currentWalletBalance);
        }

        // Tính số dư sau thanh toán
        const remaining = currentWalletBalance - selectedPackagePrice;

        if (remainingBalanceEl) {
            if (remaining >= 0) {
                remainingBalanceEl.innerText = formatVndCurrency(remaining);
                remainingBalanceEl.className = 'font-bold text-emerald-600';
            } else {
                remainingBalanceEl.innerText = `-${formatVndCurrency(Math.abs(remaining))} (Thiếu tiền)`;
                remainingBalanceEl.className = 'font-bold text-rose-600';
            }
        }

        // Kiểm tra số dư
        if (selectedPackagePrice > 0 && remaining < 0) {
            if (alertEl) alertEl.classList.remove('hidden');
            if (confirmBtn) {
                confirmBtn.classList.add('opacity-50', 'cursor-not-allowed');
                confirmBtn.title = 'Số dư ví không đủ để thanh toán gói này';
            }
        } else {
            if (alertEl) alertEl.classList.add('hidden');
            if (confirmBtn) {
                confirmBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                confirmBtn.title = 'Bấm để thanh toán và nâng cấp gói';
            }
        }

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    // ==========================================
    // KHỞI CHẠY GIAO DỊCH NGẦM & SHOW KẾT QUẢ RÕ RÀNG
    // ==========================================

    async function startPurchasePackageWorkflow() {
        if (!currentListingId || !selectedPackageCode) return;

        // 1. Kiểm tra số dư ví trước khi gửi
        if (selectedPackagePrice > 0 && currentWalletBalance < selectedPackagePrice) {
            if (typeof showSellerToast === 'function') {
                showSellerToast(`Số dư ví (${formatVndCurrency(currentWalletBalance)}) không đủ để thanh toán ${formatVndCurrency(selectedPackagePrice)}. Vui lòng nạp thêm tiền!`, 'error', 5000);
            }
            return;
        }

        const confirmBtn = document.getElementById('btnConfirmPurchase');
        if (confirmBtn) confirmBtn.disabled = true;

        const targetListingId = currentListingId;
        const targetListingTitle = currentListingTitle;
        const targetPackageName = selectedPackageName;

        // Sinh Idempotency-Key chuẩn UUID
        const idempotencyKey = (window.crypto && crypto.randomUUID)
            ? crypto.randomUUID()
            : ('idemp-' + Date.now() + '-' + Math.random().toString(36).substring(2, 9));

        // Đóng modal chọn gói để không bắt user ngồi chờ
        closePurchasePackageModal();

        // Hiển thị toast thông báo tiến trình chạy ngầm
        if (typeof showSellerToast === 'function') {
            showSellerToast(`Đang xử lý nâng cấp ${targetPackageName} cho tin #${targetListingId} chạy ngầm...`, 'loading', 0);
        }

        try {
            const response = await fetch('/Properties/PurchasePackage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    listingId: targetListingId,
                    packageCode: selectedPackageCode,
                    amount: selectedPackagePrice,
                    idempotencyKey: idempotencyKey
                })
            });

            const data = await response.json();

            if (!response.ok || !data.success || !data.correlationId) {
                // Ẩn toast loading
                const toast = document.getElementById('sellerToast');
                if (toast) toast.classList.add('hidden');

                // Bật Modal thông báo thất bại nổi bật lên màn hình
                showFailedResultModal(data.message || 'Không thể bắt đầu tiến trình mua gói. Vui lòng thử lại sau.');
                return;
            }

            // Bắt đầu Polling ngầm theo CorrelationId
            startBackgroundWorkflowPolling(data.correlationId, targetListingId, targetListingTitle, targetPackageName);

        } catch (err) {
            console.error('Lỗi khi gửi yêu cầu mua gói:', err);
            const toast = document.getElementById('sellerToast');
            if (toast) toast.classList.add('hidden');

            showFailedResultModal('Đã xảy ra lỗi kết nối khi gửi yêu cầu. Vui lòng kiểm tra lại mạng.');
        } finally {
            if (confirmBtn) confirmBtn.disabled = false;
        }
    }

    function startBackgroundWorkflowPolling(correlationId, listingId, listingTitle, packageName) {
        if (activeBackgroundTimer) {
            clearInterval(activeBackgroundTimer);
        }

        let attempts = 0;
        const maxAttempts = 60; // Timeout sau ~90 giây

        activeBackgroundTimer = setInterval(async () => {
            attempts++;
            if (attempts > maxAttempts) {
                clearInterval(activeBackgroundTimer);
                activeBackgroundTimer = null;

                const toast = document.getElementById('sellerToast');
                if (toast) toast.classList.add('hidden');

                showFailedResultModal(`Giao dịch cho tin #${listingId} mất nhiều thời gian hơn dự kiến. Vui lòng kiểm tra lại ví hoặc làm mới trang sau.`);
                return;
            }

            try {
                const res = await fetch(`/Properties/WorkflowStatus/${correlationId}`);
                if (!res.ok) {
                    if (res.status === 404) return; // Đang chờ worker ghi db
                    clearInterval(activeBackgroundTimer);
                    activeBackgroundTimer = null;

                    const toast = document.getElementById('sellerToast');
                    if (toast) toast.classList.add('hidden');

                    showFailedResultModal('Không thể kiểm tra trạng thái tiến trình xử lý.');
                    return;
                }

                const workflow = await res.json();

                // VẤN ĐỀ 2: KHI XONG THÌ MỞ MODAL THÔNG BÁO THÀNH CÔNG RÕ RÀNG
                if (workflow.isCompleted || workflow.status === 5) {
                    clearInterval(activeBackgroundTimer);
                    activeBackgroundTimer = null;

                    const toast = document.getElementById('sellerToast');
                    if (toast) toast.classList.add('hidden');

                    showSuccessResultModal(packageName, listingTitle);
                }
                // NẾU THẤT BẠI THÌ MỞ MODAL THÔNG BÁO THẤT BẠI RÕ RÀNG
                else if (workflow.isFailed || workflow.status === 7 || workflow.status === 8) {
                    clearInterval(activeBackgroundTimer);
                    activeBackgroundTimer = null;

                    const toast = document.getElementById('sellerToast');
                    if (toast) toast.classList.add('hidden');

                    const errMsg = workflow.errorMessage || (workflow.status === 7
                        ? 'Giao dịch bồi hoàn: Số dư ví không đủ để thanh toán gói. Tiền đã được hoàn lại ví.'
                        : 'Giao dịch thất bại. Tiền không bị trừ.');

                    showFailedResultModal(errMsg);
                }

            } catch (error) {
                console.error('Lỗi khi polling workflow ngầm:', error);
            }
        }, 1500);
    }

    // Hiển thị Modal Kết quả Thành công nổi bật
    function showSuccessResultModal(packageName, listingTitle) {
        document.getElementById('packageSelectView').classList.add('hidden');
        document.getElementById('packageResultFailedView').classList.add('hidden');
        document.getElementById('packageResultSuccessView').classList.remove('hidden');

        document.getElementById('resSuccessPackageName').innerText = packageName;
        document.getElementById('resSuccessListingTitle').innerText = listingTitle || ('#' + currentListingId);

        openModalDialog();
    }

    // Hiển thị Modal Kết quả Thất bại nổi bật
    function showFailedResultModal(errorMessage) {
        document.getElementById('packageSelectView').classList.add('hidden');
        document.getElementById('packageResultSuccessView').classList.add('hidden');
        document.getElementById('packageResultFailedView').classList.remove('hidden');

        document.getElementById('resErrorMessage').innerText = errorMessage || 'Giao dịch không thành công. Vui lòng thử lại sau.';

        openModalDialog();
    }
</script>
