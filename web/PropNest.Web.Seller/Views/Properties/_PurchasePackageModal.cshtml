<!-- ================= JAVASCRIPT LOGIC POLLING & MODAL (Task 213) ================= -->
<script>
    let currentListingId = 0;
    let selectedPackageCode = 'VIP';
    let selectedPackagePrice = 150000;
    let selectedPackageName = 'Gói VIP Đẳng Cấp';
    let pollIntervalTimer = null;

    function openPurchasePackageModal(listingId, listingTitle, currentPackage) {
        currentListingId = listingId;
        document.getElementById('modalListingId').innerText = listingId;
        document.getElementById('modalListingTitle').innerText = listingTitle || ('Tin đăng #' + listingId);
        document.getElementById('modalCurrentPackage').innerText = currentPackage || 'Standard';

        // Reset về view chọn gói
        document.getElementById('packageSelectView').classList.remove('hidden');
        document.getElementById('packageWorkflowView').classList.add('hidden');
        document.getElementById('packageResultSuccessView').classList.add('hidden');
        document.getElementById('packageResultFailedView').classList.add('hidden');

        // Mặc định chọn gói VIP
        const vipRadio = document.querySelector('input[name="selectedPackageCode"][value="VIP"]');
        if (vipRadio) {
            vipRadio.checked = true;
            onPackageSelected(vipRadio);
        }

        // Hiển thị modal kèm animation
        const modal = document.getElementById('purchasePackageModal');
        const content = document.getElementById('modalContent');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    function closePurchasePackageModal() {
        if (pollIntervalTimer) {
            clearInterval(pollIntervalTimer);
            pollIntervalTimer = null;
        }

        const modal = document.getElementById('purchasePackageModal');
        const content = document.getElementById('modalContent');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }, 200);
    }

    function onPackageSelected(radio) {
        selectedPackageCode = radio.value;
        selectedPackagePrice = parseFloat(radio.dataset.price);
        selectedPackageName = radio.dataset.name;
        const days = radio.dataset.days;

        document.getElementById('summaryPackageName').innerText = selectedPackageName;
        document.getElementById('summaryDuration').innerText = `${days} ngày`;
        document.getElementById('summaryPrice').innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(selectedPackagePrice);
    }

    async function startPurchasePackageWorkflow() {
        if (!currentListingId || !selectedPackageCode) return;

        // Sinh Idempotency-Key chuẩn UUIDv4 chống duplicate charge
        const idempotencyKey = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : ('idemp-' + Date.now() + '-' + Math.random().toString(36).substring(2, 9));

        // Chuyển sang View Step Indicator
        document.getElementById('packageSelectView').classList.add('hidden');
        document.getElementById('packageWorkflowView').classList.remove('hidden');
        resetStepIndicator();

        if (window.lucide) {
            window.lucide.createIcons();
        }

        try {
            // Gửi POST mua gói sang BFF Controller
            const response = await fetch('/Properties/PurchasePackage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    listingId: currentListingId,
                    packageCode: selectedPackageCode,
                    amount: selectedPackagePrice,
                    idempotencyKey: idempotencyKey
                })
            });

            const data = await response.json();

            if (!response.ok || !data.success || !data.correlationId) {
                showFailedResult(data.message || 'Không thể bắt đầu tiến trình mua gói. Vui lòng thử lại.');
                return;
            }

            // Bắt đầu chu kỳ Polling theo CorrelationId (mỗi 1.2s)
            startWorkflowPolling(data.correlationId);

        } catch (err) {
            showFailedResult('Đã xảy ra lỗi kết nối khi gửi yêu cầu. Vui lòng kiểm tra lại mạng.');
        }
    }

    function startWorkflowPolling(correlationId) {
        let attempts = 0;
        const maxAttempts = 60; // Timeout sau ~70 giây

        pollIntervalTimer = setInterval(async () => {
            attempts++;
            if (attempts > maxAttempts) {
                clearInterval(pollIntervalTimer);
                showFailedResult('Quá thời gian chờ phản hồi từ hệ thống. Vui lòng kiểm tra lại lịch sử giao dịch trong ví.');
                return;
            }

            try {
                const res = await fetch(`/Properties/WorkflowStatus/${correlationId}`);
                if (!res.ok) {
                    if (res.status === 404) return; // Đang chờ worker ghi db
                    clearInterval(pollIntervalTimer);
                    showFailedResult('Không thể kiểm tra trạng thái tiến trình xử lý.');
                    return;
                }

                const workflow = await res.json();
                updateStepUI(workflow);

                // Nếu Completed
                if (workflow.isCompleted || workflow.status === 5) {
                    clearInterval(pollIntervalTimer);
                    setTimeout(() => {
                        showSuccessResult();
                    }, 800);
                }
                // Nếu Failed hoặc Compensated
                else if (workflow.isFailed || workflow.status === 7 || workflow.status === 8) {
                    clearInterval(pollIntervalTimer);
                    setTimeout(() => {
                        const errMsg = workflow.errorMessage || (workflow.status === 7 
                            ? 'Giao dịch bồi hoàn: Số dư ví không đủ để thanh toán. Tiền đã được hoàn lại ví.'
                            : 'Giao dịch thất bại. Tiền không bị trừ.');
                        showFailedResult(errMsg);
                    }, 800);
                }

            } catch (error) {
                console.error('Lỗi khi polling workflow:', error);
            }
        }, 1200);
    }

    function resetStepIndicator() {
        updateStepUI({
            status: 0,
            currentStepIndex: 1,
            statusText: 'Đang khởi tạo yêu cầu...'
        });
    }

    function updateStepUI(workflow) {
        const stepIndex = workflow.currentStepIndex || 1;
        const statusText = workflow.statusText || 'Đang xử lý...';

        document.getElementById('workflowStatusText').innerText = statusText;

        // Tính % thanh tiến trình: Step 1 (25%), Step 2 (50%), Step 3 (75%), Step 4 (100%)
        let percent = 25;
        if (stepIndex === 2) percent = 50;
        else if (stepIndex === 3) percent = 75;
        else if (stepIndex >= 4) percent = 100;

        document.getElementById('workflowProgressPercent').innerText = `${percent}%`;
        document.getElementById('workflowProgressBar').style.width = `${percent}%`;

        // Cập nhật từng step icon và highlight
        for (let i = 1; i <= 4; i++) {
            const stepEl = document.getElementById(`sagaStep${i}`);
            const iconEl = stepEl.querySelector('.step-icon');

            if (i < stepIndex || (stepIndex === 4 && workflow.isCompleted)) {
                // Đã xong
                stepEl.className = 'saga-step flex items-start gap-3 p-3 rounded-xl border border-emerald-500/30 bg-emerald-50/30 transition-colors';
                iconEl.className = 'step-icon size-7 rounded-lg bg-emerald-500 text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5';
                iconEl.innerHTML = '<i data-lucide="check" class="size-4"></i>';
            } else if (i === stepIndex) {
                // Đang chạy
                stepEl.className = 'saga-step flex items-start gap-3 p-3 rounded-xl border border-primary/40 bg-surface/80 transition-colors shadow-2xs';
                iconEl.className = 'step-icon size-7 rounded-lg bg-primary text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5';
                iconEl.innerHTML = '<i data-lucide="loader-2" class="size-4 animate-spin"></i>';
            } else {
                // Chưa tới
                stepEl.className = 'saga-step flex items-start gap-3 p-3 rounded-xl border border-border bg-card opacity-50 transition-colors';
                iconEl.className = 'step-icon size-7 rounded-lg bg-surface text-muted-foreground flex items-center justify-center text-xs font-bold shrink-0 mt-0.5';
                iconEl.innerText = i;
            }
        }

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    function showSuccessResult() {
        document.getElementById('packageWorkflowView').classList.add('hidden');
        document.getElementById('packageResultSuccessView').classList.remove('hidden');
        document.getElementById('resSuccessPackageName').innerText = selectedPackageName;

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    function showFailedResult(errorMessage) {
        document.getElementById('packageWorkflowView').classList.add('hidden');
        document.getElementById('packageSelectView').classList.add('hidden');
        document.getElementById('packageResultFailedView').classList.remove('hidden');
        document.getElementById('resErrorMessage').innerText = errorMessage || 'Giao dịch không thành công. Vui lòng thử lại sau.';

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }
</script>
