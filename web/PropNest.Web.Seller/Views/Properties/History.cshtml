@model List<PropNest.Web.Seller.Models.ViewModels.HistoryDeltaViewModel>

@{
    var property = ViewData["Property"] as PropNest.Web.Seller.Models.ViewModels.SellerPropertyItemViewModel;
    ViewData["Title"] = $"Lịch sử thay đổi: PN-{property?.Id}";
}

<div class="mx-auto max-w-5xl px-3 sm:px-6 py-4 md:py-6 space-y-6 pb-20">

    <!-- ================= TOP HEADER & PROPERTY OVERVIEW ================= -->
    <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 shadow-xs space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border/80 pb-4">
            <div class="flex items-center gap-3">
                <a asp-action="Index"
                   class="grid size-9 place-items-center rounded-xl border border-border bg-surface text-neutral-700 hover:border-primary hover:text-primary transition-colors shadow-2xs"
                   title="Quay lại danh sách tin đăng">
                    <i data-lucide="arrow-left" class="size-4"></i>
                </a>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="rounded-md bg-primary/10 text-primary text-[11px] font-bold px-2 py-0.5 tracking-wide uppercase">
                            Audit Trail • DeltaEngine
                        </span>
                        <span class="font-mono text-xs font-bold text-neutral-800">PN-@property?.Id</span>
                        @if (property != null)
                        {
                            <partial name="_StatusBadge" model="property.Status" />
                            @if (property.PackageCode == "VIP")
                            {
                                <span class="rounded-full bg-amber-500 text-white text-[10px] font-bold px-2 py-0.5 shadow-2xs">
                                    VIP
                                </span>
                            }
                        }
                    </div>
                    <h1 class="font-display text-xl sm:text-2xl font-bold text-neutral-900 mt-1">
                        Lịch sử thay đổi tin đăng
                    </h1>
                </div>
            </div>

            <div class="flex items-center gap-2">
                @if (property != null)
                {
                    <a asp-action="Details" asp-route-id="@property.Id"
                       class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-surface px-3 py-2 text-xs font-semibold text-neutral-800 hover:border-primary hover:text-primary transition-colors shadow-2xs">
                        <i data-lucide="eye" class="size-3.5"></i>
                        <span>Xem chi tiết tin</span>
                    </a>
                    <a asp-action="Edit" asp-route-id="@property.Id"
                       class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-surface px-3 py-2 text-xs font-semibold text-neutral-800 hover:border-primary hover:text-primary transition-colors shadow-2xs">
                        <i data-lucide="edit-3" class="size-3.5"></i>
                        <span>Chỉnh sửa</span>
                    </a>
                }
            </div>
        </div>

        @if (property != null)
        {
            <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-muted-foreground pt-1">
                <div class="flex items-center gap-2">
                    <span class="font-semibold text-neutral-900 line-clamp-1 max-w-xl">@property.Title</span>
                </div>
                <div class="flex items-center gap-4">
                    <span>Loại: <strong class="text-neutral-800">@property.PropertyType</strong></span>
                    <span>Hình thức: <strong class="text-neutral-800">@(string.Equals(property.ListingType, "sale", StringComparison.OrdinalIgnoreCase) ? "Cần bán" : "Cho thuê")</strong></span>
                    <span>Giá: <strong class="text-primary font-bold">@property.Price.ToString("N0") ₫</strong></span>
                </div>
            </div>
        }
    </div>

    <!-- ================= TIMELINE TOOLBAR ================= -->
    <div class="flex flex-wrap items-center justify-between gap-4 px-1">
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
            <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Trình tự thời gian: <strong class="text-neutral-800">Chronological (Cũ &rarr; Mới)</strong></span>
            <span class="rounded-full bg-surface px-2.5 py-0.5 font-mono text-[11px] font-semibold text-neutral-700 border border-border">
                @(Model?.Count ?? 0) sự kiện
            </span>
        </div>

        @if (Model != null && Model.Count > 1)
        {
            <button type="button"
                    onclick="toggleTimelineOrder()"
                    id="btnToggleOrder"
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-700 hover:text-primary bg-card border border-border px-3 py-1.5 rounded-xl shadow-2xs transition-colors cursor-pointer">
                <i data-lucide="arrow-down-up" class="size-3.5"></i>
                <span id="orderLabel">Đổi chiều: Mới nhất trước</span>
            </button>
        }
    </div>

    <!-- ================= TIMELINE CONTAINER ================= -->
    <div class="rounded-2xl border border-border bg-card p-5 sm:p-8 shadow-xs">
        @if (Model == null || Model.Count == 0)
        {
            <div class="text-center py-16 space-y-3">
                <div class="size-14 rounded-2xl bg-surface border border-border flex items-center justify-center mx-auto text-muted-foreground/60 shadow-2xs">
                    <i data-lucide="history" class="size-7"></i>
                </div>
                <div class="space-y-1">
                    <p class="font-bold text-base text-neutral-800">Chưa có bản ghi lịch sử nào</p>
                    <p class="text-xs text-muted-foreground max-w-sm mx-auto">
                        Mọi thao tác khởi tạo tin, cập nhật thông tin, gửi duyệt hoặc kiểm duyệt sẽ được tự động ghi vết và so sánh độ lệch (Delta) tại đây.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div id="timelineList" class="relative pl-6 sm:pl-8 space-y-8 flex flex-col before:absolute before:left-[17px] sm:before:left-[21px] before:top-4 before:bottom-4 before:w-0.5 before:bg-border/80">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var h = Model[i];
                    var stepNumber = i + 1;

                    // Bullet & Badge styling based on action type
                    var bulletBg = "bg-primary text-white ring-4 ring-primary/10";
                    var badgeStyle = "bg-primary/10 text-primary border-primary/20";
                    var iconName = "activity";

                    if (h.IsCreate)
                    {
                        bulletBg = "bg-blue-600 text-white ring-4 ring-blue-100";
                        badgeStyle = "bg-blue-50 text-blue-700 border-blue-200";
                        iconName = "plus-circle";
                    }
                    else if (h.IsSubmit)
                    {
                        bulletBg = "bg-indigo-600 text-white ring-4 ring-indigo-100";
                        badgeStyle = "bg-indigo-50 text-indigo-700 border-indigo-200";
                        iconName = "send";
                    }
                    else if (h.IsReject)
                    {
                        bulletBg = "bg-rose-600 text-white ring-4 ring-rose-100";
                        badgeStyle = "bg-rose-50 text-rose-800 border-rose-200";
                        iconName = "x-circle";
                    }
                    else if (h.IsApprove)
                    {
                        bulletBg = "bg-emerald-600 text-white ring-4 ring-emerald-100";
                        badgeStyle = "bg-emerald-50 text-emerald-800 border-emerald-200";
                        iconName = "check-circle-2";
                    }
                    else if (h.IsUpdate)
                    {
                        bulletBg = "bg-amber-500 text-white ring-4 ring-amber-100";
                        badgeStyle = "bg-amber-50 text-amber-800 border-amber-200";
                        iconName = "edit-3";
                    }
                    else if (h.IsUpgrade)
                    {
                        bulletBg = "bg-purple-600 text-white ring-4 ring-purple-100";
                        badgeStyle = "bg-purple-50 text-purple-800 border-purple-200";
                        iconName = "crown";
                    }
                    else if (h.IsHide)
                    {
                        bulletBg = "bg-orange-500 text-white ring-4 ring-orange-100";
                        badgeStyle = "bg-orange-50 text-orange-800 border-orange-200";
                        iconName = "eye-off";
                    }
                    else if (h.IsExpire)
                    {
                        bulletBg = "bg-neutral-500 text-white ring-4 ring-neutral-200";
                        badgeStyle = "bg-neutral-100 text-neutral-700 border-neutral-300";
                        iconName = "clock";
                    }

                    <div class="timeline-item relative group" data-timestamp="@h.ActionDate.ToUnixTimeSeconds()">
                        <!-- Timeline Bullet Node centered on the vertical line -->
                        <div class="absolute -left-[33px] sm:-left-[37px] top-1.5 size-8 sm:size-9 rounded-xl @bulletBg flex items-center justify-center shadow-xs transition-transform group-hover:scale-110 z-10">
                            <i data-lucide="@iconName" class="size-4"></i>
                        </div>

                        <!-- Timeline Card Content -->
                        <div class="flex flex-col gap-3 rounded-2xl border border-border bg-surface/50 p-4 sm:p-5 shadow-2xs hover:border-primary/40 hover:bg-surface transition-all">

                            <!-- Header: Step Index, Action Badge, Actor & Role, Timestamp -->
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border/70 pb-3">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="rounded-md bg-neutral-900 text-white font-mono text-[11px] font-bold px-2 py-0.5 shadow-2xs">
                                        #@stepNumber
                                    </span>
                                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-bold border @badgeStyle">
                                        <i data-lucide="@iconName" class="size-3"></i>
                                        @h.ActionType
                                    </span>
                                    <span class="text-xs font-semibold text-neutral-800 flex items-center gap-1.5 bg-card px-2.5 py-0.5 rounded-lg border border-border shadow-2xs">
                                        <i data-lucide="user" class="size-3 text-muted-foreground"></i>
                                        <span>@h.Actor</span>
                                    </span>
                                </div>

                                <div class="flex items-center gap-1.5 text-xs text-muted-foreground font-mono">
                                    <i data-lucide="calendar" class="size-3.5 text-muted-foreground/80"></i>
                                    <span>@h.ActionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                                </div>
                            </div>

                            <!-- General Note (nếu không phải Reject) -->
                            @if (!h.IsReject && !string.IsNullOrWhiteSpace(h.Note))
                            {
                                <p class="text-xs text-neutral-700 leading-relaxed font-medium">
                                    @h.Note
                                </p>
                            }

                            <!-- ================= 1. REJECT REASON BOX (KẾT QUẢ ĐẠT ĐƯỢC) ================= -->
                            @if (h.IsReject)
                            {
                                <div class="rounded-xl border-2 border-rose-300 bg-rose-50/90 p-4 sm:p-5 text-xs text-rose-950 space-y-3 shadow-2xs">
                                    <div class="flex items-center gap-2.5 font-bold text-rose-900 text-xs sm:text-sm uppercase tracking-wide">
                                        <span class="grid size-6 place-items-center rounded-lg bg-rose-600 text-white shadow-2xs">
                                            <i data-lucide="alert-octagon" class="size-3.5"></i>
                                        </span>
                                        <span>Lý do kiểm duyệt viên từ chối duyệt tin:</span>
                                    </div>

                                    @if (h.RejectReasons != null && h.RejectReasons.Count > 0)
                                    {
                                        <div class="space-y-2 pt-1">
                                            @foreach (var reason in h.RejectReasons)
                                            {
                                                <div class="flex items-start gap-2.5 text-xs text-rose-950 font-medium leading-relaxed bg-white/80 border border-rose-200 rounded-xl p-3 shadow-2xs">
                                                    <i data-lucide="x-circle" class="size-4 shrink-0 text-rose-600 mt-0.5"></i>
                                                    <span class="flex-1">@reason</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(h.Note))
                                    {
                                        <div class="text-xs text-rose-950 font-medium leading-relaxed bg-white/80 border border-rose-200 rounded-xl p-3 shadow-2xs">
                                            @h.Note
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="italic text-rose-800">
                                            Tin đăng chưa đáp ứng tiêu chuẩn kiểm duyệt nội dung của hệ sinh thái PropNest. Vui lòng chỉnh sửa và gửi duyệt lại.
                                        </p>
                                    }
                                </div>
                            }

                            <!-- ================= 2. UPDATE DIFF TABLE BEFORE / AFTER (KẾT QUẢ ĐẠT ĐƯỢC) ================= -->
                            @if (h.IsUpdate)
                            {
                                @if (h.DeltaChanges != null && h.DeltaChanges.Count > 0)
                                {
                                    <div class="space-y-2.5 pt-1">
                                        <div class="flex items-center justify-between text-xs font-semibold text-neutral-800">
                                            <span class="flex items-center gap-2">
                                                <span class="grid size-5 place-items-center rounded-md bg-amber-500/15 text-amber-700">
                                                    <i data-lucide="git-commit" class="size-3.5"></i>
                                                </span>
                                                <span class="font-bold text-neutral-900">Bảng so sánh thay đổi (Before / After):</span>
                                            </span>
                                            <span class="rounded-full bg-amber-50 text-amber-800 border border-amber-200 px-2.5 py-0.5 font-mono text-[11px] font-bold shadow-2xs">
                                                @h.DeltaChanges.Count trường thay đổi
                                            </span>
                                        </div>

                                        <div class="overflow-hidden rounded-xl border border-border bg-card shadow-2xs">
                                            <table class="w-full text-left text-xs border-collapse">
                                                <thead>
                                                    <tr class="border-b border-border bg-surface/80 text-[11px] font-bold text-neutral-700 uppercase tracking-wider">
                                                        <th class="px-4 py-3 w-1/4">Trường thông tin</th>
                                                        <th class="px-4 py-3 w-[37.5%] border-l border-border bg-rose-50/50 text-rose-800">
                                                            <span class="inline-flex items-center gap-1.5 font-bold">
                                                                <i data-lucide="minus" class="size-3.5 text-rose-600 stroke-[3]"></i>
                                                                Giá trị trước (Old / Before)
                                                            </span>
                                                        </th>
                                                        <th class="px-4 py-3 w-[37.5%] border-l border-border bg-emerald-50/50 text-emerald-800">
                                                            <span class="inline-flex items-center gap-1.5 font-bold">
                                                                <i data-lucide="plus" class="size-3.5 text-emerald-600 stroke-[3]"></i>
                                                                Giá trị sau (New / After)
                                                            </span>
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-border/60">
                                                    @foreach (var d in h.DeltaChanges)
                                                    {
                                                        <tr class="hover:bg-surface/40 transition-colors">
                                                            <!-- Field name -->
                                                            <td class="px-4 py-3 align-top font-semibold text-neutral-900">
                                                                <div class="flex items-center gap-2">
                                                                    <span class="size-1.5 rounded-full bg-neutral-400"></span>
                                                                    <span>@d.Field</span>
                                                                </div>
                                                            </td>
                                                            <!-- Old Value (Red Highlight) -->
                                                            <td class="px-4 py-3 align-top border-l border-border/60 bg-rose-50/30">
                                                                <div class="inline-flex items-start gap-2 rounded-lg bg-rose-100/70 border border-rose-200 px-2.5 py-1.5 text-xs text-rose-900 font-mono break-all w-full">
                                                                    <i data-lucide="minus-circle" class="size-3.5 text-rose-600 shrink-0 mt-0.5"></i>
                                                                    <span class="line-through decoration-rose-500/80">@(d.OldValue ?? "(Trống)")</span>
                                                                </div>
                                                            </td>
                                                            <!-- New Value (Green Highlight) -->
                                                            <td class="px-4 py-3 align-top border-l border-border/60 bg-emerald-50/30">
                                                                <div class="inline-flex items-start gap-2 rounded-lg bg-emerald-100/70 border border-emerald-200 px-2.5 py-1.5 text-xs text-emerald-900 font-mono font-semibold break-all w-full">
                                                                    <i data-lucide="plus-circle" class="size-3.5 text-emerald-600 shrink-0 mt-0.5"></i>
                                                                    <span>@(d.NewValue ?? "(Trống)")</span>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-xl border border-dashed border-amber-300 bg-amber-50/50 p-3.5 text-xs text-amber-900 flex items-center gap-2.5">
                                        <i data-lucide="info" class="size-4 text-amber-600 shrink-0"></i>
                                        <span>Bản ghi cập nhật nội dung thành công (không có sự thay đổi giữa các trường thông tin chính yếu).</span>
                                    </div>
                                }
                            }

                            <!-- Special note for Create Event -->
                            @if (h.IsCreate)
                            {
                                <div class="text-xs text-muted-foreground flex items-center gap-1.5 italic pt-1">
                                    <i data-lucide="check" class="size-3.5 text-blue-600"></i>
                                    <span>Khởi tạo bản nháp tin đăng thành công trên hệ sinh thái PropNest.</span>
                                </div>
                            }

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ================= CLIENT JAVASCRIPT: TOGGLE CHRONOLOGICAL ORDER ================= -->
<script>
    let isChronological = true;

    function toggleTimelineOrder() {
        const container = document.getElementById('timelineList');
        if (!container) return;

        const items = Array.from(container.children);
        items.reverse();

        // Clear and re-append in reversed order
        container.innerHTML = '';
        items.forEach(item => container.appendChild(item));

        isChronological = !isChronological;
        const label = document.getElementById('orderLabel');
        if (label) {
            label.innerText = isChronological ? 'Đổi chiều: Mới nhất trước' : 'Đổi chiều: Cũ nhất trước';
        }

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        if (window.lucide) {
            window.lucide.createIcons();
        }
    });
</script>
