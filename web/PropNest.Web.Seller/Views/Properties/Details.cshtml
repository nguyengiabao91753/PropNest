@model PropNest.Web.Seller.Models.ViewModels.SellerPropertyItemViewModel

@{
    ViewData["Title"] = $"Chi tiết: {Model.Id}";
    var histories = ViewData["Histories"] as List<PropNest.Web.Seller.Models.ViewModels.HistoryDeltaViewModel>;
}

<div class="mx-auto max-w-5xl space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <a asp-action="Index" class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-neutral-900 transition-colors mb-2">
                <i data-lucide="arrow-left" class="size-4"></i> Quay lại danh sách
            </a>
            <h1 class="font-display text-2xl font-bold text-neutral-900">@Model.Title</h1>
            <p class="text-xs text-muted-foreground mt-1 flex items-center gap-1">
                <i data-lucide="map-pin" class="size-3.5 text-primary"></i>
                @Model.FullAddress
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="font-mono text-xs font-semibold text-muted-foreground">@Model.Id</span>
            <partial name="_StatusBadge" model="Model.Status" />
            @if (Model.PackageCode == "VIP")
            {
                <span class="rounded bg-amber-500 text-white text-[10px] font-bold px-2 py-0.5">
                    Gói VIP
                </span>
            }
            <a asp-action="Edit" asp-route-id="@Model.Id" class="rounded-xl border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-neutral-800 hover:border-primary transition-colors">
                <i data-lucide="edit-3" class="size-3.5 inline mr-1"></i> Chỉnh sửa
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.RejectReason) && Model.Status == ListingStatus.Rejected)
    {
        <div class="rounded-2xl border border-rose-300 bg-rose-50 p-5 text-xs text-rose-800 space-y-2">
            <div class="flex items-center gap-2 font-bold text-sm text-destructive">
                <i data-lucide="alert-triangle" class="size-5"></i>
                <span>Phản hồi kiểm duyệt: Tin đăng bị từ chối phê duyệt</span>
            </div>
            <p class="leading-relaxed">
                <strong>Lý do từ chối:</strong> @Model.RejectReason
            </p>
            <div class="pt-1">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 font-semibold text-destructive underline hover:text-red-800">
                    Sửa lại tin đăng để gửi duyệt lại <i data-lucide="arrow-right" class="size-3.5"></i>
                </a>
            </div>
        </div>
    }

    <!-- Main Card -->
    <div class="rounded-2xl border border-border bg-card p-6 md:p-8 shadow-xs space-y-6">
        <div class="grid gap-6 md:grid-cols-2">
            <div class="relative aspect-[16/10] w-full rounded-xl overflow-hidden border border-border bg-neutral-100">
                <img src="@Model.PrimaryImage" alt="@Model.Title" class="size-full object-cover" />
                <span class="absolute left-3 top-3 bg-black/75 text-white text-xs px-3 py-1 rounded-full font-medium">
                    @(Model.ListingType == "sale" ? "Cần bán" : "Cho thuê") · @Model.PropertyType
                </span>
            </div>

            <div class="flex flex-col justify-between space-y-4">
                <div>
                    <span class="text-3xl font-extrabold text-primary font-display block">
                        @FormatHelper.FormatPrice(Model.Price, Model.ListingType)
                    </span>
                    <span class="text-xs text-muted-foreground block mt-1">Gói hiển thị: <strong>@Model.PackageCode</strong></span>
                </div>

                <div class="grid grid-cols-3 gap-3 rounded-xl bg-surface p-4 text-center text-xs border border-border/60">
                    <div>
                        <strong class="text-sm block text-neutral-900">@Model.Beds</strong>
                        <span class="text-muted-foreground">Phòng ngủ</span>
                    </div>
                    <div>
                        <strong class="text-sm block text-neutral-900">@Model.Baths</strong>
                        <span class="text-muted-foreground">Phòng tắm</span>
                    </div>
                    <div>
                        <strong class="text-sm block text-neutral-900">@FormatHelper.FormatArea(Model.Area)</strong>
                        <span class="text-muted-foreground">Diện tích</span>
                    </div>
                </div>

                <div class="p-4 rounded-xl border border-border bg-surface/50 text-xs space-y-1.5">
                    <p><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Lượt xem:</strong> @Model.Views | <strong>Khách liên hệ:</strong> @Model.Inquiries</p>
                    <p><strong>RowVersion (Concurrency):</strong> <code class="font-mono text-[11px] bg-neutral-200 px-1.5 py-0.5 rounded">@Model.RowVersion</code></p>
                </div>
            </div>
        </div>

        <div class="border-t border-border pt-4">
            <h4 class="text-xs font-semibold uppercase text-muted-foreground mb-2">Mô tả bất động sản</h4>
            <p class="text-xs text-neutral-800 leading-relaxed bg-surface/50 p-4 rounded-xl border border-border/60">
                @Model.Description
            </p>
        </div>

        <div class="border-t border-border pt-4 flex items-center justify-between">
            <span class="text-xs text-muted-foreground">
                Xem toàn bộ lịch sử các lần sửa đổi giá và nội dung:
            </span>
            <a asp-action="History" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 text-xs text-primary font-semibold hover:underline">
                <i data-lucide="history" class="size-4"></i> Xem lịch sử Delta Engine (F04)
            </a>
        </div>
    </div>
</div>
