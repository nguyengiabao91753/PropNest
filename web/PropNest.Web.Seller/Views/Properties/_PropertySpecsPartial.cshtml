@model PropNest.Web.Seller.Models.InputModels.CreatePropertyInputModel

<!-- Thông số chi tiết bất động sản -->
<div class="rounded-2xl border border-border bg-surface/60 p-4 sm:p-5 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
        <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-800 flex items-center gap-1.5">
            <i data-lucide="sliders-horizontal" class="size-4 text-primary"></i>
            <span>Thông số chi tiết công trình</span>
        </h3>
        <span id="specsHintText" class="text-[11px] text-muted-foreground">
            Tùy chọn (có thể để trống đối với Đất nền)
        </span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5">
        <!-- Số tầng -->
        <div>
            <label asp-for="Floors" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                Số tầng
            </label>
            <div class="flex items-center rounded-xl border border-border bg-white overflow-hidden focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
                <input id="inputFloors" asp-for="Floors" type="number" min="1" max="200" oninput="updateLivePreview()"
                       placeholder="VD: 3"
                       class="w-full bg-transparent p-2.5 text-xs outline-none text-neutral-900 font-mono" />
                <span class="shrink-0 bg-neutral-100 px-2.5 py-2.5 text-[11px] font-semibold text-neutral-600 border-l border-border">Tầng</span>
            </div>
            <span asp-validation-for="Floors" class="text-rose-600 text-[11px] mt-1 block"></span>
        </div>

        <!-- Số phòng ngủ -->
        <div>
            <label asp-for="Bedrooms" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                Số phòng ngủ
            </label>
            <div class="flex items-center rounded-xl border border-border bg-white overflow-hidden focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
                <input id="inputBedrooms" asp-for="Bedrooms" type="number" min="0" max="100" oninput="updateLivePreview()"
                       placeholder="VD: 2"
                       class="w-full bg-transparent p-2.5 text-xs outline-none text-neutral-900 font-mono" />
                <span class="shrink-0 bg-neutral-100 px-2.5 py-2.5 text-[11px] font-semibold text-neutral-600 border-l border-border">PN</span>
            </div>
            <span asp-validation-for="Bedrooms" class="text-rose-600 text-[11px] mt-1 block"></span>
        </div>

        <!-- Số toilet / WC -->
        <div>
            <label asp-for="Bathrooms" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                Số toilet / WC
            </label>
            <div class="flex items-center rounded-xl border border-border bg-white overflow-hidden focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
                <input id="inputBathrooms" asp-for="Bathrooms" type="number" min="0" max="100" oninput="updateLivePreview()"
                       placeholder="VD: 2"
                       class="w-full bg-transparent p-2.5 text-xs outline-none text-neutral-900 font-mono" />
                <span class="shrink-0 bg-neutral-100 px-2.5 py-2.5 text-[11px] font-semibold text-neutral-600 border-l border-border">WC</span>
            </div>
            <span asp-validation-for="Bathrooms" class="text-rose-600 text-[11px] mt-1 block"></span>
        </div>

        <!-- Hướng ban công -->
        <div>
            <label asp-for="BalconyDirection" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                Hướng ban công
            </label>
            <select id="inputBalconyDirection" asp-for="BalconyDirection" onchange="updateLivePreview()"
                    class="w-full rounded-xl border border-border bg-white p-2.5 text-xs outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-neutral-900 font-medium">
                <option value="">-- Chưa chọn --</option>
                <option value="Không có ban công">Không có ban công</option>
                <option value="Đông">Đông</option>
                <option value="Tây">Tây</option>
                <option value="Nam">Nam</option>
                <option value="Bắc">Bắc</option>
                <option value="Đông Nam">Đông Nam</option>
                <option value="Đông Bắc">Đông Bắc</option>
                <option value="Tây Nam">Tây Nam</option>
                <option value="Tây Bắc">Tây Bắc</option>
            </select>
            <span asp-validation-for="BalconyDirection" class="text-rose-600 text-[11px] mt-1 block"></span>
        </div>
    </div>
</div>
