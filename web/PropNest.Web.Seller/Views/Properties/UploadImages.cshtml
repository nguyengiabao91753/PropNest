@model PropNest.Web.Seller.Models.ViewModels.SellerPropertyItemViewModel

@{
    ViewData["Title"] = $"Tải lên hình ảnh - Tin đăng #{Model.Id}";
    ViewData["ActiveNav"] = "Create";
}

<div class="mx-auto max-w-4xl space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border/80 pb-4">
        <div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center rounded-lg bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                    <i data-lucide="check" class="size-3.5 mr-1"></i> Bước 1 đã tạo: Bản nháp
                </span>
                <span class="inline-flex items-center rounded-lg bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">
                    <i data-lucide="image" class="size-3.5 mr-1"></i> Bước 2: Tải lên hình ảnh
                </span>
            </div>
            <h1 class="font-display text-2xl sm:text-3xl font-bold text-neutral-900 mt-2">Thêm Hình Ảnh Cho Tin Đăng</h1>
            <p class="text-xs text-muted-foreground mt-1">
                Tin đăng <span class="font-bold text-neutral-900">#@Model.Id</span> đã được tạo. Hãy bổ sung hình ảnh thực tế để thu hút người mua trước khi gửi duyệt.
            </p>
        </div>
        <a asp-action="Index" asp-route-status="draft" class="inline-flex items-center gap-1.5 text-xs font-medium text-neutral-600 hover:text-neutral-900 transition-colors rounded-xl border border-border bg-card px-3.5 py-2 hover:bg-neutral-50 shadow-xs self-start sm:self-auto">
            <i data-lucide="arrow-left" class="size-4"></i> Về danh sách tin nháp
        </a>
    </div>

    <!-- Tóm tắt thông tin tin vừa tạo -->
    <div class="rounded-2xl border border-border bg-card p-5 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
            <span class="text-[10px] uppercase font-bold text-muted-foreground tracking-wider">Thông tin bất động sản</span>
            <h3 class="font-bold text-sm text-neutral-900 line-clamp-1">@Model.Title</h3>
            <p class="text-xs text-muted-foreground">📍 @Model.Address, @Model.District, @Model.City</p>
        </div>
        <div class="text-left sm:text-right shrink-0">
            <span class="text-xs text-muted-foreground block">Mức giá</span>
            <span class="font-display font-bold text-lg text-primary">
                @FormatHelper.FormatPrice(Model.Price, Model.ListingType)
            </span>
        </div>
    </div>

    <!-- Upload Form -->
    <form asp-action="UploadImages" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="space-y-6">
        @Html.AntiForgeryToken()

        <div class="rounded-2xl border border-border bg-card p-6 md:p-8 shadow-xs space-y-6">
            <div>
                <h2 class="font-bold text-sm text-neutral-900">Chọn hoặc Kéo thả hình ảnh</h2>
                <p class="text-xs text-muted-foreground mt-0.5">
                    Hỗ trợ định dạng .jpg, .jpeg, .png, .webp (Tối đa 10MB/file). Bạn có thể chọn nhiều ảnh cùng lúc.
                </p>
            </div>

            <!-- Drop Zone -->
            <div id="dropZone" class="relative rounded-2xl border-2 border-dashed border-border bg-surface p-8 text-center hover:border-primary/60 transition-colors cursor-pointer group">
                <input type="file" name="files" id="filesInput" multiple accept=".jpg,.jpeg,.png,.webp"
                       class="absolute inset-0 size-full opacity-0 cursor-pointer" />
                <div class="flex flex-col items-center justify-center space-y-3 pointer-events-none">
                    <div class="grid size-14 place-items-center rounded-2xl bg-primary/10 text-primary group-hover:scale-110 transition-transform">
                        <i data-lucide="cloud-upload" class="size-7"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-neutral-800">
                            Kéo thả các hình ảnh vào đây hoặc <span class="text-primary underline">chọn từ thiết bị</span>
                        </p>
                        <p class="text-[11px] text-muted-foreground mt-1">Nên đăng từ 3 đến 6 ảnh chất lượng cao để tăng tỷ lệ liên hệ.</p>
                    </div>
                </div>
            </div>

            <!-- Preview các ảnh vừa chọn -->
            <div id="previewSection" class="hidden space-y-3">
                <div class="flex items-center justify-between border-b border-border/60 pb-2">
                    <span class="text-xs font-bold text-neutral-800">Hình ảnh chuẩn bị tải lên (<span id="selectedCount">0</span> ảnh)</span>
                    <button type="button" onclick="clearSelectedFiles()" class="text-[11px] text-rose-600 hover:underline">Xóa tất cả</button>
                </div>
                <div id="selectedPreviewGrid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3"></div>
            </div>

            <!-- Danh sách ảnh đã có trong tin (nếu có) -->
            @if (Model.Images != null && Model.Images.Count > 0)
            {
                <div class="border-t border-border/60 pt-4 space-y-3">
                    <span class="text-xs font-bold text-neutral-800 block">Hình ảnh hiện có (@Model.Images.Count ảnh)</span>
                    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
                        @foreach (var img in Model.Images)
                        {
                            <div class="relative aspect-square rounded-xl overflow-hidden border border-border bg-neutral-100 shadow-xs">
                                <img src="@img" alt="Property image" class="size-full object-cover" />
                                <span class="absolute bottom-1 left-1 bg-black/60 px-1.5 py-0.5 rounded text-[8px] text-white">Đã lưu</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
            <a asp-action="Index" asp-route-status="draft"
               class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors shadow-xs">
                <span>Bỏ qua bước này (Có thể bổ sung sau)</span>
            </a>

            <div class="flex items-center gap-2">
                <button type="submit" id="btnUploadSubmit"
                        class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-2.5 text-xs font-bold text-white hover:bg-primary-hover shadow-xs transition-colors">
                    <i data-lucide="check-circle" class="size-4"></i>
                    <span>Tải lên & Hoàn tất</span>
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var filesInput = document.getElementById('filesInput');
            var previewSection = document.getElementById('previewSection');
            var grid = document.getElementById('selectedPreviewGrid');
            var selectedCount = document.getElementById('selectedCount');

            if (filesInput) {
                filesInput.addEventListener('change', function () {
                    grid.innerHTML = '';
                    if (!this.files || this.files.length === 0) {
                        previewSection.classList.add('hidden');
                        return;
                    }

                    selectedCount.textContent = this.files.length;
                    previewSection.classList.remove('hidden');

                    Array.from(this.files).forEach(function (file) {
                        if (!file.type.startsWith('image/')) return;
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            var item = document.createElement('div');
                            item.className = 'relative aspect-square rounded-xl overflow-hidden border border-border bg-neutral-100 shadow-xs';
                            item.innerHTML = `
                                <img src="${e.target.result}" class="size-full object-cover" />
                                <div class="absolute inset-x-0 bottom-0 bg-black/60 px-1 py-0.5 text-[8px] text-white truncate text-center">
                                    ${file.name}
                                </div>
                            `;
                            grid.appendChild(item);
                        };
                        reader.readAsDataURL(file);
                    });
                });
            }

            if (window.lucide) lucide.createIcons();
        });

        function clearSelectedFiles() {
            var filesInput = document.getElementById('filesInput');
            if (filesInput) filesInput.value = '';
            document.getElementById('selectedPreviewGrid').innerHTML = '';
            document.getElementById('previewSection').classList.add('hidden');
        }
    </script>
}
