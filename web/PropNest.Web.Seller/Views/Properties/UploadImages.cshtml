@model PropNest.Web.Seller.Models.ViewModels.SellerPropertyItemViewModel
@using System.Text.Json

@{
    var returnTo = ViewData["ReturnTo"]?.ToString();
    var isFromDetails = string.Equals(returnTo, "details", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isFromDetails
        ? $"Quản lý hình ảnh - Tin đăng #{Model.Id}"
        : $"Tải lên hình ảnh - Tin đăng #{Model.Id}";
    ViewData["ActiveNav"] = isFromDetails ? "Properties" : "Create";

    var initialImagesJson = JsonSerializer.Serialize(
        Model.ImageItems.Select(x => new
        {
            imageId = x.ImageId,
            url = x.Url,
            sortOrder = x.SortOrder,
            isCover = x.IsCover
        }));
}

<div class="mx-auto max-w-4xl space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border/80 pb-4">
        <div>
            <div class="flex items-center gap-2">
                @if (!isFromDetails)
                {
                    <span class="inline-flex items-center rounded-lg bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                        <i data-lucide="check" class="size-3.5 mr-1"></i> Bước 1 đã tạo: Bản nháp
                    </span>
                    <span class="inline-flex items-center rounded-lg bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">
                        <i data-lucide="image" class="size-3.5 mr-1"></i> Bước 2: Tải lên & Sắp xếp hình ảnh
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center rounded-lg bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">
                        <i data-lucide="images" class="size-3.5 mr-1"></i> Quản lý hình ảnh
                    </span>
                    <span class="font-mono text-xs font-bold text-neutral-500">#@Model.Id</span>
                }
            </div>
            <h1 class="font-display text-2xl sm:text-3xl font-bold text-neutral-900 mt-2">
                @(isFromDetails ? "Chỉnh Sửa & Sắp Xếp Hình Ảnh" : "Thêm & Sắp Xếp Hình Ảnh Tin Đăng")
            </h1>
            <p class="text-xs text-muted-foreground mt-1">
                Kéo thả ảnh hoặc dùng nút mũi tên để sắp xếp thứ tự hiển thị. Ảnh ở vị trí <strong>#1</strong> sẽ tự động làm <strong>Ảnh bìa</strong> của tin đăng <span class="font-bold text-neutral-900">#@Model.Id</span>.
            </p>
        </div>
        @if (isFromDetails)
        {
            <a asp-action="Details" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 text-xs font-medium text-neutral-600 hover:text-neutral-900 transition-colors rounded-xl border border-border bg-card px-3.5 py-2 hover:bg-neutral-50 shadow-xs self-start sm:self-auto">
                <i data-lucide="arrow-left" class="size-4"></i> Quay lại tin đăng
            </a>
        }
        else
        {
            <a asp-action="Index" asp-route-status="draft" class="inline-flex items-center gap-1.5 text-xs font-medium text-neutral-600 hover:text-neutral-900 transition-colors rounded-xl border border-border bg-card px-3.5 py-2 hover:bg-neutral-50 shadow-xs self-start sm:self-auto">
                <i data-lucide="arrow-left" class="size-4"></i> Về danh sách tin nháp
            </a>
        }
    </div>

    <!-- Tóm tắt thông tin tin vừa tạo -->
    <div class="rounded-2xl border border-border bg-card p-5 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
            <span class="text-[10px] uppercase font-bold text-muted-foreground tracking-wider">Thông tin bất động sản</span>
            <h3 class="font-bold text-sm text-neutral-900 line-clamp-1">@Model.Title</h3>
            <p class="text-xs text-muted-foreground">📍 @Model.FullAddress</p>
        </div>
        <div class="text-left sm:text-right shrink-0">
            <span class="text-xs text-muted-foreground block">Mức giá</span>
            <span class="font-display font-bold text-lg text-primary">
                @FormatHelper.FormatPrice(Model.Price, Model.ListingType)
            </span>
        </div>
    </div>

    <!-- Upload & Reorder Form -->
    <form id="uploadImagesForm" asp-action="UploadImages" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnTo" value="@returnTo" />
        <input type="hidden" name="imageOrderManifest" id="imageOrderManifest" value="[]" />

        <div class="rounded-2xl border border-border bg-card p-6 md:p-8 shadow-xs space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                    <h2 class="font-bold text-sm text-neutral-900">Chọn, Kéo thả & Sắp xếp hình ảnh</h2>
                    <p class="text-xs text-muted-foreground mt-0.5">
                        Hỗ trợ .jpg, .jpeg, .png, .webp (Tối đa 10MB/ảnh, tối đa 15 ảnh). Có thể thêm nhiều đợt mà không mất ảnh đã chọn.
                    </p>
                </div>
                <span class="inline-flex items-center gap-1 rounded-full bg-surface border border-border px-3 py-1 text-xs font-bold text-neutral-800">
                    <i data-lucide="images" class="size-3.5 text-primary"></i>
                    <span id="imageCountBadge">@Model.ImageItems.Count / 15</span>
                </span>
            </div>

            <!-- Inline error message -->
            <div id="imageManagerError" class="hidden rounded-xl border border-rose-200 bg-rose-50 px-3.5 py-2.5 text-xs text-rose-700 font-medium"></div>

            <!-- Drop Zone -->
            <div id="dropZone" class="relative rounded-2xl border-2 border-dashed border-border bg-surface p-8 text-center hover:border-primary/60 transition-colors cursor-pointer group">
                <input type="file" name="files" id="filesInput" multiple accept=".jpg,.jpeg,.png,.webp"
                       class="absolute inset-0 size-full opacity-0 cursor-pointer" />
                <div class="flex flex-col items-center justify-center space-y-3 pointer-events-none">
                    <div class="grid size-14 place-items-center rounded-2xl bg-primary/10 text-primary group-hover:scale-110 transition-transform">
                        <i data-lucide="cloud-upload" class="size-7"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-neutral-800">
                            Kéo thả các hình ảnh vào đây hoặc <span class="text-primary underline">chọn từ thiết bị</span>
                        </p>
                        <p class="text-[11px] text-muted-foreground mt-1">Nên đăng từ 3 đến 6 ảnh sắc nét, kéo ảnh đẹp nhất lên vị trí #1 để làm Ảnh bìa.</p>
                    </div>
                </div>
            </div>

            <!-- Unified Sortable Gallery (Existing + Newly Selected) -->
            <div id="gallerySection" class="@(Model.ImageItems.Count > 0 ? "" : "hidden") space-y-3 pt-2 border-t border-border/60">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2 text-xs">
                        <span class="font-bold text-neutral-800">Thứ tự hiển thị hình ảnh</span>
                        <span class="text-[11px] text-muted-foreground">(Kéo thả ô ảnh hoặc dùng nút ← / → / ★ Bìa)</span>
                    </div>
                    <button type="button" id="clearNewFilesBtn" class="hidden text-[11px] font-semibold text-rose-600 hover:underline">
                        Xóa ảnh mới chọn
                    </button>
                </div>
                <div id="imageGalleryGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3.5"></div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
            @if (isFromDetails)
            {
                <a asp-action="Details" asp-route-id="@Model.Id"
                   class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors shadow-xs">
                    <span>Hủy thay đổi</span>
                </a>
            }
            else
            {
                <a asp-action="Index" asp-route-status="draft"
                   class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors shadow-xs">
                    <span>Bỏ qua bước này (Có thể bổ sung sau)</span>
                </a>
            }

            <div class="flex items-center gap-2">
                <button type="submit" id="btnUploadSubmit"
                        class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-2.5 text-xs font-bold text-white hover:bg-primary-hover shadow-xs transition-colors">
                    <i data-lucide="check-circle" class="size-4"></i>
                    <span>@(isFromDetails ? "Lưu thay đổi hình ảnh" : "Tải lên & Hoàn tất")</span>
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/listing-image-manager.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const initialImages = @Html.Raw(initialImagesJson);

            window.uploadImageManager = window.createListingImageManager({
                formId: 'uploadImagesForm',
                dropZoneId: 'dropZone',
                fileInputId: 'filesInput',
                gridId: 'imageGalleryGrid',
                gallerySectionId: 'gallerySection',
                countId: 'imageCountBadge',
                manifestInputId: 'imageOrderManifest',
                errorBoxId: 'imageManagerError',
                clearNewBtnId: 'clearNewFilesBtn',
                maxImages: 15,
                initialImages: initialImages
            });

            if (window.lucide) lucide.createIcons();
        });
    </script>
}
