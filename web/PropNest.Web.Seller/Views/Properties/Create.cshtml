@model PropNest.Web.Seller.Models.InputModels.CreatePropertyInputModel

@{
    ViewData["Title"] = "Đăng tin bất động sản mới";
}

<div class="mx-auto max-w-6xl space-y-6">
    <!-- Top Stepper Header -->
    <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-border/80 pb-4">
            <div>
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center rounded-lg bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
                        <i data-lucide="layers" class="size-3.5 mr-1"></i> Bước 1: Thông tin tin đăng
                    </span>
                    <span class="inline-flex items-center rounded-lg bg-neutral-100 px-2.5 py-1 text-xs font-medium text-neutral-600">
                        Trạng thái: Bản nháp (Draft)
                    </span>
                </div>
                <h1 class="font-display text-2xl sm:text-3xl font-bold text-neutral-900 mt-2">Đăng Tin Bất Động Sản</h1>
                <p class="text-xs text-muted-foreground mt-1">
                    Nhập thông tin cơ bản của tin đăng. Sau khi hoàn tất bước này, bạn sẽ được chuyển sang bước tải lên hình ảnh.
                </p>
            </div>
            <button type="button" onclick="confirmExit()" class="inline-flex items-center gap-1.5 text-xs font-medium text-neutral-600 hover:text-neutral-900 transition-colors rounded-xl border border-border bg-card px-3.5 py-2 hover:bg-neutral-50 shadow-xs">
                <i data-lucide="arrow-left" class="size-4"></i> Hủy & Quay lại
            </button>
        </div>

        <!-- 3-Step Progress Indicators -->
        <ol class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 pt-1" id="stepperList">
            <li class="step-item active cursor-pointer" onclick="jumpToStep(0)">
                <div class="flex items-center gap-2">
                    <span class="step-number grid size-8 place-items-center rounded-full text-xs font-bold transition-all bg-neutral-900 text-white shadow-xs">01</span>
                    <span class="step-label text-xs font-semibold text-neutral-900">Vị trí & Loại BĐS</span>
                </div>
            </li>
            <li class="text-muted-foreground/40 hidden sm:inline">———</li>
            <li class="step-item cursor-pointer" onclick="jumpToStep(1)">
                <div class="flex items-center gap-2">
                    <span class="step-number grid size-8 place-items-center rounded-full text-xs font-bold transition-all bg-card text-muted-foreground border border-border">02</span>
                    <span class="step-label text-xs font-medium text-muted-foreground">Giá & Diện tích</span>
                </div>
            </li>
            <li class="text-muted-foreground/40 hidden sm:inline">———</li>
            <li class="step-item cursor-pointer" onclick="jumpToStep(2)">
                <div class="flex items-center gap-2">
                    <span class="step-number grid size-8 place-items-center rounded-full text-xs font-bold transition-all bg-card text-muted-foreground border border-border">03</span>
                    <span class="step-label text-xs font-medium text-muted-foreground">Tiêu đề & Mô tả</span>
                </div>
            </li>
        </ol>
    </div>

    <!-- Main Wizard Form & Live Preview Card -->
    <form id="wizardForm" asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="submitAction" id="submitAction" value="upload_images" />

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
            <!-- Left: Wizard Step Containers -->
            <div class="rounded-2xl border border-border bg-card p-6 md:p-8 shadow-xs flex flex-col justify-between min-h-[460px]">
                <div>
                    <!-- BƯỚC 1: VỊ TRÍ HÀNH CHÍNH & LOẠI BĐS -->
                    <div id="step-0" class="wizard-step space-y-6">
                        <div class="border-b border-border/70 pb-3">
                            <h2 class="font-display text-xl font-bold text-neutral-900">01. Vị trí & Loại hình Bất động sản</h2>
                            <p class="text-xs text-muted-foreground mt-1">
                                Cung cấp địa chỉ hành chính chính xác để tin đăng tiếp cận đúng khách hàng.
                            </p>
                        </div>

                        <!-- Loại BĐS -->
                        <div>
                            <label asp-for="PropertyType" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                Loại hình bất động sản <span class="text-rose-600">*</span>
                            </label>
                            <select id="inputPropertyType" asp-for="PropertyType" onchange="updateLivePreview()"
                                    class="w-full rounded-xl border border-border bg-surface p-3 text-xs outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-neutral-900 font-medium">
                                <option value="Apartment">Căn hộ / Chung cư (Apartment)</option>
                                <option value="House">Nhà riêng / Nhà phố (House)</option>
                                <option value="Villa">Biệt thự (Villa)</option>
                                <option value="Townhouse">Nhà liền kề (Townhouse)</option>
                                <option value="Land">Đất nền / Đất thổ cư (Land)</option>
                                <option value="Commercial">Mặt bằng kinh doanh / Văn phòng (Commercial)</option>
                            </select>
                            <span asp-validation-for="PropertyType" class="text-rose-600 text-xs mt-1 block"></span>
                        </div>

                        <!-- Tỉnh / Quận / Phường -->
                        <div class="grid sm:grid-cols-3 gap-3">
                            <div>
                                <label asp-for="City" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                    Tỉnh / Thành phố <span class="text-rose-600">*</span>
                                </label>
                                <input id="inputCity" asp-for="City" oninput="updateLivePreview()"
                                       placeholder="Ví dụ: TP. Hồ Chí Minh"
                                       class="w-full rounded-xl border border-border bg-surface p-2.5 text-xs outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-neutral-900" />
                                <span asp-validation-for="City" class="text-rose-600 text-xs mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="District" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                    Quận / Huyện <span class="text-rose-600">*</span>
                                </label>
                                <input id="inputDistrict" asp-for="District" oninput="updateLivePreview()"
                                       placeholder="Ví dụ: Quận Bình Thạnh"
                                       class="w-full rounded-xl border border-border bg-surface p-2.5 text-xs outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-neutral-900" />
                                <span asp-validation-for="District" class="text-rose-600 text-xs mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="Ward" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                    Phường / Xã
                                </label>
                                <input id="inputWard" asp-for="Ward" oninput="updateLivePreview()"
                                       placeholder="Ví dụ: Phường 22"
                                       class="w-full rounded-xl border border-border bg-surface p-2.5 text-xs outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-neutral-900" />
                                <span asp-validation-for="Ward" class="text-rose-600 text-xs mt-1 block"></span>
                            </div>
                        </div>

                        <!-- Địa chỉ cụ thể -->
                        <div>
                            <label asp-for="Address" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                Tên đường, tòa nhà hoặc số nhà cụ thể <span class="text-rose-600">*</span>
                            </label>
                            <input id="inputAddress" asp-for="Address" oninput="updateLivePreview()"
                                   placeholder="Ví dụ: 208 Nguyễn Hữu Cảnh, Tòa Landmark 81"
                                   class="w-full rounded-xl border border-border bg-surface p-3 text-xs outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-neutral-900" />
                            <span asp-validation-for="Address" class="text-rose-600 text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <!-- BƯỚC 2: HÌNH THỨC, MỨC GIÁ & DIỆN TÍCH -->
                    <div id="step-1" class="wizard-step hidden space-y-6">
                        <div class="border-b border-border/70 pb-3">
                            <h2 class="font-display text-xl font-bold text-neutral-900">02. Hình thức giao dịch & Giá niêm yết</h2>
                            <p class="text-xs text-muted-foreground mt-1">
                                Thiết lập mức giá đề xuất và diện tích sử dụng của bất động sản.
                            </p>
                        </div>

                        <!-- Hình thức giao dịch -->
                        <div>
                            <label class="block text-xs font-semibold text-neutral-800 mb-2">Hình thức giao dịch <span class="text-rose-600">*</span></label>
                            <div class="grid grid-cols-2 gap-3 max-w-md">
                                <label class="flex items-center justify-center p-3 rounded-xl border border-border bg-surface cursor-pointer text-xs font-semibold hover:border-primary transition-colors text-neutral-900" id="btnSale">
                                    <input type="radio" asp-for="ListingType" value="sale" checked class="mr-2 text-primary" onchange="onListingTypeChange('sale')" />
                                    <span>Cần bán (Sale)</span>
                                </label>
                                <label class="flex items-center justify-center p-3 rounded-xl border border-border bg-surface cursor-pointer text-xs font-semibold hover:border-primary transition-colors text-neutral-900" id="btnRent">
                                    <input type="radio" asp-for="ListingType" value="rent" class="mr-2 text-primary" onchange="onListingTypeChange('rent')" />
                                    <span>Cho thuê (Rent)</span>
                                </label>
                            </div>
                            <span asp-validation-for="ListingType" class="text-rose-600 text-xs mt-1 block"></span>
                        </div>

                        <div class="grid sm:grid-cols-2 gap-5">
                            <!-- Giá: Input Add-on Group chống đè chữ -->
                            <div>
                                <label asp-for="Price" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                    Mức giá đề xuất (VNĐ) <span class="text-rose-600">*</span>
                                </label>
                                <div class="flex items-center rounded-xl border border-border bg-surface overflow-hidden focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
                                    <input id="inputPrice" asp-for="Price" type="number" step="1000000" oninput="updateLivePreview()"
                                           placeholder="Ví dụ: 3500000000"
                                           class="w-full bg-transparent p-3 text-xs outline-none text-neutral-900 font-mono" />
                                    <span class="shrink-0 bg-neutral-100/90 px-3.5 py-3 text-xs font-bold text-neutral-600 border-l border-border select-none">VNĐ</span>
                                </div>
                                <span asp-validation-for="Price" class="text-rose-600 text-xs mt-1 block"></span>
                                <span id="priceFormatted" class="text-[11px] text-primary font-bold mt-1.5 block"></span>
                            </div>

                            <!-- Diện tích: Input Add-on Group chống đè chữ -->
                            <div>
                                <label asp-for="Area" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                    Diện tích sử dụng (m²) <span class="text-rose-600">*</span>
                                </label>
                                <div class="flex items-center rounded-xl border border-border bg-surface overflow-hidden focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
                                    <input id="inputArea" asp-for="Area" type="number" step="0.1" oninput="updateLivePreview()"
                                           placeholder="Ví dụ: 75.5"
                                           class="w-full bg-transparent p-3 text-xs outline-none text-neutral-900 font-mono" />
                                    <span class="shrink-0 bg-neutral-100/90 px-3.5 py-3 text-xs font-bold text-neutral-600 border-l border-border select-none">m²</span>
                                </div>
                                <span asp-validation-for="Area" class="text-rose-600 text-xs mt-1 block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- BƯỚC 3: TIÊU ĐỀ & MÔ TẢ RICH TEXT -->
                    <div id="step-2" class="wizard-step hidden space-y-6">
                        <div class="border-b border-border/70 pb-3">
                            <h2 class="font-display text-xl font-bold text-neutral-900">03. Tiêu đề & Mô tả chi tiết</h2>
                            <p class="text-xs text-muted-foreground mt-1">
                                Trình bày điểm mạnh của bất động sản bằng định dạng Rich Text để thu hút người mua.
                            </p>
                        </div>

                        <!-- Tiêu đề -->
                        <div>
                            <label asp-for="Title" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                Tiêu đề bài đăng <span class="text-rose-600">*</span>
                            </label>
                            <input id="inputTitle" asp-for="Title" placeholder="Ví dụ: Căn Hộ Vinhomes Central Park 2PN View Trực Diện Sông Sài Gòn" oninput="updateLivePreview()"
                                   class="w-full rounded-xl border border-border bg-surface p-3 text-xs outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-neutral-900" />
                            <span asp-validation-for="Title" class="text-rose-600 text-xs mt-1 block"></span>
                            <p class="text-[11px] text-muted-foreground mt-1">Tối thiểu 10 ký tự, tối đa 500 ký tự.</p>
                        </div>

                        <!-- Mô tả Rich Text -->
                        <div>
                            <label class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                Mô tả chi tiết (Rich text) <span class="text-rose-600">*</span>
                            </label>
                            <div class="rounded-xl border border-border bg-surface overflow-hidden">
                                <div id="quillToolbar" class="border-b border-border bg-neutral-50 px-2 py-1">
                                    <span class="ql-formats">
                                        <select class="ql-header">
                                            <option value="2">Tiêu đề 2</option>
                                            <option value="3">Tiêu đề 3</option>
                                            <option selected>Bình thường</option>
                                        </select>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-bold"></button>
                                        <button class="ql-italic"></button>
                                        <button class="ql-underline"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-list" value="ordered"></button>
                                        <button class="ql-list" value="bullet"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-clean"></button>
                                    </span>
                                </div>
                                <div id="quillEditor" class="min-h-[140px] p-3 text-xs font-sans text-neutral-900 bg-white">
                                    @Html.Raw(Model.Description)
                                </div>
                            </div>
                            <textarea asp-for="Description" id="hiddenDescription" class="hidden"></textarea>
                            <span asp-validation-for="Description" class="text-rose-600 text-xs mt-1 block"></span>
                            <p class="text-[11px] text-muted-foreground mt-1">Tối thiểu 20 ký tự để khách hàng nắm rõ thông tin.</p>
                        </div>
                    </div>
                </div>

                <!-- Wizard Navigation Footer Buttons -->
                <div class="flex flex-wrap items-center justify-between gap-3 pt-6 mt-6 border-t border-border">
                    <button type="button" id="prevBtn" onclick="moveStep(-1)" disabled
                            class="inline-flex items-center gap-1.5 rounded-xl border border-border px-4 py-2.5 text-xs font-semibold text-muted-foreground hover:bg-surface disabled:opacity-40 transition-colors">
                        <i data-lucide="arrow-left" class="size-4"></i> Quay lại
                    </button>

                    <div class="flex items-center gap-2">
                        <!-- Nút Lưu Bản nháp (Luôn hoạt động độc lập không bị chặn) -->
                        <button type="button" onclick="submitAsDraft()"
                                class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-semibold text-neutral-700 hover:bg-surface shadow-xs transition-colors">
                            <i data-lucide="file-text" class="size-4 text-neutral-500"></i> Lưu bản nháp (Draft)
                        </button>

                        <!-- Nút Tiếp theo (cho Bước 01, 02) -->
                        <button type="button" id="nextBtn" onclick="moveStep(1)"
                                class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-5 py-2.5 text-xs font-bold text-white hover:bg-primary-hover shadow-xs transition-colors">
                            <span>Tiếp theo</span> <i data-lucide="arrow-right" class="size-4"></i>
                        </button>

                        <!-- Nút Hoàn tất thông tin -> Chuyển sang Upload hình ảnh (ở bước cuối) -->
                        <button type="submit" id="finishBtn" class="hidden inline-flex items-center gap-1.5 rounded-xl bg-primary px-6 py-2.5 text-xs font-bold text-white hover:bg-primary-hover shadow-xs transition-colors">
                            <span>Tiếp tục: Thêm hình ảnh</span> <i data-lucide="arrow-right" class="size-4"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right: Live Preview Card -->
            <aside class="space-y-4 lg:sticky lg:top-8 self-start">
                <div class="flex items-center justify-between px-1">
                    <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Xem trước hiển thị</span>
                    <span class="text-[10px] text-emerald-600 bg-emerald-50 border border-emerald-200 rounded-full px-2 py-0.5 font-semibold">Live Preview</span>
                </div>

                <!-- Preview Card Component -->
                <div class="rounded-2xl border border-border bg-card overflow-hidden shadow-sm">
                    <div class="relative aspect-[4/3] w-full overflow-hidden bg-neutral-100 flex items-center justify-center">
                        <div class="flex flex-col items-center justify-center text-neutral-400 gap-1.5">
                            <i data-lucide="image" class="size-8 text-neutral-400"></i>
                            <span class="text-[11px] text-neutral-500 font-medium">Ảnh sẽ được tải ở Bước 2</span>
                        </div>
                        
                        <!-- Listing Type Pill -->
                        <span id="prevTypePill" class="absolute bottom-2.5 right-2.5 bg-black/75 backdrop-blur-xs text-white text-[10px] px-2.5 py-0.5 rounded-full font-medium">
                            Cần bán
                        </span>

                        <!-- Property Type Badge -->
                        <span id="prevPropTypePill" class="absolute top-2.5 left-2.5 bg-white/90 backdrop-blur-xs text-neutral-800 text-[10px] px-2 py-0.5 rounded-lg font-bold shadow-xs">
                            Căn hộ
                        </span>
                    </div>

                    <div class="p-4 space-y-2">
                        <p id="prevPriceDisplay" class="font-display text-xl font-bold text-primary">Chưa thiết lập giá</p>
                        <h3 id="prevTitleDisplay" class="font-semibold text-xs text-neutral-900 line-clamp-2">
                            Tiêu đề bất động sản sẽ hiển thị tại đây...
                        </h3>
                        <p id="prevAddressDisplay" class="text-[11px] text-muted-foreground truncate">
                            📍 Chưa có địa chỉ
                        </p>
                        <div class="flex items-center gap-3 pt-2 border-t border-border/60 text-[11px] text-neutral-700">
                            <span id="prevAreaDisplay">— m²</span>
                            <span>·</span>
                            <span id="prevStatusDisplay" class="text-amber-700 font-semibold bg-amber-50 px-2 py-0.5 rounded-md">Bản nháp</span>
                        </div>
                    </div>
                </div>

                <div class="rounded-xl border border-border bg-surface p-3 text-[11px] text-muted-foreground leading-relaxed">
                    💡 <strong>Quy trình đăng tin:</strong> Nhập thông tin &rarr; Tải ảnh lên &rarr; Gửi duyệt tin. Khi tin được duyệt sẽ nâng cấp gói sau.
                </div>
            </aside>
        </div>
    </form>
</div>

<!-- Modal xác nhận lưu nháp khi muốn thoát -->
<div id="exitConfirmModal" class="fixed inset-0 z-[9999] hidden bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-4 animate-[modalIn_0.2s_ease-out]">
        <div class="flex items-start gap-3">
            <div class="grid size-10 shrink-0 place-items-center rounded-xl bg-amber-100 text-amber-700">
                <i data-lucide="help-circle" class="size-6"></i>
            </div>
            <div>
                <h3 class="font-bold text-sm text-neutral-900">Lưu bản nháp tin đăng?</h3>
                <p class="text-xs text-muted-foreground mt-1 leading-relaxed">
                    Bạn đang soạn thảo tin đăng. Bạn có muốn lưu lại nội dung vào danh sách <strong>Bản nháp (Draft)</strong> để tiếp tục chỉnh sửa sau không?
                </p>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-end gap-2 pt-2 border-t border-border/70">
            <button type="button" onclick="closeExitModal()" class="w-full sm:w-auto px-4 py-2 text-xs font-semibold text-neutral-600 hover:text-neutral-900 rounded-xl hover:bg-neutral-100 transition-colors">
                Ở lại chỉnh sửa
            </button>
            <a asp-action="Index" class="w-full sm:w-auto px-4 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 rounded-xl transition-colors text-center">
                Rời đi không lưu
            </a>
            <button type="button" onclick="submitAsDraft()" class="w-full sm:w-auto px-4 py-2 text-xs font-bold text-white bg-primary hover:bg-primary-hover rounded-xl shadow-xs transition-colors">
                Lưu bản nháp
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Quill.js CDN -->
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>

    <script>
        let currentStep = 0;
        const totalSteps = 3;
        let quill = null;
        let isFormDirty = false;

        function detectInitialStep() {
            // Tự động phát hiện nếu có lỗi server-side validation ở bước nào thì mở đúng bước đó
            for (let i = totalSteps - 1; i >= 0; i--) {
                const stepEl = document.getElementById(`step-${i}`);
                if (!stepEl) continue;
                const errSpans = stepEl.querySelectorAll('.field-validation-error');
                for (let span of errSpans) {
                    if (span.textContent && span.textContent.trim().length > 0) {
                        return i;
                    }
                }
            }
            return 0;
        }

        document.addEventListener('DOMContentLoaded', function () {
            // 1. Khởi tạo Quill Editor
            quill = new Quill('#quillEditor', {
                modules: { toolbar: '#quillToolbar' },
                theme: 'snow',
                placeholder: 'Nhập mô tả chi tiết vị trí, tiện ích, pháp lý và hướng nhà...'
            });

            var hiddenDesc = document.getElementById('hiddenDescription');
            if (hiddenDesc && hiddenDesc.value) {
                quill.root.innerHTML = hiddenDesc.value;
            }

            quill.on('text-change', function () {
                var html = quill.root.innerHTML;
                hiddenDesc.value = (quill.getText().trim().length === 0) ? '' : html;
                isFormDirty = true;
                unmarkError(hiddenDesc);
            });

            // Lắng nghe thay đổi form để kích hoạt Dirty State và tự động xóa lỗi
            document.querySelectorAll('#wizardForm input, #wizardForm select').forEach(function (el) {
                el.addEventListener('input', function () {
                    isFormDirty = true;
                    unmarkError(el);
                });
                el.addEventListener('change', function () {
                    isFormDirty = true;
                    unmarkError(el);
                });
            });

            updateLivePreview();
            currentStep = detectInitialStep();
            renderStep();

            if (window.lucide) {
                lucide.createIcons();
            }
        });

        // 2. Quản lý Stepper Navigation
        function jumpToStep(target) {
            if (target < 0 || target >= totalSteps) return;

            if (target > currentStep) {
                // Kiểm tra tất cả các bước trước khi cho phép tiến tới
                for (let s = currentStep; s < target; s++) {
                    if (!validateStep(s)) {
                        currentStep = s;
                        renderStep();
                        return;
                    }
                }
            }

            currentStep = target;
            renderStep();
        }

        function moveStep(delta) {
            jumpToStep(currentStep + delta);
        }

        function renderStep() {
            for (let i = 0; i < totalSteps; i++) {
                const el = document.getElementById(`step-${i}`);
                if (el) {
                    if (i === currentStep) el.classList.remove('hidden');
                    else el.classList.add('hidden');
                }
            }

            // Cập nhật Stepper Header UI
            const stepItems = document.querySelectorAll('#stepperList .step-item');
            stepItems.forEach((item, idx) => {
                const num = item.querySelector('.step-number');
                const lbl = item.querySelector('.step-label');

                if (idx === currentStep) {
                    num.className = 'step-number grid size-8 place-items-center rounded-full text-xs font-bold transition-all bg-neutral-900 text-white shadow-xs';
                    lbl.className = 'step-label text-xs font-semibold text-neutral-900';
                } else if (idx < currentStep) {
                    num.className = 'step-number grid size-8 place-items-center rounded-full text-xs font-bold transition-all bg-emerald-500 text-white shadow-xs';
                    num.innerHTML = '✓';
                    lbl.className = 'step-label text-xs font-semibold text-emerald-800';
                } else {
                    num.className = 'step-number grid size-8 place-items-center rounded-full text-xs font-bold transition-all bg-card text-muted-foreground border border-border';
                    num.innerHTML = `0${idx + 1}`;
                    lbl.className = 'step-label text-xs font-medium text-muted-foreground';
                }
            });

            // Cập nhật Buttons
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const finishBtn = document.getElementById('finishBtn');

            prevBtn.disabled = (currentStep === 0);

            if (currentStep === totalSteps - 1) {
                nextBtn.classList.add('hidden');
                finishBtn.classList.remove('hidden');
            } else {
                nextBtn.classList.remove('hidden');
                finishBtn.classList.add('hidden');
            }

            if (window.lucide) lucide.createIcons();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 3. Client-side Validation cho từng bước
        function getInputElementForError(el) {
            if (!el) return null;
            const addonContainer = el.closest('.focus-within\\:border-primary');
            if (addonContainer) return addonContainer;
            if (el.id === 'hiddenDescription') {
                return document.getElementById('quillToolbar')?.parentElement || el;
            }
            return el;
        }

        function markError(el, msg) {
            if (!el) return;
            const targetEl = getInputElementForError(el);
            if (targetEl) {
                targetEl.classList.add('!border-rose-500', '!ring-1', '!ring-rose-500/30');
            }

            const fieldName = el.name || el.getAttribute('name') || el.id;
            const span = document.querySelector(`[data-valmsg-for="${fieldName}"]`);
            if (span) {
                span.textContent = msg;
                span.classList.remove('hidden');
            }
        }

        function unmarkError(el) {
            if (!el) return;
            const targetEl = getInputElementForError(el);
            if (targetEl) {
                targetEl.classList.remove('!border-rose-500', '!ring-1', '!ring-rose-500/30');
            }

            const fieldName = el.name || el.getAttribute('name') || el.id;
            const span = document.querySelector(`[data-valmsg-for="${fieldName}"]`);
            if (span) {
                span.textContent = '';
            }
        }

        function validateStep(step) {
            let isValid = true;

            if (step === 0) {
                const city = document.getElementById('inputCity');
                const district = document.getElementById('inputDistrict');
                const address = document.getElementById('inputAddress');

                if (!city.value.trim()) { markError(city, 'Vui lòng nhập Tỉnh / Thành phố.'); isValid = false; } else unmarkError(city);
                if (!district.value.trim()) { markError(district, 'Vui lòng nhập Quận / Huyện.'); isValid = false; } else unmarkError(district);
                if (!address.value.trim()) { markError(address, 'Vui lòng nhập Địa chỉ chi tiết.'); isValid = false; } else unmarkError(address);
            } else if (step === 1) {
                const price = document.getElementById('inputPrice');
                const area = document.getElementById('inputArea');

                if (!price.value || isNaN(parseFloat(price.value)) || parseFloat(price.value) < 0) {
                    markError(price, 'Mức giá không hợp lệ (phải >= 0).'); isValid = false;
                } else unmarkError(price);

                if (!area.value || isNaN(parseFloat(area.value)) || parseFloat(area.value) <= 0) {
                    markError(area, 'Diện tích phải lớn hơn 0 m².'); isValid = false;
                } else unmarkError(area);
            } else if (step === 2) {
                const title = document.getElementById('inputTitle');
                const hiddenDesc = document.getElementById('hiddenDescription');
                const textContent = quill ? quill.getText().trim() : '';

                if (!title.value.trim() || title.value.trim().length < 10) {
                    markError(title, 'Tiêu đề phải từ 10 đến 500 ký tự.'); isValid = false;
                } else unmarkError(title);

                if (textContent.length < 20) {
                    markError(hiddenDesc, 'Mô tả cần có ít nhất 20 ký tự.'); isValid = false;
                } else unmarkError(hiddenDesc);
            }

            return isValid;
        }

        // 4. Cập nhật Live Preview thời gian thực
        function updateLivePreview() {
            const title = document.getElementById('inputTitle')?.value || 'Tiêu đề bất động sản sẽ hiển thị tại đây...';
            const priceVal = document.getElementById('inputPrice')?.value;
            const price = parseFloat(priceVal || 0);
            const areaVal = document.getElementById('inputArea')?.value;
            const area = parseFloat(areaVal || 0);
            const city = document.getElementById('inputCity')?.value || '';
            const district = document.getElementById('inputDistrict')?.value || '';
            const ward = document.getElementById('inputWard')?.value || '';
            const address = document.getElementById('inputAddress')?.value || '';
            const propType = document.getElementById('inputPropertyType')?.value || 'Apartment';
            const listingType = document.querySelector('input[name="ListingType"]:checked')?.value || 'sale';

            document.getElementById('prevTitleDisplay').textContent = title;
            document.getElementById('prevAreaDisplay').textContent = (area > 0) ? `${area} m²` : '— m²';

            const fullAddr = [address, ward, district, city].filter(Boolean).join(', ');
            document.getElementById('prevAddressDisplay').textContent = fullAddr ? `📍 ${fullAddr}` : '📍 Chưa có địa chỉ';

            let priceText = '';
            if (!priceVal || price <= 0) {
                priceText = 'Chưa thiết lập giá';
                document.getElementById('prevPriceDisplay').textContent = priceText;
                const priceFormatted = document.getElementById('priceFormatted');
                if (priceFormatted) priceFormatted.textContent = '';
            } else {
                if (price >= 1000000000) {
                    priceText = (price / 1000000000).toFixed(2).replace('.00', '') + ' tỷ VNĐ';
                } else if (price >= 1000000) {
                    priceText = (price / 1000000).toFixed(1).replace('.0', '') + ' triệu VNĐ';
                } else {
                    priceText = price.toLocaleString('vi-VN') + ' VNĐ';
                }
                if (listingType === 'rent') priceText += '/tháng';

                document.getElementById('prevPriceDisplay').textContent = priceText;
                const priceFormatted = document.getElementById('priceFormatted');
                if (priceFormatted) priceFormatted.textContent = `≈ ${priceText}`;
            }

            document.getElementById('prevTypePill').textContent = (listingType === 'sale') ? 'Cần bán' : 'Cho thuê';
            
            const propTypeLabels = {
                'Apartment': 'Căn hộ',
                'House': 'Nhà phố',
                'Villa': 'Biệt thự',
                'Townhouse': 'Nhà liền kề',
                'Land': 'Đất nền',
                'Commercial': 'Mặt bằng'
            };
            document.getElementById('prevPropTypePill').textContent = propTypeLabels[propType] || propType;
        }

        function onListingTypeChange(type) {
            updateLivePreview();
        }

        // 5. Submit Draft trực tiếp
        function submitAsDraft() {
            if (quill) {
                var text = quill.getText().trim();
                document.getElementById('hiddenDescription').value = (text.length === 0) ? '' : quill.root.innerHTML;
            }
            document.getElementById('submitAction').value = 'save_draft';
            document.getElementById('wizardForm').submit();
        }

        // 6. Xử lý Modal Xác nhận khi thoát
        function confirmExit() {
            if (isFormDirty) {
                document.getElementById('exitConfirmModal').classList.remove('hidden');
            } else {
                window.location.href = '@Url.Action("Index", "Properties")';
            }
        }

        function closeExitModal() {
            document.getElementById('exitConfirmModal').classList.add('hidden');
        }

        // Submit form chính: validate tất cả các bước trước khi gửi lên server
        document.getElementById('wizardForm').addEventListener('submit', function (e) {
            const action = document.getElementById('submitAction').value;

            if (quill) {
                var text = quill.getText().trim();
                document.getElementById('hiddenDescription').value = (text.length === 0) ? '' : quill.root.innerHTML;
            }

            // Nếu người dùng chọn Lưu bản nháp (Draft) thì gửi form ngay mà không chặn
            if (action === 'save_draft') {
                return true;
            }

            // Kiểm tra tuần tự từng bước từ bước 0 đến bước cuối
            for (let step = 0; step < totalSteps; step++) {
                if (!validateStep(step)) {
                    e.preventDefault();
                    e.stopPropagation();
                    jumpToStep(step);
                    const stepEl = document.getElementById(`step-${step}`);
                    const firstError = stepEl?.querySelector('.!border-rose-500, input:invalid');
                    if (firstError) {
                        firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        if (typeof firstError.focus === 'function') firstError.focus();
                    }
                    return false;
                }
            }
        });
    </script>
}
