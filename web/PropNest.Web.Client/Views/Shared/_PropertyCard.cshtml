@model PropNest.Web.Client.Models.ViewModels.ClientPropertyItemViewModel

<article class="group rounded-2xl border border-border bg-card p-3.5 transition-all duration-300 hover:shadow-lg hover:border-primary/50 flex flex-col justify-between">
    <div>
        <!-- Thumbnail Image & Badges -->
        <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.Id"
           class="block relative aspect-[4/3] overflow-hidden rounded-xl bg-neutral-100">
            <img src="@Model.PrimaryImageUrl" alt="@Model.Title"
                 class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />

            <!-- Badge PackageCode (VIP / Boost) -->
            @if (Model.PackageCode == "VIP")
            {
                <span class="absolute left-3 top-3 rounded-full bg-amber-500 text-white font-bold px-2.5 py-0.5 text-[10px] shadow-xs">
                    VIP Nổi Bật
                </span>
            }
            else if (Model.PackageCode == "Boost")
            {
                <span class="absolute left-3 top-3 rounded-full bg-purple-600 text-white font-bold px-2.5 py-0.5 text-[10px] shadow-xs">
                    Ưu Tiên Đẩy Tin
                </span>
            }

            <!-- Hình thức: Bán hoặc Cho thuê -->
            <span class="absolute left-3 bottom-3 rounded-full bg-black/75 text-white px-2.5 py-0.5 text-[10px] font-medium backdrop-blur-xs">
                @(string.Equals(Model.ListingType, "rent", StringComparison.OrdinalIgnoreCase) ? "Cho thuê" : "Cần bán")
            </span>
        </a>

        <!-- Tiêu đề, Vị trí & Giá -->
        <div class="mt-3.5 flex items-start justify-between gap-2.5 px-1">
            <div class="min-w-0">
                <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.Id"
                   class="line-clamp-2 text-sm font-semibold text-neutral-900 group-hover:text-primary transition-colors" title="@Model.Title">
                    @Model.Title
                </a>
                <p class="mt-1 truncate text-xs text-muted-foreground flex items-center gap-1">
                    <i data-lucide="map-pin" class="size-3 text-primary shrink-0"></i>
                    <span class="truncate">@Model.FormattedLocation</span>
                </p>
            </div>
            <p class="shrink-0 font-bold text-primary text-sm font-display whitespace-nowrap">
                @FormatHelper.FormatCompactPrice(Model.Price, Model.ListingType)
            </p>
        </div>
    </div>

    <!-- Thông số nhanh & Nút xem chi tiết -->
    <div class="mt-3.5 pt-3 border-t border-border/60 flex items-center justify-between gap-2 px-1 text-xs">
        <div class="flex items-center gap-2.5 text-muted-foreground font-medium truncate">
            <span class="inline-flex items-center gap-1">
                <i data-lucide="maximize-2" class="size-3 text-primary/80"></i>
                @FormatHelper.FormatArea(Model.Area)
            </span>
            @if (Model.Bedrooms.HasValue && Model.Bedrooms.Value > 0)
            {
                <span class="inline-flex items-center gap-1">
                    <i data-lucide="bed-double" class="size-3"></i>
                    @Model.Bedrooms PN
                </span>
            }
        </div>
        <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.Id"
           class="shrink-0 inline-flex items-center gap-1 rounded-full border border-border bg-surface px-3 py-1 font-semibold text-neutral-800 transition-colors hover:border-primary hover:bg-primary hover:text-white">
            <span>Chi tiết</span>
            <i data-lucide="arrow-up-right" class="size-3.5"></i>
        </a>
    </div>
</article>
