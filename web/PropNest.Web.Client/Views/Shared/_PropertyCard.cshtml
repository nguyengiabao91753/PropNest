@model PropNest.Web.Client.Models.ViewModels.ClientPropertyItemViewModel

<article class="group rounded-2xl border border-border bg-card p-3.5 transition-all duration-300 hover:shadow-lg hover:border-primary/50 flex flex-col justify-between">
    <div>
        <div class="relative aspect-[4/3] overflow-hidden rounded-xl bg-neutral-100">
            <img src="@Model.PrimaryImage" alt="@Model.Title"
                 class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />

            <!-- VIP Badge -->
            @if (Model.PackageCode == "VIP" || Model.Featured)
            {
                <span class="absolute left-3 top-3 rounded-full bg-amber-500 text-white font-bold px-2.5 py-0.5 text-[10px] shadow-xs">
                    @(string.IsNullOrWhiteSpace(Model.Banner) ? "VIP Nổi Bật" : Model.Banner)
                </span>
            }

            <span class="absolute left-3 bottom-3 rounded-full bg-black/75 text-white px-2.5 py-0.5 text-[10px] font-medium backdrop-blur-xs">
                @(Model.ListingType == "rent" ? "Cho thuê" : "Cần bán")
            </span>

            <!-- Favorite Heart Button -->
            <button type="button"
                    data-fav-id="@Model.Id"
                    onclick="toggleFavorite('@Model.Id')"
                    aria-label="Lưu bất động sản"
                    class="absolute right-3 top-3 grid size-8 place-items-center rounded-full bg-card/90 backdrop-blur-xs transition-colors hover:text-primary text-muted-foreground shadow-xs">
                <i data-lucide="heart" class="size-4"></i>
            </button>
        </div>

        <div class="mt-4 flex items-start justify-between gap-3 px-1">
            <div class="min-w-0">
                <h3 class="line-clamp-2 text-sm font-semibold text-neutral-900 group-hover:text-primary transition-colors" title="@Model.Title">
                    @Model.Title
                    @if (Model.Beds > 0)
                    {
                        <span class="text-muted-foreground font-normal"> · @Model.Beds PN</span>
                    }
                </h3>
                <p class="mt-1 truncate text-xs text-muted-foreground">
                    📍 @Model.FormattedLocation
                </p>
            </div>
            <p class="shrink-0 font-bold text-primary text-sm font-display whitespace-nowrap">
                @FormatHelper.FormatCompactPrice(Model.Price, Model.ListingType)
            </p>
        </div>
    </div>

    <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between px-1 text-xs">
        <span class="text-muted-foreground">
            @FormatHelper.FormatArea(Model.Area) · @Model.Baths WC
        </span>
        <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.Id"
           class="inline-flex items-center gap-1 rounded-full border border-border bg-surface px-3 py-1 font-semibold text-neutral-800 transition-colors hover:border-primary hover:bg-primary hover:text-white">
            <span>Chi tiết</span>
            <i data-lucide="arrow-up-right" class="size-3.5"></i>
        </a>
    </div>
</article>
