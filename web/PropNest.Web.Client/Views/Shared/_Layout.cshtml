@{
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
}

<!DOCTYPE html>
<html lang="vi" data-scroll-behavior="smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Khám phá Bất động sản") — PropNest</title>

    <!-- Google Fonts: Be Vietnam Pro & Playfair Display with full Vietnamese Unicode subset -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&display=swap&subset=vietnamese" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#fff8e3',
                        surface: '#fdf9eb',
                        card: '#ffffff',
                        primary: {
                            DEFAULT: '#d7730c',
                            foreground: '#ffffff',
                            hover: '#b85e07'
                        },
                        'brand-soft': '#fbe6cc',
                        destructive: {
                            DEFAULT: '#d23b2f',
                            foreground: '#ffffff'
                        },
                        border: '#e8e3d5',
                        muted: {
                            DEFAULT: '#f6eed3',
                            foreground: '#5f5a4f'
                        }
                    },
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                        display: ['"Playfair Display"', 'Georgia', 'Cambria', 'serif']
                    }
                }
            }
        }
    </script>

    <!-- Theme Custom Styles -->
    <link rel="stylesheet" href="~/css/client.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-surface text-neutral-900 antialiased font-sans flex flex-col justify-between">
    <!-- Top Sticky Header -->
    <header class="sticky top-0 z-40 w-full border-b border-border bg-card/90 backdrop-blur-md">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
            <!-- Left: Logo & Navigation Links -->
            <div class="flex items-center gap-8">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                    <div class="grid size-9 place-items-center rounded-xl bg-primary text-white shadow-xs font-bold text-lg font-display">
                        PN
                    </div>
                    <span class="font-display text-xl font-bold tracking-tight text-neutral-900 leading-none">PropNest</span>
                </a>

                <nav class="hidden items-center gap-6 md:flex" aria-label="Customer Navigation">
                    <a asp-controller="Home" asp-action="Index"
                       class="relative py-1 text-sm font-medium transition-colors hover:text-primary @(currentPath == "" || currentPath == "/" ? "text-primary font-semibold after:absolute after:inset-x-0 after:-bottom-1.5 after:h-0.5 after:bg-primary" : "text-muted-foreground")">
                        Trang chủ
                    </a>
                    <a asp-controller="Listings" asp-action="Index"
                       class="relative py-1 text-sm font-medium transition-colors hover:text-primary @(currentPath.StartsWith("/listings") ? "text-primary font-semibold after:absolute after:inset-x-0 after:-bottom-1.5 after:h-0.5 after:bg-primary" : "text-muted-foreground")">
                        Khám phá BĐS
                    </a>

                    <!-- Category Dropdown -->
                    <div class="relative">
                        <button id="categoryDropdownBtn" type="button" onclick="toggleCategoryDropdown()"
                                class="flex items-center gap-1.5 py-1 text-sm outline-none transition-colors text-muted-foreground hover:text-primary font-medium">
                            <span>Danh mục</span>
                            <i data-lucide="chevron-down" class="size-4"></i>
                        </button>
                        <div id="categoryDropdownMenu" class="absolute left-0 mt-2 w-52 hidden rounded-xl border border-border bg-card p-1.5 shadow-lg z-50">
                            <a asp-controller="Listings" asp-action="Index" asp-route-type="sale" class="block px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface hover:text-primary transition-colors">
                                BĐS Cần bán (For Sale)
                            </a>
                            <a asp-controller="Listings" asp-action="Index" asp-route-type="rent" class="block px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface hover:text-primary transition-colors">
                                BĐS Cho thuê (For Rent)
                            </a>
                            <div class="border-t border-border/60 my-1"></div>
                            <a asp-controller="Listings" asp-action="Index" asp-route-homeType="Villa" class="block px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface hover:text-primary transition-colors">
                                Biệt thự (Villa)
                            </a>
                            <a asp-controller="Listings" asp-action="Index" asp-route-homeType="Apartment" class="block px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface hover:text-primary transition-colors">
                                Căn hộ chung cư
                            </a>
                            <a asp-controller="Listings" asp-action="Index" asp-route-homeType="House" class="block px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface hover:text-primary transition-colors">
                                Nhà riêng / Nhà phố
                            </a>
                        </div>
                    </div>

                    <a href="/#about" class="text-sm font-medium text-muted-foreground transition-colors hover:text-primary">
                        Về PropNest
                    </a>
                </nav>
            </div>

            <!-- Right: Portal Switchers & Account -->
            <div class="flex items-center gap-3">
                <!-- Portal Switchers -->
                <a href="https://localhost:7006/"
                   class="hidden md:inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-neutral-900 border border-border rounded-full px-3.5 py-1.5 hover:bg-surface transition-colors">
                    <i data-lucide="store" class="size-3.5 text-primary"></i> Kênh Người bán
                </a>
                <a href="https://localhost:7215/"
                   class="hidden md:inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-neutral-900 border border-border rounded-full px-3.5 py-1.5 hover:bg-surface transition-colors">
                    <i data-lucide="layout-dashboard" class="size-3.5 text-destructive"></i> Kênh Quản trị
                </a>

                <!-- Saved Favorites Button -->
                <a asp-controller="Listings" asp-action="Index" asp-route-savedOnly="true"
                   class="relative grid size-9 place-items-center rounded-full border border-border bg-card text-muted-foreground hover:text-primary transition-colors"
                   title="Bất động sản đã lưu">
                    <i data-lucide="heart" class="size-4"></i>
                    <span id="favCountBadge" class="absolute -top-1 -right-1 hidden size-4 rounded-full bg-primary text-[10px] font-bold text-white grid place-items-center">
                        0
                    </span>
                </a>

                <!-- Auth links -->
                <a asp-controller="Auth" asp-action="Login" class="text-xs font-semibold text-muted-foreground hover:text-primary px-3 py-1.5">
                    Đăng nhập
                </a>
                <a asp-controller="Auth" asp-action="Signup"
                   class="hidden sm:inline-flex items-center rounded-full bg-primary px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-primary-hover transition-colors">
                    Đăng ký
                </a>

                <!-- Mobile menu button -->
                <button type="button" onclick="toggleMobileMenu()" class="grid size-9 place-items-center rounded-lg border border-border md:hidden" aria-label="Mở menu điều hướng">
                    <i data-lucide="menu" class="size-5"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Drawer Sheet -->
    <div id="mobileMenuSheet" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs">
        <div class="fixed inset-y-0 left-0 w-72 bg-surface p-6 shadow-xl flex flex-col justify-between">
            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2">
                        <div class="grid size-8 place-items-center rounded-xl bg-primary text-white font-bold font-display">PN</div>
                        <span class="font-display text-lg font-bold">PropNest</span>
                    </a>
                    <button type="button" onclick="toggleMobileMenu()" class="text-muted-foreground hover:text-neutral-900">
                        <i data-lucide="x" class="size-5"></i>
                    </button>
                </div>

                <nav class="flex flex-col gap-3 text-sm font-medium">
                    <a asp-controller="Home" asp-action="Index" class="py-1 hover:text-primary">Trang chủ</a>
                    <a asp-controller="Listings" asp-action="Index" class="py-1 hover:text-primary">Khám phá BĐS</a>
                    <a asp-controller="Listings" asp-action="Index" asp-route-type="sale" class="py-1 text-muted-foreground hover:text-primary">BĐS Cần bán</a>
                    <a asp-controller="Listings" asp-action="Index" asp-route-type="rent" class="py-1 text-muted-foreground hover:text-primary">BĐS Cho thuê</a>
                    <a href="/#about" class="py-1 text-muted-foreground hover:text-primary">Về PropNest</a>
                </nav>

                <div class="border-t border-border pt-4 space-y-2 text-xs">
                    <a href="https://localhost:7006/" class="block font-semibold text-primary py-1">
                        👉 Cổng Người bán (Seller Portal)
                    </a>
                    <a href="https://localhost:7215/" class="block font-semibold text-destructive py-1">
                        👉 Cổng Quản trị (Admin Portal)
                    </a>
                </div>
            </div>

            <div class="border-t border-border pt-4 flex gap-2">
                <a asp-controller="Auth" asp-action="Login" class="flex-1 text-center py-2 text-xs font-semibold rounded-xl border border-border bg-card">
                    Đăng nhập
                </a>
                <a asp-controller="Auth" asp-action="Signup" class="flex-1 text-center py-2 text-xs font-semibold rounded-xl bg-primary text-white">
                    Đăng ký
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="flex-1">
        <!-- Flash Notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="flash-alert mx-auto max-w-7xl px-4 pt-4">
                <div class="flex items-center gap-3 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-xs font-medium text-emerald-800 shadow-xs transition-opacity duration-300">
                    <i data-lucide="check-circle-2" class="size-4 shrink-0 text-emerald-600"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="flash-alert mx-auto max-w-7xl px-4 pt-4">
                <div class="flex items-center gap-3 rounded-xl border border-rose-300 bg-rose-50 p-4 text-xs font-medium text-rose-800 shadow-xs transition-opacity duration-300">
                    <i data-lucide="x-circle" class="size-4 shrink-0 text-rose-600"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Site Footer with Big Brand Watermark -->
    <footer id="contact" class="bg-neutral-900 text-white mt-20 overflow-hidden relative" style="padding-bottom: 3rem;">
        <div class="mx-auto max-w-7xl px-4 pt-12 md:px-8">
            <div class="flex flex-col items-center justify-between gap-6 text-sm md:flex-row">
                <p class="text-white/90 text-xs font-medium">&copy; 2026 PropNest Inc. Bảo lưu mọi quyền.</p>
                <nav class="flex flex-wrap justify-center gap-6 text-xs font-medium" aria-label="Footer Navigation">
                    <a asp-controller="Home" asp-action="Index" class="text-white/90 hover:text-primary transition-colors">Trang chủ</a>
                    <a asp-controller="Listings" asp-action="Index" class="text-white/90 hover:text-primary transition-colors">Bất động sản</a>
                    <a href="/#about" class="text-white/90 hover:text-primary transition-colors">Về PropNest</a>
                    <a href="https://localhost:7006/" class="text-white/90 hover:text-primary transition-colors">Kênh Người bán</a>
                    <a href="https://localhost:7215/" class="text-white/90 hover:text-primary transition-colors">Kênh Quản trị</a>
                </nav>
                <div class="flex items-center gap-4 text-white/90">
                    <a href="#" class="hover:text-primary transition-colors" aria-label="Facebook"><i data-lucide="facebook" class="size-4"></i></a>
                    <a href="#" class="hover:text-primary transition-colors" aria-label="Instagram"><i data-lucide="instagram" class="size-4"></i></a>
                    <a href="#" class="hover:text-primary transition-colors" aria-label="LinkedIn"><i data-lucide="linkedin" class="size-4"></i></a>
                    <a href="#" class="hover:text-primary transition-colors" aria-label="Twitter"><i data-lucide="twitter" class="size-4"></i></a>
                </div>
            </div>

            <!-- Big Watermark Text - Fixed to Single Line with Clean Contrast -->
            <div class="w-full overflow-hidden flex justify-center mt-6">
                <p aria-hidden="true"
                   class="propnest-watermark select-none text-center font-display text-[clamp(2.5rem,13.5vw,11.5rem)] leading-[0.85] font-bold tracking-tight whitespace-nowrap">
                    PROPNEST
                </p>
            </div>
        </div>
    </footer>

    <!-- Live Toast Component -->
    <div id="liveToast" class="fixed bottom-6 right-6 z-50 hidden translate-y-10 opacity-0 transition-all duration-300">
        <div class="flex items-start gap-3 rounded-2xl border border-primary/30 bg-card p-4 shadow-xl">
            <div class="grid size-8 place-items-center rounded-full bg-brand-soft text-primary shrink-0">
                <i data-lucide="check" class="size-4"></i>
            </div>
            <div>
                <h4 id="toastTitle" class="text-xs font-bold text-neutral-900">Thông báo</h4>
                <p id="toastDesc" class="text-[11px] text-muted-foreground mt-0.5 max-w-xs">Nội dung thông báo</p>
            </div>
        </div>
    </div>

    <!-- Lucide Icons & Client Scripts -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/js/client.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
