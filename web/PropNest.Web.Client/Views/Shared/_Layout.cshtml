@{
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    var authToken = Context.Request.Cookies[PropNest.Web.Client.Services.AuthHeaderHandler.TokenCookieName];
    var isLoggedIn = !string.IsNullOrWhiteSpace(authToken);
    var userProfile = isLoggedIn ? PropNest.Web.Client.Helpers.JwtUserHelper.GetProfileFromToken(authToken) : null;
    var role = userProfile?.Role ?? string.Empty;
    var isSeller = string.Equals(role, "Seller", StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(role, "Moderator", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="vi" data-scroll-behavior="smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Khám phá Bất động sản") — PropNest</title>

    <!-- Google Fonts: Be Vietnam Pro & Playfair Display with full Vietnamese Unicode subset -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&display=swap&subset=vietnamese" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#fff8e3',
                        surface: '#fdf9eb',
                        card: '#ffffff',
                        primary: {
                            DEFAULT: '#d7730c',
                            foreground: '#ffffff',
                            hover: '#b85e07'
                        },
                        'brand-soft': '#fbe6cc',
                        destructive: {
                            DEFAULT: '#d23b2f',
                            foreground: '#ffffff'
                        },
                        border: '#e8e3d5',
                        muted: {
                            DEFAULT: '#f6eed3',
                            foreground: '#5f5a4f'
                        }
                    },
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                        display: ['"Be Vietnam Pro"', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Theme Custom Styles -->
    <link rel="stylesheet" href="~/css/client.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-surface text-neutral-900 antialiased font-sans flex flex-col justify-between">
    <!-- Top Sticky Header -->
    <header class="sticky top-0 z-40 w-full border-b border-border bg-card/90 backdrop-blur-md">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
            <!-- Left: Logo & Navigation Links -->
            <div class="flex items-center gap-8">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                    <div class="grid size-9 place-items-center rounded-xl bg-primary text-white shadow-xs font-bold text-lg font-display">
                        PN
                    </div>
                    <span class="font-display text-xl font-bold tracking-tight text-neutral-900 leading-none">PropNest</span>
                </a>

                <nav class="hidden items-center gap-6 md:flex" aria-label="Customer Navigation">
                    <a asp-controller="Home" asp-action="Index"
                       class="relative py-1 text-sm font-medium transition-colors hover:text-primary @(currentPath == "" || currentPath == "/" ? "text-primary font-semibold after:absolute after:inset-x-0 after:-bottom-1.5 after:h-0.5 after:bg-primary" : "text-muted-foreground")">
                        Trang chủ
                    </a>
                    <a asp-controller="Listings" asp-action="Index"
                       class="relative py-1 text-sm font-medium transition-colors hover:text-primary @(currentPath.StartsWith("/listings") ? "text-primary font-semibold after:absolute after:inset-x-0 after:-bottom-1.5 after:h-0.5 after:bg-primary" : "text-muted-foreground")">
                        Khám phá BĐS
                    </a>

                    <!-- Category Dropdown -->
                    <div class="relative">
                        <button id="categoryDropdownBtn" type="button" onclick="toggleCategoryDropdown()"
                                class="flex items-center gap-1.5 py-1 text-sm outline-none transition-colors text-muted-foreground hover:text-primary font-medium">
                            <span>Danh mục</span>
                            <i data-lucide="chevron-down" class="size-4"></i>
                        </button>
                        <div id="categoryDropdownMenu" class="absolute left-0 mt-2 w-52 hidden rounded-xl border border-border bg-card p-1.5 shadow-lg z-50">
                            <a asp-controller="Listings" asp-action="Index" asp-route-type="sale" class="block px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface hover:text-primary transition-colors">
                                BĐS Cần bán (For Sale)
                            </a>
                            <a asp-controller="Listings" asp-action="Index" asp-route-type="rent" class="block px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface hover:text-primary transition-colors">
                                BĐS Cho thuê (For Rent)
                            </a>
                            <div class="border-t border-border/60 my-1"></div>
                            <a asp-controller="Listings" asp-action="Index" asp-route-homeType="Villa" class="block px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface hover:text-primary transition-colors">
                                Biệt thự (Villa)
                            </a>
                            <a asp-controller="Listings" asp-action="Index" asp-route-homeType="Apartment" class="block px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface hover:text-primary transition-colors">
                                Căn hộ chung cư
                            </a>
                            <a asp-controller="Listings" asp-action="Index" asp-route-homeType="House" class="block px-3 py-2 text-xs rounded-lg text-neutral-800 hover:bg-surface hover:text-primary transition-colors">
                                Nhà riêng / Nhà phố
                            </a>
                        </div>
                    </div>

                    <a href="/#about" class="text-sm font-medium text-muted-foreground transition-colors hover:text-primary">
                        Về PropNest
                    </a>
                </nav>
            </div>

            <!-- Right: Portal Switchers & Account -->
            <div class="flex items-center gap-3">

                <!-- Portal Switchers based on Roles -->
                @if (isLoggedIn)
                {
                    @if (isSeller)
                    {
                        <!-- Seller: Chỉ thấy Kênh Người bán, Ẩn Kênh Quản trị -->
                        <a href="https://localhost:7006/"
                           class="hidden md:inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-neutral-900 border border-border rounded-full px-3.5 py-1.5 hover:bg-surface transition-colors">
                            <i data-lucide="store" class="size-3.5 text-primary"></i> Kênh Người bán
                        </a>
                    }
                    else if (isAdmin)
                    {
                        <!-- Admin: Chỉ thấy Kênh Quản trị, Chặn Kênh Người bán -->
                        <a href="https://localhost:7215/"
                           class="hidden md:inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-neutral-900 border border-border rounded-full px-3.5 py-1.5 hover:bg-surface transition-colors">
                            <i data-lucide="layout-dashboard" class="size-3.5 text-destructive"></i> Kênh Quản trị
                        </a>
                    }
                }

                <!-- Saved Favorites Button -->
                <a asp-controller="Listings" asp-action="Index" asp-route-savedOnly="true"
                   class="relative grid size-9 place-items-center rounded-full border border-border bg-card text-muted-foreground hover:text-primary transition-colors"
                   title="Bất động sản đã lưu">
                    <i data-lucide="heart" class="size-4"></i>
                    <span id="favCountBadge" class="absolute -top-1 -right-1 hidden size-4 rounded-full bg-primary text-[10px] font-bold text-white grid place-items-center">
                        0
                    </span>
                </a>


                @if (isLoggedIn)
                {
                    <!-- Đã đăng nhập: Nút xem hồ sơ và Đăng xuất -->
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="openProfileModal()"
                                class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1.5 text-xs font-semibold text-neutral-800 hover:border-primary hover:bg-surface transition-colors shadow-2xs group cursor-pointer"
                                title="Bấm để xem hồ sơ thông tin tài khoản">
                            <span class="grid size-6 place-items-center rounded-full bg-primary/15 text-primary text-[10px] font-bold group-hover:bg-primary group-hover:text-white transition-colors">
                                @(userProfile?.Initials ?? "PN")
                            </span>
                            <span class="max-w-[120px] truncate font-medium">@(string.IsNullOrWhiteSpace(userProfile?.FullName) ? "Hồ sơ" : userProfile.FullName)</span>
                            <i data-lucide="chevron-down" class="size-3 text-muted-foreground group-hover:text-primary transition-colors"></i>
                        </button>
                        <a asp-controller="Auth" asp-action="Logout"
                           class="rounded-full border border-border bg-card hover:border-rose-400 hover:text-rose-600 px-3.5 py-1.5 text-xs font-semibold text-neutral-600 transition-colors"
                           title="Đăng xuất khỏi hệ thống">
                            Đăng xuất
                        </a>
                    </div>
                }
                else
                {
                    <!-- Chưa đăng nhập: Hiện Đăng nhập / Đăng ký -->
                    <a asp-controller="Auth" asp-action="Login" class="text-xs font-semibold text-muted-foreground hover:text-primary px-3 py-1.5">
                        Đăng nhập
                    </a>
                    <a asp-controller="Auth" asp-action="Signup"
                       class="hidden sm:inline-flex items-center rounded-full bg-primary px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-primary-hover transition-colors">
                        Đăng ký
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Mobile Drawer Sheet -->
    <div id="mobileMenuSheet" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs">
        <div class="fixed inset-y-0 left-0 w-72 bg-surface p-6 shadow-xl flex flex-col justify-between">
            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2">
                        <div class="grid size-8 place-items-center rounded-xl bg-primary text-white font-bold font-display">PN</div>
                        <span class="font-display text-lg font-bold">PropNest</span>
                    </a>
                    <button type="button" onclick="toggleMobileMenu()" class="text-muted-foreground hover:text-neutral-900">
                        <i data-lucide="x" class="size-5"></i>
                    </button>
                </div>

                <nav class="flex flex-col gap-3 text-sm font-medium">
                    <a asp-controller="Home" asp-action="Index" class="py-1 hover:text-primary">Trang chủ</a>
                    <a asp-controller="Listings" asp-action="Index" class="py-1 hover:text-primary">Khám phá BĐS</a>
                    <a asp-controller="Listings" asp-action="Index" asp-route-type="sale" class="py-1 text-muted-foreground hover:text-primary">BĐS Cần bán</a>
                    <a asp-controller="Listings" asp-action="Index" asp-route-type="rent" class="py-1 text-muted-foreground hover:text-primary">BĐS Cho thuê</a>
                    <a href="/#about" class="py-1 text-muted-foreground hover:text-primary">Về PropNest</a>
                </nav>

                <div class="border-t border-border pt-4 space-y-2 text-xs">
                    <a href="https://localhost:7006/" class="block font-semibold text-primary py-1">
                        👉 Cổng Người bán (Seller Portal)
                    </a>
                    <a href="https://localhost:7215/" class="block font-semibold text-destructive py-1">
                        👉 Cổng Quản trị (Admin Portal)
                    </a>
                </div>
            </div>

            <div class="border-t border-border pt-4">
                @if (isLoggedIn)
                {
                    <div class="flex flex-col gap-2.5">
                        <button type="button" onclick="toggleMobileMenu(); openProfileModal();"
                                class="flex items-center gap-3 p-2.5 rounded-xl bg-card border border-border text-left hover:border-primary transition-colors cursor-pointer w-full">
                            <div class="grid size-9 place-items-center rounded-xl bg-primary text-white text-xs font-bold shrink-0">
                                @(userProfile?.Initials ?? "PN")
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-xs font-bold text-neutral-900 truncate">@(string.IsNullOrWhiteSpace(userProfile?.FullName) ? "Người dùng PropNest" : userProfile.FullName)</p>
                                <p class="text-[11px] text-muted-foreground truncate">@userProfile?.Email</p>
                            </div>
                            <i data-lucide="chevron-right" class="size-4 text-muted-foreground shrink-0"></i>
                        </button>
                        <a asp-controller="Auth" asp-action="Logout" class="text-center py-2 text-xs font-semibold rounded-xl border border-rose-300 text-rose-600 bg-rose-50 hover:bg-rose-100 transition-colors">
                            Đăng xuất
                        </a>
                    </div>
                }
                else
                {
                    <div class="flex gap-2">
                        <a asp-controller="Auth" asp-action="Login" class="flex-1 text-center py-2 text-xs font-semibold rounded-xl border border-border bg-card">
                            Đăng nhập
                        </a>
                        <a asp-controller="Auth" asp-action="Signup" class="flex-1 text-center py-2 text-xs font-semibold rounded-xl bg-primary text-white">
                            Đăng ký
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="flex-1">
        @RenderBody()
    </main>

    <!-- Site Footer with Big Brand Watermark -->
    <footer id="contact" class="bg-neutral-900 text-white mt-20 overflow-hidden relative" style="padding-bottom: 3rem;">
        <div class="mx-auto max-w-7xl px-4 pt-12 md:px-8">
            <div class="flex flex-col items-center justify-between gap-6 text-sm md:flex-row">
                <p class="text-white/90 text-xs font-medium">&copy; 2026 PropNest Inc. Bảo lưu mọi quyền.</p>
                <nav class="flex flex-wrap justify-center gap-6 text-xs font-medium" aria-label="Footer Navigation">
                    <a asp-controller="Home" asp-action="Index" class="text-white/90 hover:text-primary transition-colors">Trang chủ</a>
                    <a asp-controller="Listings" asp-action="Index" class="text-white/90 hover:text-primary transition-colors">Bất động sản</a>
                    <a href="/#about" class="text-white/90 hover:text-primary transition-colors">Về PropNest</a>
                    <a href="https://localhost:7006/" class="text-white/90 hover:text-primary transition-colors">Kênh Người bán</a>
                    <a href="https://localhost:7215/" class="text-white/90 hover:text-primary transition-colors">Kênh Quản trị</a>
                </nav>
                <div class="flex items-center gap-4 text-white/90">
                    <a href="#" class="hover:text-primary transition-colors" aria-label="Facebook"><i data-lucide="facebook" class="size-4"></i></a>
                    <a href="#" class="hover:text-primary transition-colors" aria-label="Instagram"><i data-lucide="instagram" class="size-4"></i></a>
                    <a href="#" class="hover:text-primary transition-colors" aria-label="LinkedIn"><i data-lucide="linkedin" class="size-4"></i></a>
                    <a href="#" class="hover:text-primary transition-colors" aria-label="Twitter"><i data-lucide="twitter" class="size-4"></i></a>
                </div>
            </div>

            <!-- Big Watermark Text - Fixed to Single Line with Clean Contrast -->
            <div class="w-full overflow-hidden flex justify-center mt-6">
                <p aria-hidden="true"
                   class="propnest-watermark select-none text-center font-display text-[clamp(2.5rem,13.5vw,11.5rem)] leading-[0.85] font-bold tracking-tight whitespace-nowrap">
                    PROPNEST
                </p>
            </div>
        </div>
    </footer>

    <!-- Global Back to Top Button -->
    <button type="button" id="backToTopBtn" aria-label="Cuộn lên đầu trang"
            class="fixed bottom-6 right-6 z-40 hidden size-11 place-items-center rounded-full bg-card/90 text-neutral-800 shadow-lg border border-border backdrop-blur-md transition-all duration-300 hover:bg-primary hover:text-white hover:scale-110 hover:shadow-xl hover:border-primary">
        <i data-lucide="arrow-up" class="size-5"></i>
    </button>

    <!-- Floating Toast Popups Container (Nổi trên bề mặt, không làm xô lệch layout) -->
    <div id="toastContainer" class="fixed top-6 right-6 z-[9999] flex flex-col gap-3 pointer-events-none max-w-sm sm:max-w-md w-full px-4 sm:px-0">
        @if (!ViewData.ModelState.IsValid)
        {
            var errors = ViewData.ModelState.Values
                .SelectMany(v => v.Errors)
                .Select(e => e.ErrorMessage)
                .Where(m => !string.IsNullOrWhiteSpace(m))
                .Distinct()
                .ToList();

            if (errors.Any())
            {
                <div class="toast-item pointer-events-auto flex items-start gap-3 rounded-2xl border border-rose-400/40 bg-white/95 p-4 shadow-2xl backdrop-blur-md transition-all duration-300 ring-1 ring-rose-500/15 text-neutral-900 animate-[toastSlideIn_0.3s_ease-out]">
                    <div class="grid size-8 shrink-0 place-items-center rounded-xl bg-rose-100 text-rose-700">
                        <i data-lucide="alert-triangle" class="size-5"></i>
                    </div>
                    <div class="flex-1 min-w-0 pt-0.5">
                        <p class="text-xs font-bold text-rose-900">Vui lòng kiểm tra lại thông tin</p>
                        <div class="text-xs text-neutral-700 mt-1 space-y-1">
                            @foreach (var err in errors)
                            {
                                <p class="leading-relaxed flex items-start gap-1.5">• <span>@err</span></p>
                            }
                        </div>
                    </div>
                    <button type="button" onclick="dismissToast(this)" class="shrink-0 text-neutral-400 hover:text-neutral-700 p-1 rounded-lg cursor-pointer">
                        <i data-lucide="x" class="size-4"></i>
                    </button>
                </div>
            }
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast-item pointer-events-auto flex items-start gap-3 rounded-2xl border border-emerald-400/40 bg-white/95 p-4 shadow-2xl backdrop-blur-md transition-all duration-300 ring-1 ring-emerald-500/15 text-neutral-900">
                <div class="grid size-8 shrink-0 place-items-center rounded-xl bg-emerald-100 text-emerald-700">
                    <i data-lucide="check-circle-2" class="size-5"></i>
                </div>
                <div class="flex-1 min-w-0 pt-0.5">
                    <p class="text-xs font-bold text-emerald-900">Thành công</p>
                    <p class="text-xs text-neutral-700 mt-0.5 leading-relaxed">@TempData["SuccessMessage"]</p>
                </div>
                <button type="button" onclick="dismissToast(this)" class="shrink-0 text-neutral-400 hover:text-neutral-700 p-1 rounded-lg cursor-pointer">
                    <i data-lucide="x" class="size-4"></i>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast-item pointer-events-auto flex items-start gap-3 rounded-2xl border border-rose-400/40 bg-white/95 p-4 shadow-2xl backdrop-blur-md transition-all duration-300 ring-1 ring-rose-500/15 text-neutral-900">
                <div class="grid size-8 shrink-0 place-items-center rounded-xl bg-rose-100 text-rose-700">
                    <i data-lucide="alert-triangle" class="size-5"></i>
                </div>
                <div class="flex-1 min-w-0 pt-0.5">
                    <p class="text-xs font-bold text-rose-900">Thông báo</p>
                    <p class="text-xs text-neutral-700 mt-0.5 leading-relaxed">@TempData["ErrorMessage"]</p>
                </div>
                <button type="button" onclick="dismissToast(this)" class="shrink-0 text-neutral-400 hover:text-neutral-700 p-1 rounded-lg cursor-pointer">
                    <i data-lucide="x" class="size-4"></i>
                </button>
            </div>
        }
    </div>

    @if (isLoggedIn && userProfile != null)
    {
        <!-- User Profile Modal (Xem thông tin hồ sơ người dùng) -->
        <div id="userProfileModal" class="fixed inset-0 z-[9998] hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
            <div class="w-full max-w-md rounded-2xl bg-surface border border-border shadow-2xl overflow-hidden transition-all transform scale-100">
                <!-- Header Modal -->
                <div class="relative bg-gradient-to-br from-[#1f1a14] via-[#2c241c] to-[#1f1a14] p-6 text-white border-b border-white/10">
                    <button type="button" onclick="closeProfileModal()" class="absolute top-4 right-4 rounded-full p-1.5 text-white/60 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" title="Đóng">
                        <i data-lucide="x" class="size-5"></i>
                    </button>
                    <div class="flex items-center gap-4">
                        <div class="grid size-14 place-items-center rounded-2xl bg-primary text-white font-bold font-display text-xl shadow-md border-2 border-white/20">
                            @userProfile.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <h3 class="text-lg font-bold font-display truncate">@userProfile.FullName</h3>
                                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 text-[10px] font-semibold">
                                    <i data-lucide="check" class="size-3"></i> @userProfile.StatusDisplay
                                </span>
                            </div>
                            <p class="text-xs text-white/70 mt-0.5">@userProfile.RoleDisplay</p>
                        </div>
                    </div>
                </div>

                <!-- Profile Form Fields -->
                <div class="p-6 space-y-4 text-xs">
                    <div>
                        <label class="font-semibold text-muted-foreground block mb-1.5">Họ và tên</label>
                        <div class="flex items-center gap-2.5 p-3 rounded-xl border border-border bg-card text-neutral-900 font-medium">
                            <i data-lucide="user" class="size-4 text-primary shrink-0"></i>
                            <span class="truncate">@userProfile.FullName</span>
                        </div>
                    </div>

                    <div>
                        <label class="font-semibold text-muted-foreground block mb-1.5">Địa chỉ Email</label>
                        <div class="flex items-center gap-2.5 p-3 rounded-xl border border-border bg-card text-neutral-900 font-medium">
                            <i data-lucide="mail" class="size-4 text-primary shrink-0"></i>
                            <span class="truncate">@userProfile.Email</span>
                        </div>
                    </div>

                    <div>
                        <label class="font-semibold text-muted-foreground block mb-1.5">Số điện thoại</label>
                        <div class="flex items-center gap-2.5 p-3 rounded-xl border border-border bg-card text-neutral-900 font-medium">
                            <i data-lucide="phone" class="size-4 text-primary shrink-0"></i>
                            <span>@(string.IsNullOrWhiteSpace(userProfile.PhoneNumber) ? "Chưa cập nhật" : userProfile.PhoneNumber)</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 pt-1">
                        <div>
                            <label class="font-semibold text-muted-foreground block mb-1.5">Vai trò tài khoản</label>
                            <div class="p-3 rounded-xl border border-border bg-card text-neutral-900 font-medium flex items-center gap-2">
                                <i data-lucide="shield" class="size-4 text-primary shrink-0"></i>
                                <span class="truncate">@userProfile.Role</span>
                            </div>
                        </div>
                        <div>
                            <label class="font-semibold text-muted-foreground block mb-1.5">Mã định danh</label>
                            <div class="p-3 rounded-xl border border-border bg-card text-neutral-900 font-medium flex items-center gap-2">
                                <i data-lucide="hash" class="size-4 text-primary shrink-0"></i>
                                <span>#@(userProfile.UserId?.ToString() ?? "N/A")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="border-t border-border p-4 bg-card/60 flex items-center justify-between gap-3">
                    <a asp-controller="Auth" asp-action="Logout" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors">
                        <i data-lucide="log-out" class="size-3.5"></i> Đăng xuất
                    </a>
                    <button type="button" onclick="closeProfileModal()" class="px-5 py-2 rounded-xl text-xs font-semibold bg-neutral-900 text-white hover:bg-neutral-800 transition-colors cursor-pointer">
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Lucide Icons & Client Scripts -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/js/client.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
