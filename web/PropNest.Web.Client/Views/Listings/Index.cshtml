@model PropNest.Web.Client.Models.ViewModels.ListingsViewModel

@{
    ViewData["Title"] = "Danh sách Bất động sản";
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.Query) ||
                           (Model.Type != "all" && !string.IsNullOrWhiteSpace(Model.Type)) ||
                           !string.IsNullOrWhiteSpace(Model.PropertyType) ||
                           !string.IsNullOrWhiteSpace(Model.City) ||
                           !string.IsNullOrWhiteSpace(Model.District) ||
                           Model.MinPrice.HasValue ||
                           Model.MaxPrice.HasValue;
}

<div class="mx-auto max-w-7xl px-4 py-6 md:px-8">
    <!-- ================= MOBILE HEADER & TOOLBAR (chỉ hiện trên màn hình nhỏ < lg) ================= -->
    <div class="lg:hidden mb-5">
        <!-- 1. Thông báo số lượng tin đăng (swap lên trên cùng) -->
        <div class="mb-3">
            <h1 class="font-display text-xl font-bold text-neutral-900">
                @Model.TotalCount tin đăng phù hợp
            </h1>
            <p class="text-xs text-muted-foreground mt-0.5">
                Dữ liệu tin đăng chính thức đã được kiểm duyệt từ hệ thống PropNest.
            </p>
        </div>

        <!-- 2. Hàng thanh công cụ: [Nút Bộ lọc] cùng hàng với [Cụm nút Grid / List] -->
        <div class="flex items-center justify-between gap-3">
            <!-- Nút Bộ lọc nhỏ gọn -->
            <button type="button" id="toggleMobileFilterBtn"
                    class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-3.5 py-2 text-xs font-semibold text-neutral-800 shadow-xs hover:border-primary/50 transition-colors">
                <i data-lucide="filter" class="size-3.5 text-primary"></i>
                <span>Bộ lọc</span>
                @if (hasActiveFilters)
                {
                    <span class="inline-flex items-center justify-center px-1.5 py-0.5 rounded-full bg-primary text-white text-[10px] font-bold">
                        Đang lọc
                    </span>
                }
                <i id="filterToggleIcon" data-lucide="chevron-down" class="size-3.5 text-muted-foreground transition-transform duration-200 @(hasActiveFilters ? "rotate-180" : "")"></i>
            </button>

            <!-- Cụm Grid / List trên Mobile -->
            <div class="flex items-center gap-1 rounded-xl border border-border p-1 bg-surface shrink-0">
                <a asp-action="Index"
                   asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-propertyType="@Model.PropertyType"
                   asp-route-city="@Model.City" asp-route-district="@Model.District"
                   asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                   asp-route-page="@Model.PageNumber" asp-route-layout="grid"
                   class="rounded-lg p-1.5 transition-colors @(Model.Layout == "grid" ? "bg-card shadow-xs text-primary font-semibold" : "text-muted-foreground hover:text-neutral-900")"
                   title="Chế độ lưới">
                    <i data-lucide="layout-grid" class="size-4"></i>
                </a>
                <a asp-action="Index"
                   asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-propertyType="@Model.PropertyType"
                   asp-route-city="@Model.City" asp-route-district="@Model.District"
                   asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                   asp-route-page="@Model.PageNumber" asp-route-layout="list"
                   class="rounded-lg p-1.5 transition-colors @(Model.Layout == "list" ? "bg-card shadow-xs text-primary font-semibold" : "text-muted-foreground hover:text-neutral-900")"
                   title="Chế độ danh sách">
                    <i data-lucide="list" class="size-4"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-8 items-start">

        <!-- ================= CỘT TRÁI: FILTER SIDEBAR ================= -->
        <aside id="filterSidebar"
               class="w-full lg:w-72 shrink-0 rounded-2xl border border-border bg-card p-5 shadow-xs relative lg:sticky lg:top-20 @(hasActiveFilters ? "block" : "hidden lg:block")">
            <div class="flex items-center justify-between border-b border-border/80 pb-3 mb-4">
                <div class="flex items-center gap-2">
                    <i data-lucide="filter" class="size-4 text-primary"></i>
                    <h2 class="text-sm font-bold text-neutral-900">Bộ lọc tìm kiếm</h2>
                </div>
                @if (hasActiveFilters)
                {
                    <a asp-action="Index" class="text-xs font-semibold text-primary hover:underline">
                        Xóa tất cả
                    </a>
                }
            </div>

            <form method="get" asp-action="Index" id="filterSidebarForm" class="space-y-4">
                <input type="hidden" name="layout" value="@Model.Layout" />

                <!-- 1. Từ khóa tìm kiếm -->
                <div>
                    <label class="block text-xs font-semibold text-neutral-700 mb-1">Từ khóa</label>
                    <input type="search" name="q" value="@Model.Query" placeholder="Địa chỉ, tên dự án..."
                           class="w-full h-10 rounded-xl border border-border bg-surface px-3 text-xs outline-none focus:border-primary transition-colors" />
                </div>

                <!-- 2. Hình thức giao dịch (ListingType) -->
                <div>
                    <label class="block text-xs font-semibold text-neutral-700 mb-1">Hình thức</label>
                    <select name="type" class="w-full h-10 rounded-xl border border-border bg-surface px-3 text-xs font-medium outline-none focus:border-primary transition-colors">
                        <option value="all" selected="@(Model.Type == "all")">Tất cả (Mua & Thuê)</option>
                        <option value="sale" selected="@(string.Equals(Model.Type, "sale", StringComparison.OrdinalIgnoreCase))">Cần bán</option>
                        <option value="rent" selected="@(string.Equals(Model.Type, "rent", StringComparison.OrdinalIgnoreCase))">Cho thuê</option>
                    </select>
                </div>

                <!-- 3. Loại hình bất động sản (PropertyType) -->
                <div>
                    <label class="block text-xs font-semibold text-neutral-700 mb-1">Loại bất động sản</label>
                    <select name="propertyType" class="w-full h-10 rounded-xl border border-border bg-surface px-3 text-xs font-medium outline-none focus:border-primary transition-colors">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.PropertyType))">Tất cả loại hình</option>
                        <option value="Apartment" selected="@(Model.PropertyType == "Apartment")">Căn hộ chung cư</option>
                        <option value="House" selected="@(Model.PropertyType == "House")">Nhà riêng / Nhà phố</option>
                        <option value="Villa" selected="@(Model.PropertyType == "Villa")">Biệt thự (Villa)</option>
                        <option value="Land" selected="@(Model.PropertyType == "Land")">Đất nền</option>
                    </select>
                </div>

                <!-- 4. Tỉnh / Thành phố (City) -->
                <div>
                    <label class="block text-xs font-semibold text-neutral-700 mb-1">Tỉnh / Thành phố</label>
                    <input type="text" name="city" value="@Model.City" placeholder="Ví dụ: TP. Hồ Chí Minh"
                           class="w-full h-10 rounded-xl border border-border bg-surface px-3 text-xs outline-none focus:border-primary transition-colors" />
                </div>

                <!-- 5. Quận / Huyện (District) -->
                <div>
                    <label class="block text-xs font-semibold text-neutral-700 mb-1">Quận / Huyện</label>
                    <input type="text" name="district" value="@Model.District" placeholder="Ví dụ: Quận 7, Thủ Đức..."
                           class="w-full h-10 rounded-xl border border-border bg-surface px-3 text-xs outline-none focus:border-primary transition-colors" />
                </div>

                <!-- 6. Khoảng giá (MinPrice - MaxPrice) -->
                <div>
                    <label class="block text-xs font-semibold text-neutral-700 mb-1">Khoảng giá (VNĐ)</label>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="number" name="minPrice" value="@Model.MinPrice" placeholder="Từ"
                               class="w-full h-10 rounded-xl border border-border bg-surface px-2.5 text-xs outline-none focus:border-primary transition-colors" />
                        <input type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="Đến"
                               class="w-full h-10 rounded-xl border border-border bg-surface px-2.5 text-xs outline-none focus:border-primary transition-colors" />
                    </div>
                </div>

                <!-- Nút áp dụng bộ lọc -->
                <button type="submit"
                        class="w-full mt-2 h-10 rounded-xl bg-primary text-white font-semibold text-xs shadow-xs hover:bg-primary-hover transition-colors flex items-center justify-center gap-1.5">
                    <i data-lucide="search" class="size-3.5"></i>
                    <span>Áp dụng bộ lọc</span>
                </button>
            </form>
        </aside>

        <!-- ================= CỘT PHẢI: DANH SÁCH TIN ĐĂNG ================= -->
        <main class="flex-1 min-w-0">
            <!-- Header Toolbar trên Desktop (chỉ hiện trên màn hình lớn >= lg) -->
            <div class="hidden lg:flex items-center justify-between gap-4 pb-4 border-b border-border">
                <div>
                    <h1 class="font-display text-2xl md:text-3xl font-bold text-neutral-900">
                        @Model.TotalCount tin đăng phù hợp
                    </h1>
                    <p class="text-xs text-muted-foreground mt-0.5">
                        Dữ liệu tin đăng chính thức đã được kiểm duyệt từ hệ thống PropNest.
                    </p>
                </div>

                <!-- Layout Toggle (Grid vs List) -->
                <div class="flex items-center gap-1 rounded-xl border border-border p-1 bg-surface shrink-0">
                    <a asp-action="Index"
                       asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-propertyType="@Model.PropertyType"
                       asp-route-city="@Model.City" asp-route-district="@Model.District"
                       asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-page="@Model.PageNumber" asp-route-layout="grid"
                       class="rounded-lg p-2 transition-colors @(Model.Layout == "grid" ? "bg-card shadow-xs text-primary font-semibold" : "text-muted-foreground hover:text-neutral-900")"
                       title="Chế độ lưới">
                        <i data-lucide="layout-grid" class="size-4"></i>
                    </a>
                    <a asp-action="Index"
                       asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-propertyType="@Model.PropertyType"
                       asp-route-city="@Model.City" asp-route-district="@Model.District"
                       asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-page="@Model.PageNumber" asp-route-layout="list"
                       class="rounded-lg p-2 transition-colors @(Model.Layout == "list" ? "bg-card shadow-xs text-primary font-semibold" : "text-muted-foreground hover:text-neutral-900")"
                       title="Chế độ danh sách">
                        <i data-lucide="list" class="size-4"></i>
                    </a>
                </div>
            </div>

            <!-- Danh sách hiển thị -->
            @if (Model.TotalCount == 0)
            {
                <div class="mt-8 rounded-2xl border border-dashed border-border bg-card p-12 text-center text-xs text-muted-foreground">
                    <i data-lucide="search-x" class="size-10 mx-auto mb-3 text-muted-foreground/60"></i>
                    <p class="text-sm font-bold text-neutral-800">Không tìm thấy bất động sản nào</p>
                    <p class="mt-1">Hãy thử nới rộng khoảng giá hoặc xóa bớt tiêu chí lọc.</p>
                    <a asp-action="Index" class="mt-4 inline-flex items-center gap-1 rounded-full border border-primary px-4 py-2 font-semibold text-primary hover:bg-primary hover:text-white transition-colors">
                        Xóa tất cả bộ lọc
                    </a>
                </div>
            }
            else
            {
                <div class="mt-6 @(Model.Layout == "list" ? "space-y-4" : "grid gap-6 sm:grid-cols-2 lg:grid-cols-3")">
                    @foreach (var p in Model.Properties)
                    {
                        <partial name="_PropertyCard" model="p" />
                    }
                </div>

                <!-- ================= PHÂN TRANG (PAGINATION) ================= -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Phân trang" class="mt-10 flex items-center justify-center gap-1.5 text-xs font-semibold">
                        <!-- Nút Trang trước -->
                        @if (Model.PageNumber > 1)
                        {
                            <a asp-action="Index"
                               asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-propertyType="@Model.PropertyType"
                               asp-route-city="@Model.City" asp-route-district="@Model.District"
                               asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                               asp-route-page="@(Model.PageNumber - 1)" asp-route-layout="@Model.Layout"
                               class="h-9 px-3 rounded-xl border border-border bg-card text-neutral-700 hover:border-primary hover:text-primary flex items-center gap-1 transition-colors">
                                <i data-lucide="chevron-left" class="size-3.5"></i>
                                <span>Trước</span>
                            </a>
                        }

                        <!-- Các số trang -->
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            var pageIndex = i;
                            <a asp-action="Index"
                               asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-propertyType="@Model.PropertyType"
                               asp-route-city="@Model.City" asp-route-district="@Model.District"
                               asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                               asp-route-page="@pageIndex" asp-route-layout="@Model.Layout"
                               class="size-9 rounded-xl border flex items-center justify-center transition-colors @(pageIndex == Model.PageNumber ? "border-primary bg-primary text-white shadow-xs" : "border-border bg-card text-neutral-700 hover:border-primary hover:text-primary")">
                                @pageIndex
                            </a>
                        }

                        <!-- Nút Trang sau -->
                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <a asp-action="Index"
                               asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-propertyType="@Model.PropertyType"
                               asp-route-city="@Model.City" asp-route-district="@Model.District"
                               asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                               asp-route-page="@(Model.PageNumber + 1)" asp-route-layout="@Model.Layout"
                               class="h-9 px-3 rounded-xl border border-border bg-card text-neutral-700 hover:border-primary hover:text-primary flex items-center gap-1 transition-colors">
                                <span>Sau</span>
                                <i data-lucide="chevron-right" class="size-3.5"></i>
                            </a>
                        }
                    </nav>
                }
            }
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('toggleMobileFilterBtn');
            const sidebar = document.getElementById('filterSidebar');
            const toggleIcon = document.getElementById('filterToggleIcon');

            if (toggleBtn && sidebar && toggleIcon) {
                toggleBtn.addEventListener('click', function () {
                    const isHidden = sidebar.classList.contains('hidden');
                    if (isHidden) {
                        sidebar.classList.remove('hidden');
                        toggleIcon.classList.add('rotate-180');
                    } else {
                        sidebar.classList.add('hidden');
                        toggleIcon.classList.remove('rotate-180');
                    }
                });
            }
        });
    </script>
}