                    <input type="text" id="modalDistrictManual" placeholder="Quận / Huyện..."
                           class="h-8 rounded-lg border border-border/80 bg-card px-2.5 text-[11px] outline-none focus:border-primary" />
                    <input type="text" id="modalWardManual" placeholder="Phường / Xã..."
                           class="h-8 rounded-lg border border-border/80 bg-card px-2.5 text-[11px] outline-none focus:border-primary" />
                </div>
            </div>

            <!-- BƯỚC 3: MỨC GIÁ -->
            <div id="modalSectionPrice" class="space-y-3 pt-5 border-t border-border/80">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-900 flex items-center gap-1.5">
                        <span class="grid size-5 place-items-center rounded-md bg-primary text-white text-[10px]">3</span>
                        Mức giá
                    </h3>
                    <span id="modalPriceContextLabel" class="text-[11px] text-muted-foreground">Đơn vị: VNĐ</span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-semibold text-neutral-600 mb-1">Giá thấp nhất</label>
                        <input type="number" id="modalMinPrice" min="0" step="1000000" placeholder="Từ (VNĐ)"
                               oninput="syncModalPriceFromInput()"
                               class="w-full h-9 rounded-xl border border-border bg-surface px-3 text-xs outline-none focus:border-primary" />
                        <p id="modalMinPriceHint" class="text-[10px] text-primary font-semibold mt-1 min-h-[14px]"></p>
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-neutral-600 mb-1">Giá cao nhất</label>
                        <input type="number" id="modalMaxPrice" min="0" step="1000000" placeholder="Đến (VNĐ)"
                               oninput="syncModalPriceFromInput()"
                               class="w-full h-9 rounded-xl border border-border bg-surface px-3 text-xs outline-none focus:border-primary" />
                        <p id="modalMaxPriceHint" class="text-[10px] text-primary font-semibold mt-1 min-h-[14px]"></p>
                    </div>
                </div>

                <div id="modalPricePresets" class="flex flex-wrap gap-1.5">
                    <!-- Populated dynamically for Sale vs Rent -->
                </div>
            </div>

            <!-- BƯỚC 4: DIỆN TÍCH -->
            <div id="modalSectionArea" class="space-y-3 pt-5 border-t border-border/80">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-900 flex items-center gap-1.5">
                        <span class="grid size-5 place-items-center rounded-md bg-primary text-white text-[10px]">4</span>
                        Diện tích
                    </h3>
                    <span class="text-[11px] text-muted-foreground">Đơn vị: m²</span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-semibold text-neutral-600 mb-1">Từ (m²)</label>
                        <input type="number" id="modalMinArea" min="0" placeholder="VD: 50"
                               oninput="syncModalAreaFromInput()"
                               class="w-full h-9 rounded-xl border border-border bg-surface px-3 text-xs outline-none focus:border-primary" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-neutral-600 mb-1">Đến (m²)</label>
                        <input type="number" id="modalMaxArea" min="0" placeholder="VD: 120"
                               oninput="syncModalAreaFromInput()"
                               class="w-full h-9 rounded-xl border border-border bg-surface px-3 text-xs outline-none focus:border-primary" />
                    </div>
                </div>

                <div id="modalAreaPresets" class="flex flex-wrap gap-1.5">
                    <!-- Populated dynamically -->
                </div>
            </div>

            <!-- BƯỚC 5: SỐ PHÒNG & HƯỚNG BAN CÔNG -->
            <div id="modalSectionSpecs" class="space-y-4 pt-5 border-t border-border/80">
                <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-900 flex items-center gap-1.5">
                    <span class="grid size-5 place-items-center rounded-md bg-primary text-white text-[10px]">5</span>
                    Số phòng &amp; Hướng ban công
                </h3>

                <!-- Số phòng ngủ -->
                <div>
                    <label class="block text-xs font-semibold text-neutral-700 mb-2">Số phòng ngủ</label>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" data-modal-bed="" onclick="setModalBedrooms('')"
                                class="modal-bed-btn px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer">
                            Tất cả
                        </button>
                        @foreach (var n in new[] { 1, 2, 3, 4, 5 })
                        {
                            <button type="button" data-modal-bed="@n" onclick="setModalBedrooms('@n')"
                                    class="modal-bed-btn px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer">
                                @(n)+ PN
                            </button>
                        }
                    </div>
                </div>

                <!-- Số phòng tắm -->
                <div>
                    <label class="block text-xs font-semibold text-neutral-700 mb-2">Số phòng tắm / WC</label>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" data-modal-bath="" onclick="setModalBathrooms('')"
                                class="modal-bath-btn px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer">
                            Tất cả
                        </button>
                        @foreach (var n in new[] { 1, 2, 3, 4 })
                        {
                            <button type="button" data-modal-bath="@n" onclick="setModalBathrooms('@n')"
                                    class="modal-bath-btn px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer">
                                @(n)+ WC
                            </button>
                        }
                    </div>
                </div>

                <!-- Hướng ban công -->
                <div>
                    <label class="block text-xs font-semibold text-neutral-700 mb-2">Hướng ban công</label>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" data-modal-balcony="" onclick="setModalBalcony('')"
                                class="modal-balcony-btn px-3 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer">
                            Tất cả hướng
                        </button>
                        @foreach (var dir in balconyOptions)
                        {
                            <button type="button" data-modal-balcony="@dir" onclick="setModalBalcony('@dir')"
                                    class="modal-balcony-btn px-3 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer">
                                @dir
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sticky Modal Footer -->
        <div class="px-5 py-3.5 border-t border-border bg-surface/80 flex items-center justify-between gap-3 shrink-0">
            <button type="button" onclick="resetModalFilters()"
                    class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-border bg-card text-xs font-semibold text-neutral-700 hover:border-destructive hover:text-destructive transition-colors cursor-pointer">
                <i data-lucide="rotate-ccw" class="size-3.5"></i>
                <span>Đặt lại tất cả</span>
            </button>
            <div class="flex items-center gap-2">
                <button type="button" onclick="closeAdvancedFilterModal()"
                        class="px-4 py-2 rounded-xl text-xs font-semibold text-muted-foreground hover:text-neutral-900 transition-colors cursor-pointer">
                    Hủy
                </button>
                <button type="button" onclick="applyModalFilters()"
                        class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-hover text-white text-xs font-bold shadow-sm transition-colors cursor-pointer">
                    <i data-lucide="search" class="size-3.5"></i>
                    <span>Áp dụng bộ lọc</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const INITIAL_STATE = @Html.Raw(initialFilterStateJson);

            const SALE_PRICE_PRESETS = [
                { label: 'Tất cả mức giá', min: '', max: '' },
                { label: 'Dưới 1 tỷ', min: '', max: '1000000000' },
                { label: '1 – 2 tỷ', min: '1000000000', max: '2000000000' },
                { label: '2 – 3 tỷ', min: '2000000000', max: '3000000000' },
                { label: '3 – 5 tỷ', min: '3000000000', max: '5000000000' },
                { label: '5 – 7 tỷ', min: '5000000000', max: '7000000000' },
                { label: '7 – 10 tỷ', min: '7000000000', max: '10000000000' },
                { label: '10 – 20 tỷ', min: '10000000000', max: '20000000000' },
                { label: 'Trên 20 tỷ', min: '20000000000', max: '' }
            ];

            const RENT_PRICE_PRESETS = [
                { label: 'Tất cả mức giá', min: '', max: '' },
                { label: 'Dưới 3 triệu', min: '', max: '3000000' },
                { label: '3 – 5 triệu', min: '3000000', max: '5000000' },
                { label: '5 – 10 triệu', min: '5000000', max: '10000000' },
                { label: '10 – 20 triệu', min: '10000000', max: '20000000' },
                { label: '20 – 40 triệu', min: '20000000', max: '40000000' },
                { label: 'Trên 40 triệu', min: '40000000', max: '' }
            ];

            const AREA_PRESETS = [
                { label: 'Tất cả diện tích', min: '', max: '' },
                { label: 'Dưới 30 m²', min: '', max: '30' },
                { label: '30 – 50 m²', min: '30', max: '50' },
                { label: '50 – 80 m²', min: '50', max: '80' },
                { label: '80 – 100 m²', min: '80', max: '100' },
                { label: '100 – 150 m²', min: '100', max: '150' },
                { label: '150 – 250 m²', min: '150', max: '250' },
                { label: 'Trên 250 m²', min: '250', max: '' }
            ];

            const modalDraft = {
                type: INITIAL_STATE.type || 'all',
                propertyType: INITIAL_STATE.propertyType || '',
                city: INITIAL_STATE.city || '',
                district: INITIAL_STATE.district || '',
                ward: INITIAL_STATE.ward || '',
                provinceCode: INITIAL_STATE.provinceCode != null ? String(INITIAL_STATE.provinceCode) : '',
                districtCode: INITIAL_STATE.districtCode != null ? String(INITIAL_STATE.districtCode) : '',
                wardCode: INITIAL_STATE.wardCode != null ? String(INITIAL_STATE.wardCode) : '',
                minPrice: INITIAL_STATE.minPrice != null ? String(INITIAL_STATE.minPrice) : '',
                maxPrice: INITIAL_STATE.maxPrice != null ? String(INITIAL_STATE.maxPrice) : '',
                minArea: INITIAL_STATE.minArea != null ? String(INITIAL_STATE.minArea) : '',
                maxArea: INITIAL_STATE.maxArea != null ? String(INITIAL_STATE.maxArea) : '',
                minBedrooms: INITIAL_STATE.minBedrooms != null ? String(INITIAL_STATE.minBedrooms) : '',
                minBathrooms: INITIAL_STATE.minBathrooms != null ? String(INITIAL_STATE.minBathrooms) : '',
                balconyDirection: INITIAL_STATE.balconyDirection || ''
            };

            let locationMode = INITIAL_STATE.districtCode ? 'pre' : 'post';
            const provinceCache = { post: null, pre: null };
            const districtCache = {};
            const wardCache = {};

            function formatVndShort(rawVal) {
                const n = Number(rawVal);
                if (!rawVal || !Number.isFinite(n) || n <= 0) return '';
                if (n >= 1_000_000_000) {
                    const b = n / 1_000_000_000;
                    return '= ' + b.toLocaleString('vi-VN', { maximumFractionDigits: 2 }) + ' tỷ VNĐ';
                }
                if (n >= 1_000_000) {
                    const m = n / 1_000_000;
                    return '= ' + m.toLocaleString('vi-VN', { maximumFractionDigits: 1 }) + ' triệu VNĐ';
                }
                return '= ' + n.toLocaleString('vi-VN') + ' đ';
            }

            window.updatePricePreview = function (inputId, hintId) {
                const inp = document.getElementById(inputId);
                const hint = document.getElementById(hintId);
                if (!inp || !hint) return;
                hint.textContent = formatVndShort(inp.value);
            };

            function submitCleanForm() {
                const form = document.getElementById('listingsFilterForm');
                if (!form) return;

                // Disable empty or default-only fields so URL query stays clean
                const fields = form.querySelectorAll('input[name]');
                fields.forEach(el => {
                    const val = (el.value || '').trim();
                    const isDefault =
                        val === '' ||
                        (el.name === 'type' && val === 'all') ||
                        (el.name === 'sortBy' && val === 'default') ||
                        (el.name === 'layout' && val === 'grid');
                    el.disabled = isDefault;
                });

                form.submit();
            }

            function closeAllPopovers() {
                document.querySelectorAll('.filter-popover').forEach(p => p.classList.add('hidden'));
                document.querySelectorAll('.popover-chevron').forEach(c => c.classList.remove('rotate-180'));
            }

            window.toggleFilterPopover = function (key, mobileModalSectionId) {
                // On mobile (< 768px), open the unified modal jumped directly to the matching section
                if (window.innerWidth < 768) {
                    openAdvancedFilterModal(mobileModalSectionId);
                    return;
                }

                const target = document.getElementById('popover-' + key);
                if (!target) return;
                const willOpen = target.classList.contains('hidden');
                closeAllPopovers();

                if (willOpen) {
                    target.classList.remove('hidden');
                    const group = document.querySelector(`[data-popover-root="${key}"]`);
                    const chevron = group ? group.querySelector('.popover-chevron') : null;
                    if (chevron) chevron.classList.add('rotate-180');

                    if (key === 'location') {
                        ensureProvincesLoaded(locationMode);
                    } else if (key === 'price') {
                        renderPopoverPricePresets();
                        updatePricePreview('popMinPrice', 'popMinPriceHint');
                        updatePricePreview('popMaxPrice', 'popMaxPriceHint');
                    } else if (key === 'area') {
                        renderPopoverAreaPresets();
                    }
                }
            };

            // Quick bar actions
            window.quickSetType = function (typeVal) {
                const currentType = document.getElementById('hfType').value;
                document.getElementById('hfType').value = typeVal;
                // Clear price range if switching between sale and rent so presets never mismatch
                if ((currentType === 'rent' && typeVal !== 'rent') || (currentType !== 'rent' && typeVal === 'rent')) {
                    document.getElementById('hfMinPrice').value = '';
                    document.getElementById('hfMaxPrice').value = '';
                }
                submitCleanForm();
            };

            window.clearKeywordAndSubmit = function () {
                const kw = document.getElementById('searchKeywordInput');
                if (kw) kw.value = '';
                submitCleanForm();
            };

            window.quickPickPropertyType = function (val) {
                document.getElementById('hfPropertyType').value = val;
                submitCleanForm();
            };

            window.quickPickBedrooms = function (val) {
                document.getElementById('hfMinBedrooms').value = val;
                submitCleanForm();
            };

            window.quickSetSort = function (val) {
                document.getElementById('hfSortBy').value = val;
                submitCleanForm();
            };

            window.quickPickCity = function (cityName) {
                document.getElementById('hfCity').value = cityName;
                document.getElementById('hfDistrict').value = '';
                document.getElementById('hfWard').value = '';
                document.getElementById('hfProvinceCode').value = '';
                document.getElementById('hfDistrictCode').value = '';
                document.getElementById('hfWardCode').value = '';
                submitCleanForm();
            };

            window.removeFilterChip = function (key) {
                if (key === 'q') {
                    const kw = document.getElementById('searchKeywordInput');
                    if (kw) kw.value = '';
                } else if (key === 'type') {
                    document.getElementById('hfType').value = 'all';
                } else if (key === 'propertyType') {
                    document.getElementById('hfPropertyType').value = '';
                } else if (key === 'location') {
                    ['hfCity', 'hfDistrict', 'hfWard', 'hfProvinceCode', 'hfDistrictCode', 'hfWardCode'].forEach(id => {
                        document.getElementById(id).value = '';
                    });
                } else if (key === 'price') {
                    document.getElementById('hfMinPrice').value = '';
                    document.getElementById('hfMaxPrice').value = '';
                } else if (key === 'area') {
                    document.getElementById('hfMinArea').value = '';
                    document.getElementById('hfMaxArea').value = '';
                } else if (key === 'minBedrooms') {
                    document.getElementById('hfMinBedrooms').value = '';
                } else if (key === 'minBathrooms') {
                    document.getElementById('hfMinBathrooms').value = '';
                } else if (key === 'balconyDirection') {
                    document.getElementById('hfBalconyDirection').value = '';
                }
                submitCleanForm();
            };

            // Popover Price & Area rendering
            function getPresetsForType(typeVal) {
                return typeVal === 'rent' ? RENT_PRICE_PRESETS : SALE_PRICE_PRESETS;
            }

            function renderPopoverPricePresets() {
                const container = document.getElementById('popPricePresets');
                if (!container) return;
                const activeMin = (document.getElementById('popMinPrice')?.value || '').trim();
                const activeMax = (document.getElementById('popMaxPrice')?.value || '').trim();
                const presets = getPresetsForType(document.getElementById('hfType').value);

                container.innerHTML = presets.map(p => {
                    const active = activeMin === p.min && activeMax === p.max;
                    return `<button type="button" onclick="pickPopoverPricePreset('${p.min}', '${p.max}')"
                        class="px-2.5 py-2 rounded-xl border text-xs text-left transition-colors cursor-pointer ${active ? 'border-primary bg-brand-soft/60 text-primary font-bold' : 'border-border bg-surface text-neutral-800 hover:border-primary/60 font-medium'}">${p.label}</button>`;
                }).join('');
            }

            window.pickPopoverPricePreset = function (min, max) {
                document.getElementById('hfMinPrice').value = min;
                document.getElementById('hfMaxPrice').value = max;
                submitCleanForm();
            };

            window.resetPricePopover = function () {
                document.getElementById('popMinPrice').value = '';
                document.getElementById('popMaxPrice').value = '';
                document.getElementById('hfMinPrice').value = '';
                document.getElementById('hfMaxPrice').value = '';
                submitCleanForm();
            };

            window.applyPricePopover = function () {
                document.getElementById('hfMinPrice').value = (document.getElementById('popMinPrice').value || '').trim();
                document.getElementById('hfMaxPrice').value = (document.getElementById('popMaxPrice').value || '').trim();
                submitCleanForm();
            };

