                    const active = activeMin === p.min && activeMax === p.max;
                    return `<button type="button" onclick="pickPopoverAreaPreset('${p.min}', '${p.max}')"
                        class="px-2.5 py-2 rounded-xl border text-xs text-left transition-colors cursor-pointer ${active ? 'border-primary bg-brand-soft/60 text-primary font-bold' : 'border-border bg-surface text-neutral-800 hover:border-primary/60 font-medium'}">${p.label}</button>`;
                }).join('');
            }

            window.pickPopoverAreaPreset = function (min, max) {
                document.getElementById('hfMinArea').value = min;
                document.getElementById('hfMaxArea').value = max;
                submitCleanForm();
            };

            window.resetAreaPopover = function () {
                document.getElementById('popMinArea').value = '';
                document.getElementById('popMaxArea').value = '';
                document.getElementById('hfMinArea').value = '';
                document.getElementById('hfMaxArea').value = '';
                submitCleanForm();
            };

            window.applyAreaPopover = function () {
                document.getElementById('hfMinArea').value = (document.getElementById('popMinArea').value || '').trim();
                document.getElementById('hfMaxArea').value = (document.getElementById('popMaxArea').value || '').trim();
                submitCleanForm();
            };

            // Location loading & syncing (Popover + Modal)
            function updateLocationModeButtons() {
                const pairs = [
                    ['popLocModePost', 'popLocModePre', 'popDistrictWrap'],
                    ['modalLocModePost', 'modalLocModePre', 'modalDistrictWrap']
                ];
                pairs.forEach(([postId, preId, distWrapId]) => {
                    const btnPost = document.getElementById(postId);
                    const btnPre = document.getElementById(preId);
                    const distWrap = document.getElementById(distWrapId);
                    if (btnPost && btnPre) {
                        if (locationMode === 'post') {
                            btnPost.className = 'px-2 py-1 rounded-md bg-primary text-white transition-colors cursor-pointer';
                            btnPre.className = 'px-2 py-1 rounded-md text-neutral-600 hover:text-neutral-900 transition-colors cursor-pointer';
                        } else {
                            btnPre.className = 'px-2 py-1 rounded-md bg-primary text-white transition-colors cursor-pointer';
                            btnPost.className = 'px-2 py-1 rounded-md text-neutral-600 hover:text-neutral-900 transition-colors cursor-pointer';
                        }
                    }
                    if (distWrap) {
                        distWrap.classList.toggle('hidden', locationMode === 'post');
                    }
                });
            }

            window.switchLocationMode = async function (mode) {
                if (mode !== 'post' && mode !== 'pre') return;
                locationMode = mode;
                updateLocationModeButtons();
                await ensureProvincesLoaded(mode);
            };

            async function ensureProvincesLoaded(mode) {
                updateLocationModeButtons();
                if (!provinceCache[mode]) {
                    try {
                        const res = await fetch('/listings/locations/provinces?mode=' + encodeURIComponent(mode));
                        if (res.ok) {
                            provinceCache[mode] = await res.json();
                        }
                    } catch {
                        provinceCache[mode] = [];
                    }
                }
                const list = provinceCache[mode] || [];
                populateProvinceSelect('popProvinceSelect', list, document.getElementById('hfProvinceCode').value, document.getElementById('hfCity').value);
                populateProvinceSelect('modalProvinceSelect', list, modalDraft.provinceCode, modalDraft.city);
            }

            function populateProvinceSelect(selectId, list, selectedCode, selectedName) {
                const sel = document.getElementById(selectId);
                if (!sel) return;
                sel.innerHTML = '<option value="">Toàn quốc</option>' + list.map(p => {
                    const code = String(p.code ?? p.Code ?? '');
                    const name = String(p.name ?? p.Name ?? '');
                    const isSel = (selectedCode && code === String(selectedCode))
                        || (!selectedCode && selectedName && name.toLowerCase() === selectedName.toLowerCase());
                    return `<option value="${code}" data-name="${escapeAttr(name)}" ${isSel ? 'selected' : ''}>${escapeHtml(name)}</option>`;
                }).join('');

                if (sel.value) {
                    handleProvinceChange(selectId, sel.value, true);
                }
            }

            async function handleProvinceChange(selectId, provinceCode, preserveChildren) {
                const isModal = selectId.startsWith('modal');
                const distSel = document.getElementById(isModal ? 'modalDistrictSelect' : 'popDistrictSelect');
                const wardSel = document.getElementById(isModal ? 'modalWardSelect' : 'popWardSelect');
                const provSel = document.getElementById(selectId);
                const selectedOpt = provSel ? provSel.options[provSel.selectedIndex] : null;
                const provName = selectedOpt ? (selectedOpt.getAttribute('data-name') || '') : '';

                if (isModal) {
                    modalDraft.provinceCode = provinceCode || '';
                    modalDraft.city = provName;
                    const mCity = document.getElementById('modalCityManual');
                    if (mCity) mCity.value = provName;
                    if (!preserveChildren) {
                        modalDraft.districtCode = '';
                        modalDraft.district = '';
                        modalDraft.wardCode = '';
                        modalDraft.ward = '';
                        const mDist = document.getElementById('modalDistrictManual');
                        const mWard = document.getElementById('modalWardManual');
                        if (mDist) mDist.value = '';
                        if (mWard) mWard.value = '';
                    }
                } else {
                    const pCity = document.getElementById('popCityManual');
                    if (pCity) pCity.value = provName;
                    if (!preserveChildren) {
                        const pDist = document.getElementById('popDistrictManual');
                        if (pDist) pDist.value = '';
                    }
                }

                if (distSel) distSel.innerHTML = '<option value="">Tất cả quận / huyện</option>';
                if (wardSel) wardSel.innerHTML = '<option value="">Tất cả phường / xã</option>';

                if (!provinceCode) return;

                if (locationMode === 'pre') {
                    if (!districtCache[provinceCode]) {
                        try {
                            const res = await fetch(`/listings/locations/provinces/${encodeURIComponent(provinceCode)}/districts`);
                            districtCache[provinceCode] = res.ok ? await res.json() : [];
                        } catch {
                            districtCache[provinceCode] = [];
                        }
                    }
                    const dList = districtCache[provinceCode] || [];
                    const targetDistCode = isModal ? modalDraft.districtCode : document.getElementById('hfDistrictCode').value;
                    const targetDistName = isModal ? modalDraft.district : document.getElementById('hfDistrict').value;
                    if (distSel) {
                        distSel.innerHTML = '<option value="">Tất cả quận / huyện</option>' + dList.map(d => {
                            const code = String(d.code ?? d.Code ?? '');
                            const name = String(d.name ?? d.Name ?? '');
                            const isSel = preserveChildren && ((targetDistCode && code === String(targetDistCode))
                                || (!targetDistCode && targetDistName && name.toLowerCase() === targetDistName.toLowerCase()));
                            return `<option value="${code}" data-name="${escapeAttr(name)}" ${isSel ? 'selected' : ''}>${escapeHtml(name)}</option>`;
                        }).join('');
                        if (distSel.value) {
                            await handleDistrictChange(distSel.id, distSel.value, preserveChildren);
                        }
                    }
                } else {
                    const cacheKey = 'p_' + provinceCode;
                    if (!wardCache[cacheKey]) {
                        try {
                            const res = await fetch(`/listings/locations/provinces/${encodeURIComponent(provinceCode)}/wards`);
                            wardCache[cacheKey] = res.ok ? await res.json() : [];
                        } catch {
                            wardCache[cacheKey] = [];
                        }
                    }
                    fillWardOptions(wardSel, wardCache[cacheKey] || [], isModal, preserveChildren);
                }
            }

            async function handleDistrictChange(selectId, districtCode, preserveWard) {
                const isModal = selectId.startsWith('modal');
                const distSel = document.getElementById(selectId);
                const wardSel = document.getElementById(isModal ? 'modalWardSelect' : 'popWardSelect');
                const selectedOpt = distSel ? distSel.options[distSel.selectedIndex] : null;
                const distName = selectedOpt ? (selectedOpt.getAttribute('data-name') || '') : '';

                if (isModal) {
                    modalDraft.districtCode = districtCode || '';
                    modalDraft.district = distName;
                    const mDist = document.getElementById('modalDistrictManual');
                    if (mDist) mDist.value = distName;
                    if (!preserveWard) {
                        modalDraft.wardCode = '';
                        modalDraft.ward = '';
                        const mWard = document.getElementById('modalWardManual');
                        if (mWard) mWard.value = '';
                    }
                } else {
                    const pDist = document.getElementById('popDistrictManual');
                    if (pDist) pDist.value = distName;
                }

                if (wardSel) wardSel.innerHTML = '<option value="">Tất cả phường / xã</option>';
                if (!districtCode) return;

                const cacheKey = 'd_' + districtCode;
                if (!wardCache[cacheKey]) {
                    try {
                        const res = await fetch(`/listings/locations/districts/${encodeURIComponent(districtCode)}/wards`);
                        wardCache[cacheKey] = res.ok ? await res.json() : [];
                    } catch {
                        wardCache[cacheKey] = [];
                    }
                }
                fillWardOptions(wardSel, wardCache[cacheKey] || [], isModal, preserveWard);
            }

            function fillWardOptions(wardSel, list, isModal, preserveWard) {
                if (!wardSel) return;
                const targetWardCode = isModal ? modalDraft.wardCode : document.getElementById('hfWardCode').value;
                const targetWardName = isModal ? modalDraft.ward : document.getElementById('hfWard').value;
                wardSel.innerHTML = '<option value="">Tất cả phường / xã</option>' + list.map(w => {
                    const code = String(w.code ?? w.Code ?? '');
                    const name = String(w.name ?? w.Name ?? '');
                    const isSel = preserveWard && ((targetWardCode && code === String(targetWardCode))
                        || (!targetWardCode && targetWardName && name.toLowerCase() === targetWardName.toLowerCase()));
                    return `<option value="${code}" data-name="${escapeAttr(name)}" ${isSel ? 'selected' : ''}>${escapeHtml(name)}</option>`;
                }).join('');
            }

            window.resetLocationPopover = function () {
                ['hfCity', 'hfDistrict', 'hfWard', 'hfProvinceCode', 'hfDistrictCode', 'hfWardCode'].forEach(id => {
                    document.getElementById(id).value = '';
                });
                submitCleanForm();
            };

            window.applyLocationPopover = function () {
                const provSel = document.getElementById('popProvinceSelect');
                const distSel = document.getElementById('popDistrictSelect');
                const wardSel = document.getElementById('popWardSelect');
                const cityManual = (document.getElementById('popCityManual')?.value || '').trim();
                const distManual = (document.getElementById('popDistrictManual')?.value || '').trim();

                const provOpt = provSel && provSel.value ? provSel.options[provSel.selectedIndex] : null;
                const distOpt = distSel && distSel.value ? distSel.options[distSel.selectedIndex] : null;
                const wardOpt = wardSel && wardSel.value ? wardSel.options[wardSel.selectedIndex] : null;

                document.getElementById('hfProvinceCode').value = provSel?.value || '';
                document.getElementById('hfCity').value = cityManual || (provOpt?.getAttribute('data-name') || '');
                document.getElementById('hfDistrictCode').value = locationMode === 'pre' ? (distSel?.value || '') : '';
                document.getElementById('hfDistrict').value = distManual || (distOpt?.getAttribute('data-name') || '');
                document.getElementById('hfWardCode').value = wardSel?.value || '';
                document.getElementById('hfWard').value = wardOpt?.getAttribute('data-name') || '';

                submitCleanForm();
            };

            // Advanced Filter Modal lifecycle
            window.openAdvancedFilterModal = function (scrollToSectionId) {
                closeAllPopovers();
                const modal = document.getElementById('advancedFilterModal');
                if (!modal) return;

                // Hydrate modal draft from authoritative hidden inputs
                modalDraft.type = document.getElementById('hfType').value || 'all';
                modalDraft.propertyType = document.getElementById('hfPropertyType').value || '';
                modalDraft.city = document.getElementById('hfCity').value || '';
                modalDraft.district = document.getElementById('hfDistrict').value || '';
                modalDraft.ward = document.getElementById('hfWard').value || '';
                modalDraft.provinceCode = document.getElementById('hfProvinceCode').value || '';
                modalDraft.districtCode = document.getElementById('hfDistrictCode').value || '';
                modalDraft.wardCode = document.getElementById('hfWardCode').value || '';
                modalDraft.minPrice = document.getElementById('hfMinPrice').value || '';
                modalDraft.maxPrice = document.getElementById('hfMaxPrice').value || '';
                modalDraft.minArea = document.getElementById('hfMinArea').value || '';
                modalDraft.maxArea = document.getElementById('hfMaxArea').value || '';
                modalDraft.minBedrooms = document.getElementById('hfMinBedrooms').value || '';
                modalDraft.minBathrooms = document.getElementById('hfMinBathrooms').value || '';
                modalDraft.balconyDirection = document.getElementById('hfBalconyDirection').value || '';

                syncModalUI();
                ensureProvincesLoaded(locationMode);

                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';

                if (scrollToSectionId) {
                    setTimeout(() => {
                        const section = document.getElementById(scrollToSectionId);
                        if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 60);
                }
            };

            window.closeAdvancedFilterModal = function () {
                const modal = document.getElementById('advancedFilterModal');
                if (!modal) return;
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.style.overflow = '';
            };

            function syncModalUI() {
                document.querySelectorAll('.modal-type-btn').forEach(btn => {
                    const active = btn.getAttribute('data-modal-type') === modalDraft.type;
                    btn.className = 'modal-type-btn h-9 rounded-xl border text-xs font-semibold transition-all cursor-pointer ' +
                        (active ? 'border-primary bg-primary text-white shadow-2xs' : 'border-border bg-surface text-neutral-800 hover:border-primary/60');
                });

                document.querySelectorAll('.modal-prop-btn').forEach(btn => {
                    const active = btn.getAttribute('data-modal-prop') === modalDraft.propertyType;
                    btn.className = 'modal-prop-btn flex items-center gap-2 px-3 py-2.5 rounded-xl border text-xs text-left transition-all cursor-pointer ' +
                        (active ? 'border-primary bg-brand-soft/60 text-primary font-bold shadow-2xs' : 'border-border bg-surface text-neutral-800 hover:border-primary/60 font-medium');
                });

                document.getElementById('modalCityManual').value = modalDraft.city;
                document.getElementById('modalDistrictManual').value = modalDraft.district;
                document.getElementById('modalWardManual').value = modalDraft.ward;

                document.getElementById('modalMinPrice').value = modalDraft.minPrice;
                document.getElementById('modalMaxPrice').value = modalDraft.maxPrice;
                updatePricePreview('modalMinPrice', 'modalMinPriceHint');
                updatePricePreview('modalMaxPrice', 'modalMaxPriceHint');

                const priceCtx = document.getElementById('modalPriceContextLabel');
                if (priceCtx) {
                    priceCtx.textContent = modalDraft.type === 'rent' ? 'Giá thuê / tháng (VNĐ)' : 'Giá bán (VNĐ)';
                }

                renderModalPricePresets();

                document.getElementById('modalMinArea').value = modalDraft.minArea;
                document.getElementById('modalMaxArea').value = modalDraft.maxArea;
                renderModalAreaPresets();

                document.querySelectorAll('.modal-bed-btn').forEach(btn => {
                    const active = btn.getAttribute('data-modal-bed') === modalDraft.minBedrooms;
                    btn.className = 'modal-bed-btn px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer ' +
                        (active ? 'border-primary bg-primary text-white shadow-2xs' : 'border-border bg-surface text-neutral-800 hover:border-primary/60');
                });

                document.querySelectorAll('.modal-bath-btn').forEach(btn => {
                    const active = btn.getAttribute('data-modal-bath') === modalDraft.minBathrooms;
                    btn.className = 'modal-bath-btn px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer ' +
                        (active ? 'border-primary bg-primary text-white shadow-2xs' : 'border-border bg-surface text-neutral-800 hover:border-primary/60');
                });

                document.querySelectorAll('.modal-balcony-btn').forEach(btn => {
                    const active = btn.getAttribute('data-modal-balcony') === modalDraft.balconyDirection;
                    btn.className = 'modal-balcony-btn px-3 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer ' +
                        (active ? 'border-primary bg-primary text-white shadow-2xs' : 'border-border bg-surface text-neutral-800 hover:border-primary/60');
                });
            }

            function renderModalPricePresets() {
                const container = document.getElementById('modalPricePresets');
                if (!container) return;
                const presets = getPresetsForType(modalDraft.type);
                container.innerHTML = presets.map(p => {
                    const active = modalDraft.minPrice === p.min && modalDraft.maxPrice === p.max;
                    return `<button type="button" onclick="pickModalPricePreset('${p.min}', '${p.max}')"
                        class="px-3 py-1.5 rounded-xl border text-xs transition-all cursor-pointer ${active ? 'border-primary bg-brand-soft/60 text-primary font-bold' : 'border-border bg-surface text-neutral-800 hover:border-primary/60 font-medium'}">${p.label}</button>`;
                }).join('');
            }

            function renderModalAreaPresets() {
                const container = document.getElementById('modalAreaPresets');
                if (!container) return;
                container.innerHTML = AREA_PRESETS.map(p => {
                    const active = modalDraft.minArea === p.min && modalDraft.maxArea === p.max;
                    return `<button type="button" onclick="pickModalAreaPreset('${p.min}', '${p.max}')"
                        class="px-3 py-1.5 rounded-xl border text-xs transition-all cursor-pointer ${active ? 'border-primary bg-brand-soft/60 text-primary font-bold' : 'border-border bg-surface text-neutral-800 hover:border-primary/60 font-medium'}">${p.label}</button>`;
                }).join('');
            }

            window.setModalType = function (val) {
                if ((modalDraft.type === 'rent' && val !== 'rent') || (modalDraft.type !== 'rent' && val === 'rent')) {
                    modalDraft.minPrice = '';
                    modalDraft.maxPrice = '';
                }
                modalDraft.type = val;
                syncModalUI();
            };

            window.setModalPropertyType = function (val) {
                modalDraft.propertyType = val;
                syncModalUI();
            };

            window.pickModalPricePreset = function (min, max) {
                modalDraft.minPrice = min;
                modalDraft.maxPrice = max;
                syncModalUI();
            };

            window.syncModalPriceFromInput = function () {
                modalDraft.minPrice = (document.getElementById('modalMinPrice').value || '').trim();
                modalDraft.maxPrice = (document.getElementById('modalMaxPrice').value || '').trim();
                updatePricePreview('modalMinPrice', 'modalMinPriceHint');
                updatePricePreview('modalMaxPrice', 'modalMaxPriceHint');
                renderModalPricePresets();
            };

            window.pickModalAreaPreset = function (min, max) {
                modalDraft.minArea = min;
                modalDraft.maxArea = max;
                syncModalUI();
            };

            window.syncModalAreaFromInput = function () {
                modalDraft.minArea = (document.getElementById('modalMinArea').value || '').trim();
                modalDraft.maxArea = (document.getElementById('modalMaxArea').value || '').trim();
                renderModalAreaPresets();
            };

            window.setModalBedrooms = function (val) {
                modalDraft.minBedrooms = val;
                syncModalUI();
            };

            window.setModalBathrooms = function (val) {
                modalDraft.minBathrooms = val;
                syncModalUI();
            };

            window.setModalBalcony = function (val) {
                modalDraft.balconyDirection = val;
                syncModalUI();
            };

            window.resetModalFilters = function () {
                modalDraft.type = 'all';
                modalDraft.propertyType = '';
                modalDraft.city = '';
                modalDraft.district = '';
                modalDraft.ward = '';
                modalDraft.provinceCode = '';
                modalDraft.districtCode = '';
                modalDraft.wardCode = '';
                modalDraft.minPrice = '';
                modalDraft.maxPrice = '';
                modalDraft.minArea = '';
                modalDraft.maxArea = '';
                modalDraft.minBedrooms = '';
                modalDraft.minBathrooms = '';
                modalDraft.balconyDirection = '';

                const pSel = document.getElementById('modalProvinceSelect');
                const dSel = document.getElementById('modalDistrictSelect');
                const wSel = document.getElementById('modalWardSelect');
                if (pSel) pSel.value = '';
                if (dSel) dSel.innerHTML = '<option value="">Tất cả quận / huyện</option>';
                if (wSel) wSel.innerHTML = '<option value="">Tất cả phường / xã</option>';

                syncModalUI();
            };

            window.applyModalFilters = function () {
                const cityManual = (document.getElementById('modalCityManual')?.value || '').trim();
                const distManual = (document.getElementById('modalDistrictManual')?.value || '').trim();
                const wardManual = (document.getElementById('modalWardManual')?.value || '').trim();
                const wardSel = document.getElementById('modalWardSelect');
                const wardOpt = wardSel && wardSel.value ? wardSel.options[wardSel.selectedIndex] : null;

                document.getElementById('hfType').value = modalDraft.type;
                document.getElementById('hfPropertyType').value = modalDraft.propertyType;
                document.getElementById('hfProvinceCode').value = modalDraft.provinceCode;
                document.getElementById('hfCity').value = cityManual || modalDraft.city;
                document.getElementById('hfDistrictCode').value = locationMode === 'pre' ? modalDraft.districtCode : '';
                document.getElementById('hfDistrict').value = distManual || modalDraft.district;
                document.getElementById('hfWardCode').value = wardSel?.value || modalDraft.wardCode;
                document.getElementById('hfWard').value = wardManual || (wardOpt?.getAttribute('data-name') || modalDraft.ward);
                document.getElementById('hfMinPrice').value = modalDraft.minPrice;
                document.getElementById('hfMaxPrice').value = modalDraft.maxPrice;
                document.getElementById('hfMinArea').value = modalDraft.minArea;
                document.getElementById('hfMaxArea').value = modalDraft.maxArea;
                document.getElementById('hfMinBedrooms').value = modalDraft.minBedrooms;
                document.getElementById('hfMinBathrooms').value = modalDraft.minBathrooms;
                document.getElementById('hfBalconyDirection').value = modalDraft.balconyDirection;

                closeAdvancedFilterModal();
                submitCleanForm();
            };

            function escapeHtml(str) {
                return String(str || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function escapeAttr(str) {
                return escapeHtml(str).replace(/'/g, '&#39;');
            }

            // Event wiring
            document.addEventListener('DOMContentLoaded', function () {
                const form = document.getElementById('listingsFilterForm');
                if (form) {
                    form.addEventListener('submit', function (e) {
                        e.preventDefault();
                        submitCleanForm();
                    });
                }

                // Wire cascading dropdowns
                document.getElementById('popProvinceSelect')?.addEventListener('change', e => handleProvinceChange('popProvinceSelect', e.target.value, false));
                document.getElementById('popDistrictSelect')?.addEventListener('change', e => handleDistrictChange('popDistrictSelect', e.target.value, false));
                document.getElementById('modalProvinceSelect')?.addEventListener('change', e => handleProvinceChange('modalProvinceSelect', e.target.value, false));
                document.getElementById('modalDistrictSelect')?.addEventListener('change', e => handleDistrictChange('modalDistrictSelect', e.target.value, false));
                document.getElementById('modalWardSelect')?.addEventListener('change', e => {
                    const opt = e.target.options[e.target.selectedIndex];
                    modalDraft.wardCode = e.target.value || '';
                    modalDraft.ward = opt ? (opt.getAttribute('data-name') || '') : '';
                    const mWard = document.getElementById('modalWardManual');
                    if (mWard) mWard.value = modalDraft.ward;
                });

                // Clear province/district code if user manually edits text inputs
                document.getElementById('popCityManual')?.addEventListener('input', () => {
                    const pSel = document.getElementById('popProvinceSelect');
                    if (pSel) pSel.value = '';
                });
                document.getElementById('popDistrictManual')?.addEventListener('input', () => {
                    const dSel = document.getElementById('popDistrictSelect');
                    if (dSel) dSel.value = '';
                });
                document.getElementById('modalCityManual')?.addEventListener('input', e => {
                    modalDraft.city = e.target.value.trim();
                    modalDraft.provinceCode = '';
                    const pSel = document.getElementById('modalProvinceSelect');
                    if (pSel) pSel.value = '';
                });
                document.getElementById('modalDistrictManual')?.addEventListener('input', e => {
                    modalDraft.district = e.target.value.trim();
                    modalDraft.districtCode = '';
                    const dSel = document.getElementById('modalDistrictSelect');
                    if (dSel) dSel.value = '';
                });
                document.getElementById('modalWardManual')?.addEventListener('input', e => {
                    modalDraft.ward = e.target.value.trim();
                    modalDraft.wardCode = '';
                    const wSel = document.getElementById('modalWardSelect');
                    if (wSel) wSel.value = '';
                });

                // Close popovers when clicking outside
                document.addEventListener('click', function (e) {
                    if (!e.target.closest('.filter-popover-group')) {
                        closeAllPopovers();
                    }
                });

                // Close modal on backdrop click or ESC
                const modal = document.getElementById('advancedFilterModal');
                if (modal) {
                    modal.addEventListener('click', function (e) {
                        if (e.target === modal) {
                            closeAdvancedFilterModal();
                        }
                    });
                }

                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        closeAllPopovers();
                        closeAdvancedFilterModal();
                    }
                });
            });
        })();
    </script>
}
