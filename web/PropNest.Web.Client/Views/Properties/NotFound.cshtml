@{
    ViewData["Title"] = "Không tìm thấy bất động sản";
    var notFoundId = ViewData["NotFoundId"]?.ToString();
}

<div class="mx-auto max-w-2xl px-4 py-24 text-center space-y-5">
    <div class="mx-auto grid size-16 place-items-center rounded-full bg-brand-soft text-primary">
        <i data-lucide="search-x" class="size-8"></i>
    </div>
    <h1 class="font-display text-3xl font-bold text-neutral-900">Không tìm thấy bất động sản</h1>
    <p class="text-xs text-muted-foreground max-w-md mx-auto leading-relaxed">
        Tin đăng @(notFoundId != null ? $"mã \"{notFoundId}\"" : "") hiện chưa được xuất bản công khai hoặc đường dẫn không còn tồn tại trên hệ thống PropNest.
    </p>
    <div class="flex items-center justify-center gap-3 pt-2">
        <a asp-controller="Listings" asp-action="Index"
           class="rounded-full bg-primary px-6 py-2.5 text-xs font-semibold text-white shadow-xs hover:bg-primary-hover transition-colors">
            Khám phá danh sách BĐS
        </a>
        <a href="https://localhost:7006/"
           class="rounded-full border border-border bg-card px-5 py-2.5 text-xs font-semibold text-neutral-800 hover:border-primary transition-colors">
            Xem trong Cổng Người bán
        </a>
    </div>
</div>
