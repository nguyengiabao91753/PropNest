@model PropNest.Web.Client.Models.ViewModels.PropertyDetailViewModel

@{
    var p = Model.Property;
    ViewData["Title"] = p.Title;

    // Split title into lead and accent
    var words = p.Title.Split(' ');
    var lead = words.Length > 2 ? string.Join(" ", words.Take(words.Length - 1)) : p.Title;
    var accent = words.Length > 2 ? words.Last() : "";
}

<div class="space-y-12 pb-20">
    <!-- SECTION 1: Detail Hero Banner -->
    <section class="relative border-b border-border bg-card">
        <div class="mx-auto grid max-w-7xl border-x border-border md:grid-cols-2">
            <!-- Left Header -->
            <div class="flex flex-col justify-between gap-8 border-b border-border p-6 md:p-12">
                <div class="space-y-3">
                    <p class="text-xs uppercase font-bold tracking-wider text-primary">
                        @p.PropertyType · @(p.ListingType == "rent" ? "Cho thuê" : "Cần bán")
                    </p>
                    <h1 class="font-display text-4xl md:text-5xl font-bold leading-tight text-neutral-900">
                        @lead <br />
                        <em class="font-medium text-primary">@accent</em>
                    </h1>
                </div>

                <div class="flex items-center gap-3">
                    <a href="#inquiryForm"
                       class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-xs font-semibold text-white shadow-lg shadow-primary/25 hover:bg-primary-hover transition-colors">
                        <span>Liên hệ người bán</span>
                        <i data-lucide="arrow-up-right" class="size-4"></i>
                    </a>
                    <button type="button"
                            data-fav-id="@p.Id"
                            onclick="toggleFavorite('@p.Id')"
                            class="grid size-11 place-items-center rounded-full border border-border bg-surface text-muted-foreground hover:text-primary transition-colors">
                        <i data-lucide="heart" class="size-5"></i>
                    </button>
                </div>
            </div>

            <!-- Right Seller & Price -->
            <div class="flex flex-col justify-between gap-8 border-b border-border p-6 text-right md:border-l md:p-12">
                <div class="flex items-center justify-end gap-3">
                    <div>
                        <div class="flex justify-end gap-0.5 text-amber-500 text-xs">
                            @for (var i = 0; i < 5; i++)
                            {
                                <i data-lucide="star" class="size-4 fill-amber-500 text-amber-500"></i>
                            }
                        </div>
                        <p class="mt-1 text-xs font-semibold text-neutral-900">@p.SellerName</p>
                        <p class="text-[10px] text-muted-foreground">Người đăng tin (Chính chủ/Môi giới)</p>
                    </div>
                    <div class="relative size-12 overflow-hidden rounded-full border border-border bg-primary/10 shrink-0">
                        <img src="@p.SellerAvatar" alt="@p.SellerName" class="size-full object-cover" />
                    </div>
                </div>

                <dl class="flex justify-end gap-8 text-left">
                    <div>
                        <dt class="text-xs text-muted-foreground mb-1">
                            @(p.ListingType == "rent" ? "Giá thuê / tháng" : "Giá niêm yết")
                        </dt>
                        <dd class="font-display text-3xl font-extrabold text-primary">
                            @FormatHelper.FormatPrice(p.Price, p.ListingType)
                        </dd>
                    </div>
                    <div class="border-l border-border/80 pl-8">
                        <dt class="text-xs text-muted-foreground mb-1">Diện tích sử dụng</dt>
                        <dd class="font-display text-3xl font-extrabold text-neutral-900">
                            @FormatHelper.FormatArea(p.Area)
                        </dd>
                    </div>
                </dl>
            </div>

            <!-- Bottom Left: Address & Thumbnails -->
            <div class="flex flex-col justify-between gap-6 p-6 md:p-12">
                <p class="max-w-md text-xs leading-relaxed text-muted-foreground">
                    📍 @p.PublicAddress
                </p>

                <!-- Small Round Image Switcher -->
                <div class="flex items-center -space-x-2" role="group" aria-label="Thư viện ảnh">
                    @for (var i = 0; i < p.Images.Count; i++)
                    {
                        var img = p.Images[i];
                        var idx = i;
                        <button type="button" onclick="setHeroActiveImage('@img', @idx)"
                                class="hero-thumb relative size-12 overflow-hidden rounded-full border-2 border-card shadow-sm hover:z-10 hover:scale-110 transition-transform @(i == 0 ? "border-primary ring-2 ring-primary/40 z-10" : "")">
                            <img src="@img" alt="Ảnh thu nhỏ" class="size-full object-cover" />
                        </button>
                    }
                </div>
            </div>

            <!-- Bottom Right: Share & Scroll Button -->
            <div class="flex items-center justify-end gap-4 p-6 md:border-l md:border-border md:p-12">
                <a href="#detailsSection" class="p-3 rounded-full border border-border bg-surface text-muted-foreground hover:text-primary transition-colors" title="Cuộn xuống xem chi tiết">
                    <i data-lucide="arrow-down" class="size-5"></i>
                </a>
                <button type="button" onclick="copyShareLink()"
                        class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2.5 text-xs font-semibold text-neutral-800 hover:border-primary hover:text-primary shadow-xs transition-colors"
                        title="Sao chép liên kết chia sẻ">
                    <i data-lucide="share-2" class="size-4 text-primary"></i>
                    <span>Chia sẻ tin</span>
                </button>
            </div>
        </div>

        <!-- Center Round Featured Image Showcase (Desktop) -->
        <div class="pointer-events-none absolute inset-x-0 top-1/2 hidden -translate-y-1/2 justify-center md:flex">
            <div class="pointer-events-auto relative h-[30rem] w-[22rem]">
                <div class="relative size-full overflow-hidden rounded-full border-4 border-card shadow-2xl bg-neutral-100">
                    <img id="mainHeroImg" src="@p.PrimaryImage" alt="@p.Title" class="size-full object-cover transition-opacity duration-300" />
                </div>
                <button type="button" onclick="nextHeroImage()"
                        class="absolute -right-6 bottom-20 grid size-16 place-items-center rounded-full bg-primary text-white shadow-xl hover:scale-110 hover:rotate-45 transition-all">
                    <i data-lucide="arrow-up-right" class="size-7"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- SECTION 2: Body Details & Inquiry Form -->
    <div id="detailsSection" class="mx-auto max-w-7xl px-4 md:px-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_380px]">
        <!-- Left Column: Specs, Desc, Facilities, Gallery, Map -->
        <div class="space-y-10">
            <!-- 8 Key Specs Grid -->
            <section class="space-y-4">
                <h2 class="font-display text-2xl font-bold text-neutral-900">Tổng quan bất động sản</h2>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    <div class="flex items-center gap-3 rounded-xl border border-border bg-card p-3.5 shadow-2xs">
                        <span class="grid size-9 place-items-center rounded-full bg-brand-soft text-primary shrink-0">
                            <i data-lucide="bed-double" class="size-4"></i>
                        </span>
                        <div>
                            <p class="text-[11px] text-muted-foreground">Phòng ngủ</p>
                            <p class="text-xs font-bold text-neutral-900">@p.Beds PN</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-border bg-card p-3.5 shadow-2xs">
                        <span class="grid size-9 place-items-center rounded-full bg-brand-soft text-primary shrink-0">
                            <i data-lucide="bath" class="size-4"></i>
                        </span>
                        <div>
                            <p class="text-[11px] text-muted-foreground">Phòng tắm</p>
                            <p class="text-xs font-bold text-neutral-900">@p.Baths WC</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-border bg-card p-3.5 shadow-2xs">
                        <span class="grid size-9 place-items-center rounded-full bg-brand-soft text-primary shrink-0">
                            <i data-lucide="car" class="size-4"></i>
                        </span>
                        <div>
                            <p class="text-[11px] text-muted-foreground">Chỗ đỗ xe</p>
                            <p class="text-xs font-bold text-neutral-900">@p.Carports chỗ</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-border bg-card p-3.5 shadow-2xs">
                        <span class="grid size-9 place-items-center rounded-full bg-brand-soft text-primary shrink-0">
                            <i data-lucide="ruler" class="size-4"></i>
                        </span>
                        <div>
                            <p class="text-[11px] text-muted-foreground">Diện tích SD</p>
                            <p class="text-xs font-bold text-neutral-900">@FormatHelper.FormatArea(p.Area)</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-border bg-card p-3.5 shadow-2xs">
                        <span class="grid size-9 place-items-center rounded-full bg-brand-soft text-primary shrink-0">
                            <i data-lucide="trees" class="size-4"></i>
                        </span>
                        <div>
                            <p class="text-[11px] text-muted-foreground">Diện tích đất</p>
                            <p class="text-xs font-bold text-neutral-900">@FormatHelper.FormatArea(p.LandSize)</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-border bg-card p-3.5 shadow-2xs">
                        <span class="grid size-9 place-items-center rounded-full bg-brand-soft text-primary shrink-0">
                            <i data-lucide="home" class="size-4"></i>
                        </span>
                        <div>
                            <p class="text-[11px] text-muted-foreground">Loại hình BĐS</p>
                            <p class="text-xs font-bold text-neutral-900">@p.PropertyType</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-border bg-card p-3.5 shadow-2xs">
                        <span class="grid size-9 place-items-center rounded-full bg-brand-soft text-primary shrink-0">
                            <i data-lucide="sparkles" class="size-4"></i>
                        </span>
                        <div>
                            <p class="text-[11px] text-muted-foreground">Tình trạng</p>
                            <p class="text-xs font-bold text-neutral-900 truncate">@p.Condition</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-border bg-card p-3.5 shadow-2xs">
                        <span class="grid size-9 place-items-center rounded-full bg-brand-soft text-primary shrink-0">
                            <i data-lucide="calendar" class="size-4"></i>
                        </span>
                        <div>
                            <p class="text-[11px] text-muted-foreground">Ngày đăng</p>
                            <p class="text-xs font-bold text-neutral-900">@p.CreatedAt.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Detailed Description -->
            <section class="space-y-3">
                <h2 class="font-display text-2xl font-bold text-neutral-900">Mô tả chi tiết</h2>
                <div class="rounded-2xl border border-border bg-card p-6 text-xs text-neutral-800 leading-relaxed shadow-xs space-y-3">
                    <p class="whitespace-pre-line">@p.Description</p>
                </div>
            </section>

            <!-- Facilities Checklist -->
            @if (p.Facilities.Count > 0)
            {
                <section class="space-y-3">
                    <h2 class="font-display text-2xl font-bold text-neutral-900">Tiện ích nổi bật</h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var f in p.Facilities)
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-4 py-2 text-xs font-medium text-neutral-800 shadow-2xs">
                                <i data-lucide="check" class="size-3.5 text-primary"></i>
                                <span>@f</span>
                            </span>
                        }
                    </div>
                </section>
            }

            <!-- Real Photos Gallery Grid -->
            <section class="space-y-3">
                <h2 class="font-display text-2xl font-bold text-neutral-900">Hình ảnh thực tế</h2>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                    @for (var i = 0; i < p.Images.Count; i++)
                    {
                        var img = p.Images[i];
                        <div class="group relative aspect-[4/3] rounded-xl overflow-hidden border border-border bg-neutral-100 shadow-2xs">
                            <img src="@img" alt="Ảnh thực tế @(i+1)" class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />
                        </div>
                    }
                </div>
            </section>

            <!-- Location Map -->
            <section class="space-y-3">
                <h2 class="font-display text-2xl font-bold text-neutral-900">Vị trí bất động sản</h2>
                <div class="rounded-2xl border border-border bg-card overflow-hidden shadow-xs">
                    <div class="relative h-64 w-full bg-neutral-100 flex items-center justify-center overflow-hidden">
                        <img src="/images/categories-bg.png" alt="Bản đồ vị trí" class="size-full object-cover opacity-30 filter grayscale" />
                        <div class="absolute flex flex-col items-center">
                            <div class="grid size-12 place-items-center rounded-full bg-primary text-white shadow-xl animate-bounce">
                                <i data-lucide="map-pin" class="size-6"></i>
                            </div>
                            <span class="mt-2 rounded-full bg-neutral-900 text-white px-3 py-1 text-xs font-bold shadow-md">
                                @p.PublicAddress
                            </span>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Right Aside: Inquiry Form -->
        <aside class="space-y-6 lg:sticky lg:top-24 self-start">
            <div id="inquiryForm" class="rounded-2xl border border-border bg-card p-6 shadow-md space-y-5">
                <div class="flex items-center gap-3 pb-4 border-b border-border/80">
                    <div class="relative size-12 overflow-hidden rounded-full border border-border bg-primary/10 shrink-0">
                        <img src="@p.SellerAvatar" alt="@p.SellerName" class="size-full object-cover" />
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-neutral-900">@p.SellerName</h3>
                        <p class="text-[11px] text-muted-foreground">Người đăng tin (Chính chủ / Môi giới)</p>
                    </div>
                </div>

                <form asp-action="Inquiry" method="post" class="space-y-4 text-xs">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ListingId" value="@p.Id" />

                    <div>
                        <label class="block font-semibold text-neutral-800 mb-1">Họ và tên của bạn *</label>
                        <input name="Name" required placeholder="Nhập họ và tên"
                               class="w-full rounded-xl border border-border bg-surface p-3 outline-none focus:border-primary transition-colors text-neutral-900" />
                    </div>

                    <div>
                        <label class="block font-semibold text-neutral-800 mb-1">Số điện thoại hoặc Email *</label>
                        <input name="Contact" required placeholder="0908xxxxxx hoặc you@example.com"
                               class="w-full rounded-xl border border-border bg-surface p-3 outline-none focus:border-primary transition-colors text-neutral-900" />
                    </div>

                    <div>
                        <label class="block font-semibold text-neutral-800 mb-1">Lời nhắn tư vấn *</label>
                        <textarea name="Message" rows="3" required
                                  class="w-full rounded-xl border border-border bg-surface p-3 outline-none focus:border-primary transition-colors text-neutral-900">Chào bạn, tôi quan tâm đến bất động sản "@p.Title". Bạn có thể tư vấn và đặt lịch xem nhà giúp tôi được không?</textarea>
                    </div>

                    <button type="submit"
                            class="w-full rounded-xl bg-primary py-3 text-xs font-semibold text-white shadow-xs hover:bg-primary-hover transition-colors">
                        Gửi yêu cầu liên hệ xem nhà
                    </button>
                </form>
            </div>

            <!-- Guarantee Box -->
            <div class="rounded-xl border border-border bg-surface p-4 text-xs text-muted-foreground space-y-2">
                <div class="flex items-center gap-2 font-semibold text-neutral-900">
                    <i data-lucide="shield-check" class="size-4 text-primary"></i>
                    <span>Cam kết bảo vệ quyền lợi người mua</span>
                </div>
                <p class="leading-relaxed text-[11px]">
                    PropNest cam kết toàn bộ thông tin đăng tải đã được thẩm định pháp lý và kiểm duyệt trước khi xuất bản.
                </p>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        const heroImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.Images));
        let activeImgIdx = 0;

        function setHeroActiveImage(src, idx) {
            activeImgIdx = idx;
            const mainImg = document.getElementById('mainHeroImg');
            if (mainImg) mainImg.src = src;

            document.querySelectorAll('.hero-thumb').forEach((thumb, i) => {
                if (i === idx) {
                    thumb.className = 'hero-thumb relative size-12 overflow-hidden rounded-full border-2 border-primary ring-2 ring-primary/40 z-10 shadow-sm';
                } else {
                    thumb.className = 'hero-thumb relative size-12 overflow-hidden rounded-full border-2 border-card shadow-sm hover:z-10 hover:scale-110 transition-transform';
                }
            });
        }

        function nextHeroImage() {
            if (!heroImages || heroImages.length === 0) return;
            activeImgIdx = (activeImgIdx + 1) % heroImages.length;
            setHeroActiveImage(heroImages[activeImgIdx], activeImgIdx);
        }

        function copyShareLink() {
            navigator.clipboard.writeText(window.location.href);
            showToast('Đã sao chép liên kết!', 'Đường dẫn bất động sản đã được lưu vào bộ nhớ tạm.');
        }
    </script>
}
